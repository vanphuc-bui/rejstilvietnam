---
const {
  src,
  alt,
  caption,
  credit,
  creditUrl,
  ratio = '16 / 10',
  position = 'center',
} = Astro.props;
---
<figure class="section-media">
  <div class="media-frame" style={`--ratio:${ratio};--position:${position}`}>
    <img src={src} alt={alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
  </div>
  {(caption || credit) && (
    <figcaption>
      {caption && <span>{caption}</span>}
      {credit && (
        <a href={creditUrl} target="_blank" rel="noopener noreferrer">Foto: {credit}</a>
      )}
    </figcaption>
  )}
</figure>

<style>
.section-media { margin: 22px 0 30px; }
.media-frame { aspect-ratio: var(--ratio); overflow: hidden; border-radius: 24px; background: #e9eee9; border: 1px solid var(--border); box-shadow: 0 10px 32px rgba(16,55,41,.08); }
.media-frame img { width: 100%; height: 100%; object-fit: cover; object-position: var(--position); }
figcaption { display: flex; justify-content: space-between; gap: 18px; margin-top: 9px; color: #738078; font-size: .78rem; line-height: 1.4; }
figcaption a { text-decoration: underline; text-underline-offset: 2px; }
@media (max-width: 640px) { figcaption { flex-direction: column; gap: 3px; } .media-frame { border-radius: 18px; } }
</style>
