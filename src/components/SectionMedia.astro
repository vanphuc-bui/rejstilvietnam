---
const {
  src,
  alt,
  caption,
  credit,
  creditUrl,
  ratio = '16 / 10',
  position = 'center',
  loading = 'lazy',
  fetchpriority = 'auto',
  sizes = '(max-width: 760px) calc(100vw - 32px), 760px',
} = Astro.props;

const responsiveWidths = [480, 800, 1200, 1600];

function sizedUrl(input, width) {
  if (!input || !input.startsWith('http')) return null;
  try {
    const url = new URL(input);
    if (url.hostname === 'commons.wikimedia.org' && url.pathname.includes('/wiki/Special:FilePath/')) {
      url.searchParams.set('width', String(width));
      return url.toString();
    }
    if (url.hostname === 'images.unsplash.com') {
      url.searchParams.set('auto', 'format');
      url.searchParams.set('fit', url.searchParams.get('fit') ?? 'crop');
      url.searchParams.set('w', String(width));
      url.searchParams.set('q', url.searchParams.get('q') ?? '82');
      return url.toString();
    }
  } catch {}
  return null;
}

const srcsetItems = responsiveWidths
  .map((width) => {
    const url = sizedUrl(src, width);
    return url ? `${url} ${width}w` : null;
  })
  .filter(Boolean);
const srcset = srcsetItems.length ? srcsetItems.join(', ') : undefined;
---
<figure class="section-media">
  <div class="media-frame" style={`--ratio:${ratio};--position:${position}`}>
    <div class="media-fallback" aria-hidden="true"><span>Vietnam</span></div>
    <img
      src={src}
      srcset={srcset}
      sizes={srcset ? sizes : undefined}
      alt={alt}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      referrerpolicy="no-referrer"
      onerror="window.__rtvImageFallback?.(this)"
    />
  </div>
  {(caption || credit) && (
    <figcaption>
      {caption && <span>{caption}</span>}
      {credit && (
        <a href={creditUrl} target="_blank" rel="noopener noreferrer">Foto: {credit}</a>
      )}
    </figcaption>
  )}
</figure>

<style>
.section-media { margin: 22px 0 30px; }
.media-frame { position: relative; aspect-ratio: var(--ratio); overflow: hidden; border-radius: 24px; background: #e9eee9; border: 1px solid var(--border); box-shadow: 0 10px 32px rgba(16,55,41,.08); }
.media-frame img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; object-position: var(--position); }
.media-fallback { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; text-align: center; background: linear-gradient(145deg,#dfe9e3,#f2eadb); color: var(--green-700); font-size: .82rem; font-weight: 800; }
figcaption { display: flex; justify-content: space-between; gap: 18px; margin-top: 9px; color: #738078; font-size: .78rem; line-height: 1.4; }
figcaption a { text-decoration: underline; text-underline-offset: 2px; }
@media (max-width: 640px) { figcaption { flex-direction: column; gap: 3px; } .media-frame { border-radius: 18px; } }
</style>
