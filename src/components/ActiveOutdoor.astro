---
import { getActiveOutdoor } from '../data/activeOutdoor.js';

const {
  destinationSlug,
  compact = false,
  limit = compact ? 2 : 3,
  id = 'aktiv-ferie',
  heading = null,
  intro = null,
} = Astro.props;

const data = getActiveOutdoor(destinationSlug);
const activities = data?.activities?.slice(0, limit) ?? [];
const difficultyClass = (value = '') => value.toLowerCase()
  .replace('let-mellem', 'medium')
  .replace('mellem-krævende', 'hard')
  .replace('krævende', 'hard')
  .replace('mellem', 'medium')
  .replace('let', 'easy');
---

{data && activities.length > 0 && (
  <section id={id} class:list={['active-outdoor', compact && 'active-outdoor--compact']} data-active-outdoor={destinationSlug}>
    <header class="active-head">
      <p class="active-kicker">Aktiv ferie</p>
      <h2>{heading ?? data.heading}</h2>
      <p>{intro ?? data.intro}</p>
    </header>

    <div class="active-grid">
      {activities.map((activity) => (
        <article class="active-card">
          <div class="active-card__top">
            <span class="activity-type">{activity.type}</span>
            <span class:list={['difficulty', `difficulty--${difficultyClass(activity.difficulty)}`]}>{activity.difficulty}</span>
          </div>
          <h3>{activity.title}</h3>
          <dl class="activity-facts">
            <div><dt>Distance</dt><dd>{activity.distance}</dd></div>
            <div><dt>Tid</dt><dd>{activity.duration}</dd></div>
            <div><dt>Bedst</dt><dd>{activity.bestTime}</dd></div>
            <div><dt>Start</dt><dd>{activity.start}</dd></div>
          </dl>
          <p class="conditions"><strong>Forhold:</strong> {activity.conditions}</p>
          <p class="active-tip">{activity.tip}</p>
          <a class="map-link" href={activity.mapUrl} target="_blank" rel="noopener noreferrer">Se startområdet på kortet ↗</a>
        </article>
      ))}
    </div>

    {compact && (
      <a class="active-more" href={`/aktiv-ferie-i-vietnam/#aktiv-${destinationSlug}`}>
        Se flere aktive oplevelser i {data.destination} →
      </a>
    )}
  </section>
)}

<style>
.active-outdoor{margin:36px 0 46px;padding:30px;border:1px solid rgba(28,106,77,.16);border-radius:28px;background:linear-gradient(145deg,#e9f4ee 0%,#f8f4e9 100%)}
.active-head{max-width:760px;margin-bottom:20px}.active-kicker{margin:0 0 7px!important;color:var(--coral)!important;font-size:.73rem!important;font-weight:900;letter-spacing:.11em;text-transform:uppercase}.active-head h2{margin:0!important;font-size:clamp(1.85rem,4vw,2.65rem)!important}.active-head>p:last-child{margin:12px 0 0!important;color:#46554e!important}.active-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.active-card{display:flex;flex-direction:column;min-width:0;padding:20px;border:1px solid rgba(12,47,37,.12);border-radius:21px;background:rgba(255,255,255,.86);box-shadow:0 10px 28px rgba(16,55,41,.055)}.active-card__top{display:flex;align-items:center;justify-content:space-between;gap:10px}.activity-type{color:var(--green-700);font-size:.72rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}.difficulty{padding:5px 8px;border-radius:999px;font-size:.68rem;font-weight:850;background:#eef1ed;color:#526058}.difficulty--easy{background:#e5f4e9;color:#22643f}.difficulty--medium{background:#fff0ce;color:#805b0f}.difficulty--hard{background:#f9ded8;color:#8c382c}.active-card h3{margin:13px 0 15px!important;font-size:1.25rem!important}.activity-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:0}.activity-facts div{min-width:0;padding:9px 10px;border-radius:12px;background:#f7f4eb}.activity-facts dt{color:#758079;font-size:.66rem;font-weight:850;letter-spacing:.07em;text-transform:uppercase}.activity-facts dd{margin:2px 0 0;color:var(--green-950);font-size:.82rem;font-weight:750;line-height:1.35;overflow-wrap:anywhere}.conditions,.active-tip{font-size:.88rem!important;line-height:1.5!important}.conditions{margin:15px 0 0!important;color:#45524c!important}.active-tip{margin:9px 0 0!important;color:var(--muted)!important}.map-link{display:inline-flex;align-items:center;min-height:42px;margin-top:auto;padding-top:16px;color:var(--green-700)!important;font-size:.84rem;font-weight:850;text-decoration:none!important}.active-more{display:inline-flex;margin-top:18px;color:var(--green-700)!important;font-weight:850;text-decoration:none!important}.active-outdoor--compact .active-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.active-outdoor--compact .active-card:nth-child(n+3){display:none}
@media(max-width:980px){.active-grid{grid-template-columns:1fr}.active-outdoor--compact .active-grid{grid-template-columns:1fr}.active-card{padding:19px}.activity-facts{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:700px){.active-outdoor{margin:30px 0 38px;padding:20px 16px;border-radius:22px}.active-head{padding:0 4px}.active-head h2{font-size:clamp(1.72rem,8vw,2.2rem)!important}.activity-facts{grid-template-columns:repeat(2,minmax(0,1fr))}.active-card{border-radius:18px}.map-link{min-height:44px}}
</style>
