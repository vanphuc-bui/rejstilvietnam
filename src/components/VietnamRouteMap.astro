---
const {
  route = '14',
  compact = false,
  title,
} = Astro.props;

const routes = {
  '10': {
    label: '10 dage',
    title: 'Hanoi → Ninh Binh → Hoi An → Ho Chi Minh City',
    stops: [
      { name:'Hanoi', x:305, y:86, days:'1–3' },
      { name:'Ninh Binh', x:283, y:178, days:'4' },
      { name:'Hoi An', x:248, y:455, days:'5–8' },
      { name:'Ho Chi Minh City', x:252, y:756, days:'9–10' },
    ],
  },
  '14': {
    label: '14 dage',
    title: 'Hanoi → Ninh Binh → Ha Long Bay → Hoi An → Ho Chi Minh City',
    stops: [
      { name:'Hanoi', x:305, y:86, days:'1–3' },
      { name:'Ninh Binh', x:283, y:178, days:'4' },
      { name:'Ha Long Bay', x:386, y:132, days:'5–6' },
      { name:'Hoi An', x:248, y:455, days:'7–10' },
      { name:'Ho Chi Minh City', x:252, y:756, days:'11–14' },
    ],
  },
  '21': {
    label: '21 dage',
    title: 'Hanoi → Ninh Binh → Ha Long Bay → Hoi An → Ho Chi Minh City → Mekong → Phu Quoc',
    stops: [
      { name:'Hanoi', x:305, y:86, days:'1–3' },
      { name:'Ninh Binh', x:283, y:178, days:'4–5' },
      { name:'Ha Long Bay', x:386, y:132, days:'6–7' },
      { name:'Hoi An', x:248, y:455, days:'8–11' },
      { name:'Ho Chi Minh City', x:252, y:756, days:'12–14' },
      { name:'Mekong', x:205, y:822, days:'15–16' },
      { name:'Phu Quoc', x:105, y:886, days:'17–21' },
    ],
  },
};

const selected = routes[String(route)] ?? routes['14'];
const points = selected.stops.map((stop) => `${stop.x},${stop.y}`).join(' ');
const displayTitle = title ?? selected.title;
---
<figure class:list={['route-map', compact && 'route-map--compact']} aria-label={`Skematisk rutekort for Vietnam på ${selected.label}`}>
  <div class="route-map__head">
    <div>
      <span>{selected.label}</span>
      <strong>{displayTitle}</strong>
    </div>
    <small>Skematisk kort · ikke målfast</small>
  </div>
  <div class="route-map__canvas">
    <svg viewBox="0 0 500 950" role="img" aria-label={`Rute gennem Vietnam: ${selected.title}`}>
      <defs>
        <linearGradient id={`country-${route}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#dce9df" />
          <stop offset="1" stop-color="#f1dfbd" />
        </linearGradient>
      </defs>
      <path
        d="M310 35 C350 85 330 145 300 205 C285 245 305 300 280 350 C255 405 260 470 235 525 C210 575 220 635 245 685 C275 740 275 805 225 850 C180 890 145 918 110 925 C130 875 165 840 185 800 C215 748 198 690 210 630 C220 570 230 520 222 470 C215 410 235 360 245 305 C255 250 245 205 265 160 C282 120 285 75 310 35 Z"
        fill={`url(#country-${route})`}
        stroke="rgba(12,47,37,.14)"
        stroke-width="2"
      />
      <polyline points={points} fill="none" stroke="#0c2f25" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" opacity=".9" />
      {selected.stops.map((stop, index) => (
        <g>
          <circle cx={stop.x} cy={stop.y} r="18" fill="#fffdf8" stroke="#0c2f25" stroke-width="6" />
          <circle cx={stop.x} cy={stop.y} r="5" fill="#d95b49" />
          <g transform={`translate(${stop.x < 190 ? stop.x + 28 : stop.x > 350 ? stop.x - 168 : stop.x + 28}, ${stop.y - 18})`}>
            <rect width="140" height="50" rx="13" fill="rgba(255,253,248,.96)" stroke="rgba(12,47,37,.12)" />
            <text x="12" y="20" font-size="14" font-weight="800" fill="#0c2f25">{index + 1}. {stop.name}</text>
            <text x="12" y="38" font-size="11" font-weight="700" fill="#6c7771">Dag {stop.days}</text>
          </g>
        </g>
      ))}
      <text x="305" y="925" text-anchor="middle" font-size="12" font-weight="800" fill="#6c7771">NORD → SYD</text>
    </svg>
  </div>
  <figcaption>Ruten viser rækkefølgen og de store transporthop. Brug de konkrete rejseplaner til antal nætter, fly og dagsture.</figcaption>
</figure>

<style>
.route-map{margin:28px 0;padding:22px;border:1px solid var(--border);border-radius:26px;background:#fffdf8;box-shadow:0 12px 34px rgba(16,55,41,.06)}
.route-map__head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:14px}
.route-map__head>div{display:grid;gap:4px}
.route-map__head span{color:var(--coral);font-size:.74rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
.route-map__head strong{max-width:720px;color:var(--green-950);font-size:clamp(1.1rem,2.5vw,1.45rem);line-height:1.25}
.route-map__head small{color:var(--muted);font-size:.76rem;font-weight:700;white-space:nowrap}
.route-map__canvas{overflow:hidden;border-radius:20px;background:linear-gradient(180deg,#eef5f0,#f7efe0)}
.route-map__canvas svg{display:block;width:100%;height:auto;max-height:680px}
.route-map figcaption{margin-top:12px;color:var(--muted);font-size:.82rem;line-height:1.5}
.route-map--compact{max-width:900px;margin:22px auto}
.route-map--compact .route-map__canvas svg{max-height:520px}
@media(max-width:640px){
  .route-map{padding:14px;border-radius:20px}
  .route-map__head{align-items:flex-start;flex-direction:column;gap:5px}
  .route-map__head small{white-space:normal}
  .route-map__canvas{border-radius:15px}
}
</style>
