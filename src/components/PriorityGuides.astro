---
import { priorityGuideGroups } from '../data/priorityGuides.js';
---
<section class="section priority-guides" aria-labelledby="priority-guides-heading">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Kom godt fra start</p>
        <h2 id="priority-guides-heading">De vigtigste guider til din Vietnam-rejse</h2>
      </div>
      <p>Du behøver ikke læse alt. Start med den guide, der svarer på dit næste spørgsmål, og byg rejsen derfra.</p>
    </div>
    <div class="priority-guides-grid">
      {priorityGuideGroups.map((group) => (
        <nav class="priority-guides-group" aria-label={group.title}>
          <h3>{group.title}</h3>
          <p>{group.description}</p>
          <ul>
            {group.links.map((link) => (
              <li><a href={link.href}>{link.label}<span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <p class="priority-guides-more">Vil du se hele oversigten? <a href="/alle-guider/">Find alle vores Vietnam-guider →</a></p>
  </div>
</section>
<style>
.priority-guides{background:linear-gradient(180deg,#f6f9f7,#fff)}
.priority-guides-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.priority-guides-group{padding:23px 19px;border:1px solid var(--border);border-radius:20px;background:#fff;min-width:0}
.priority-guides-group h3{font-size:1.16rem;line-height:1.35;margin:0 0 8px;color:var(--green-950)}
.priority-guides-group>p{font-size:.91rem;line-height:1.55;color:var(--muted);margin:0 0 15px}
.priority-guides-group ul{padding:0;margin:0;list-style:none}
.priority-guides-group li+li{border-top:1px solid var(--border)}
.priority-guides-group a{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 0;text-decoration:none;font-size:.92rem;line-height:1.4;font-weight:650;color:var(--green-950)}
.priority-guides-group a span{flex-shrink:0;opacity:.65}
.priority-guides-group a:hover,.priority-guides-group a:focus-visible{text-decoration:underline;text-underline-offset:3px}
.priority-guides-more{margin:20px 0 0;color:var(--muted)}
.priority-guides-more a{color:var(--green-950);font-weight:700}
@media(max-width:1100px){.priority-guides-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:620px){.priority-guides-grid{grid-template-columns:1fr;gap:12px}.priority-guides-group{padding:19px 17px}}
</style>
