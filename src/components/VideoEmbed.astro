---
const { youtubeId, title, caption } = Astro.props;
---
<figure class="video-block">
  <div class="video-frame">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0`}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
.video-block { margin: 26px 0 32px; }
.video-frame { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 24px; background: #0d2019; box-shadow: 0 12px 34px rgba(16,55,41,.11); }
.video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
figcaption { margin-top: 9px; color: #738078; font-size: .8rem; line-height: 1.45; }
@media (max-width: 640px) { .video-frame { border-radius: 18px; } }
</style>
