---
const {
  items = [],
  title = 'Se området i billeder',
  intro = 'Klik på et billede for at se det større.',
  eyebrow,
} = Astro.props;

const path = Astro.url.pathname;
const parts = path.split('/').filter(Boolean);
const destinationIndex = parts.indexOf('destinationer');
const destinationSlug = destinationIndex >= 0 ? parts[destinationIndex + 1] : '';
const guideSlug = destinationIndex >= 0 ? (parts[destinationIndex + 2] ?? '') : '';
let contextualEyebrow = eyebrow;
if (!contextualEyebrow) {
  if (guideSlug === 'bedste-strande') contextualEyebrow = 'Strandene';
  else if (guideSlug === 'hvor-skal-man-bo') contextualEyebrow = 'Områderne';
  else if (guideSlug === 'sevaerdigheder') contextualEyebrow = 'Se med egne øjne';
  else if (guideSlug === '3-dage-i-nha-trang' || guideSlug === '4-dage-i-phu-quoc') contextualEyebrow = 'Undervejs';
  else if (/o-hop|o-ture|snorkling/.test(guideSlug)) contextualEyebrow = 'På vandet';
  else if (/vandsport|dykning/.test(guideSlug)) contextualEyebrow = 'I bevægelse';
  else if (!guideSlug && destinationSlug === 'phu-quoc') contextualEyebrow = 'Øen i billeder';
  else if (!guideSlug && destinationSlug === 'nha-trang') contextualEyebrow = 'Bugten i billeder';
  else contextualEyebrow = 'Visuelt overblik';
}

const galleryId = `gallery-${Math.random().toString(36).slice(2, 9)}`;
const galleryItems = items.map((item) => ({
  src: item.src,
  alt: item.alt ?? '',
  caption: item.caption ?? '',
  credit: item.credit ?? '',
  creditUrl: item.creditUrl ?? '',
}));
---
{items.length > 0 && (
  <section class="media-gallery" aria-labelledby={`${galleryId}-title`}>
    <div class="gallery-head">
      {contextualEyebrow && <p class="eyebrow">{contextualEyebrow}</p>}
      <h2 id={`${galleryId}-title`}>{title}</h2>
      {intro && <p>{intro}</p>}
    </div>

    <div class="gallery-grid" id={`${galleryId}-grid`}>
      {items.map((item, index) => (
        <button class={`gallery-tile ${index === 0 ? 'gallery-tile--lead' : ''}`} type="button" data-gallery-index={index} aria-label={`Åbn billede ${index + 1}: ${item.alt ?? ''}`}>
          <span class="gallery-fallback">Vietnam</span>
          <img src={item.src} alt={item.alt ?? ''} loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="window.__rtvImageFallback?.(this)" />
          <span class="gallery-overlay">
            <b>{item.label ?? item.alt ?? `Billede ${index + 1}`}</b>
            <small>Se større ↗</small>
          </span>
        </button>
      ))}
    </div>

    <dialog id={`${galleryId}-dialog`} class="gallery-dialog" aria-label={title}>
      <button class="gallery-close" type="button" aria-label="Luk galleri">×</button>
      <button class="gallery-nav gallery-nav--prev" type="button" aria-label="Forrige billede">‹</button>
      <figure>
        <div class="gallery-dialog-frame"><img src="" alt="" /></div>
        <figcaption>
          <span class="gallery-dialog-caption"></span>
          <a class="gallery-dialog-credit" href="#" target="_blank" rel="noopener noreferrer"></a>
        </figcaption>
      </figure>
      <button class="gallery-nav gallery-nav--next" type="button" aria-label="Næste billede">›</button>
    </dialog>
  </section>
)}

<script is:inline define:vars={{ galleryId, galleryItems }}>
  (() => {
    const grid = document.getElementById(`${galleryId}-grid`);
    const dialog = document.getElementById(`${galleryId}-dialog`);
    if (!grid || !dialog || !galleryItems.length) return;

    const img = dialog.querySelector('.gallery-dialog-frame img');
    const caption = dialog.querySelector('.gallery-dialog-caption');
    const credit = dialog.querySelector('.gallery-dialog-credit');
    const close = dialog.querySelector('.gallery-close');
    const prev = dialog.querySelector('.gallery-nav--prev');
    const next = dialog.querySelector('.gallery-nav--next');
    let current = 0;

    const render = (index) => {
      current = (index + galleryItems.length) % galleryItems.length;
      const item = galleryItems[current];
      img.src = item.src;
      img.alt = item.alt || '';
      caption.textContent = item.caption || item.alt || '';
      if (item.credit && item.creditUrl) {
        credit.textContent = `Foto: ${item.credit}`;
        credit.href = item.creditUrl;
        credit.hidden = false;
      } else {
        credit.hidden = true;
      }
    };

    grid.addEventListener('click', (event) => {
      const button = event.target.closest('[data-gallery-index]');
      if (!button) return;
      render(Number(button.dataset.galleryIndex));
      dialog.showModal();
    });
    close?.addEventListener('click', () => dialog.close());
    prev?.addEventListener('click', () => render(current - 1));
    next?.addEventListener('click', () => render(current + 1));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') render(current - 1);
      if (event.key === 'ArrowRight') render(current + 1);
    });
  })();
</script>

<style>
.media-gallery{margin:42px 0}.gallery-head{margin-bottom:18px}.gallery-head h2{font-size:clamp(1.8rem,4vw,2.55rem);margin:0}.gallery-head>p:not(.eyebrow){margin-top:8px;max-width:720px;color:var(--muted)}.gallery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:170px;gap:10px}.gallery-tile{position:relative;overflow:hidden;border:0;border-radius:18px;padding:0;background:#e9eee9;cursor:zoom-in;text-align:left}.gallery-tile--lead{grid-column:span 2;grid-row:span 2}.gallery-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .25s ease}.gallery-tile:hover img{transform:scale(1.035)}.gallery-fallback{position:absolute;inset:0;display:grid;place-items:center;padding:18px;color:var(--green-700);font-size:.76rem;font-weight:800;background:linear-gradient(145deg,#dfe9e3,#f2eadb)}.gallery-overlay{position:absolute;z-index:2;left:0;right:0;bottom:0;padding:34px 14px 12px;color:white;background:linear-gradient(transparent,rgba(5,28,21,.82));display:flex;align-items:end;justify-content:space-between;gap:10px}.gallery-overlay b{font-size:.86rem;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.gallery-overlay small{white-space:nowrap;opacity:.86;font-size:.69rem}.gallery-dialog{width:min(1120px,94vw);max-width:none;padding:0;border:0;border-radius:24px;background:#071b15;color:white;overflow:hidden;box-shadow:0 28px 80px rgba(0,0,0,.45)}.gallery-dialog::backdrop{background:rgba(2,10,8,.78);backdrop-filter:blur(4px)}.gallery-dialog figure{margin:0;padding:18px}.gallery-dialog-frame{height:min(72vh,760px);display:grid;place-items:center;border-radius:16px;overflow:hidden;background:#020807}.gallery-dialog-frame img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}.gallery-dialog figcaption{display:flex;justify-content:space-between;gap:18px;padding:12px 2px 0;color:rgba(255,255,255,.78);font-size:.8rem}.gallery-dialog figcaption a{color:#f2c986;text-decoration:underline;text-underline-offset:2px}.gallery-close,.gallery-nav{position:absolute;z-index:5;border:0;background:rgba(255,255,255,.92);color:#0c2f25;cursor:pointer;box-shadow:0 8px 22px rgba(0,0,0,.2)}.gallery-close{top:14px;right:14px;width:42px;height:42px;border-radius:50%;font-size:1.7rem;line-height:1}.gallery-nav{top:50%;transform:translateY(-50%);width:44px;height:58px;border-radius:14px;font-size:2rem}.gallery-nav--prev{left:14px}.gallery-nav--next{right:14px}
@media(max-width:800px){.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:145px}.gallery-tile--lead{grid-column:span 2;grid-row:span 2}.gallery-dialog{width:96vw}.gallery-dialog-frame{height:70vh}.gallery-nav{width:38px;height:50px}.gallery-dialog figcaption{flex-direction:column;gap:5px}}
@media(max-width:480px){.gallery-grid{grid-auto-rows:128px}.gallery-tile--lead{grid-row:span 2}.gallery-overlay{padding:28px 10px 9px}.gallery-overlay small{display:none}.gallery-dialog figure{padding:10px}.gallery-close{top:8px;right:8px}.gallery-nav--prev{left:8px}.gallery-nav--next{right:8px}}
</style>
