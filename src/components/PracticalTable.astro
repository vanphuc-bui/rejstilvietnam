---
const {
  title,
  intro = '',
  columns = [],
  rows = [],
  note = '',
} = Astro.props;
---
<section class="practical-table-block">
  {title && <h3>{title}</h3>}
  {intro && <p class="practical-intro">{intro}</p>}
  <div class="practical-scroll">
    <table>
      <thead>
        <tr>
          {columns.map((column) => <th scope="col">{column.label}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            {columns.map((column, index) => (
              <td data-label={column.label}>
                {index === 0 ? <strong>{row[column.key]}</strong> : row[column.key]}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {note && <p class="practical-note">{note}</p>}
</section>

<style>
.practical-table-block{margin:24px 0 30px}.practical-table-block h3{margin-bottom:8px}.practical-intro{margin:0 0 14px!important;color:var(--muted)}.practical-scroll{overflow-x:auto;border:1px solid var(--border);border-radius:20px;background:#fffdf8}.practical-scroll table{width:100%;border-collapse:collapse;min-width:640px}.practical-scroll th,.practical-scroll td{padding:14px 16px;text-align:left;vertical-align:top;border-bottom:1px solid var(--border)}.practical-scroll th{background:var(--green-100);color:var(--green-950);font-size:.76rem;letter-spacing:.06em;text-transform:uppercase}.practical-scroll tr:last-child td{border-bottom:0}.practical-scroll td{color:#435048;line-height:1.45}.practical-scroll td strong{color:var(--green-950)}.practical-note{margin:10px 2px 0!important;color:var(--muted);font-size:.82rem;line-height:1.5}@media(max-width:700px){.practical-scroll{border:0;background:transparent;overflow:visible}.practical-scroll table,.practical-scroll tbody,.practical-scroll tr,.practical-scroll td{display:block;min-width:0;width:100%}.practical-scroll thead{display:none}.practical-scroll tr{margin-bottom:12px;border:1px solid var(--border);border-radius:18px;background:#fffdf8;overflow:hidden}.practical-scroll td{display:grid;grid-template-columns:112px 1fr;gap:12px;padding:11px 14px;border-bottom:1px solid var(--border)}.practical-scroll td:last-child{border-bottom:0}.practical-scroll td::before{content:attr(data-label);color:var(--muted);font-size:.7rem;font-weight:850;letter-spacing:.05em;text-transform:uppercase}.practical-scroll td:first-child{display:block;padding-top:15px;font-size:1.03rem}.practical-scroll td:first-child::before{display:none}}
</style>
