---
const {
  destination = 'Vietnam',
  title = 'Rejseguide',
  eyebrow = 'Guide',
} = Astro.props;

const photos = {
  'Hanoi': 'https://images.unsplash.com/photo-1555921015-5532091f6026?auto=format&fit=crop&w=1800&q=84',
  'Hoi An': 'https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?auto=format&fit=crop&w=1800&q=84',
  'Da Nang': 'https://commons.wikimedia.org/wiki/Special:FilePath/My%20Khe%20Beach%2C%20Da%20Nang%2C%20Vietnam.jpg?width=1800',
  'Ho Chi Minh City': 'https://commons.wikimedia.org/wiki/Special:FilePath/Ben%20Thanh%20Market.jpg?width=1800',
  'Phu Quoc': 'https://commons.wikimedia.org/wiki/Special:FilePath/Phu%20quoc%20beach.JPG?width=1800',
  'Nha Trang': 'https://commons.wikimedia.org/wiki/Special:FilePath/View%20of%20Nha%20Trang%20city.jpg?width=1800',
};
const photo = photos[destination] ?? 'https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=1800&q=84';
---
<figure class="guide-cover" aria-label={`${destination}: ${title}`}>
  <img
    src={photo}
    alt={`${destination} – ${title}`}
    loading="eager"
    decoding="async"
    fetchpriority="high"
    referrerpolicy="no-referrer"
    onerror="window.__rtvImageFallback?.(this)"
  />
  <div class="cover-shade" aria-hidden="true"></div>
  <div class="cover-copy">
    <span>{eyebrow}</span>
    <strong>{title}</strong>
  </div>
</figure>

<style>
.guide-cover{position:relative;aspect-ratio:16/7;margin:0;overflow:hidden;border-radius:28px;background:#173d31;box-shadow:0 16px 42px rgba(16,55,41,.13);border:1px solid rgba(18,58,46,.08)}
.guide-cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.cover-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,26,20,.06) 10%,rgba(4,26,20,.78) 100%)}
.cover-copy{position:absolute;left:clamp(24px,5vw,62px);right:clamp(24px,5vw,62px);bottom:clamp(24px,5vw,50px);z-index:2;max-width:72%;color:white;text-shadow:0 2px 14px rgba(0,0,0,.3)}
.cover-copy span{display:block;font-size:.72rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase;opacity:.88}
.cover-copy strong{display:block;margin-top:7px;font:700 clamp(1.7rem,4vw,3.2rem)/1.05 Georgia,serif;color:white}
@media(max-width:640px){.guide-cover{aspect-ratio:16/10;border-radius:20px}.cover-copy{max-width:86%;left:20px;right:20px;bottom:18px}.cover-copy strong{font-size:clamp(1.45rem,7vw,2rem)}}
</style>
