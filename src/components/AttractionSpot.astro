---
import SectionMedia from './SectionMedia.astro';

const {
  id,
  index,
  title,
  kicker,
  paragraphs = [],
  facts = [],
  image,
  reverse = false,
  href,
  hrefLabel = 'Læs den praktiske guide →',
} = Astro.props;
---
<section id={id} class:list={{ 'attraction-spot': true, 'attraction-spot--reverse': reverse }}>
  <div class="attraction-visual">
    <SectionMedia
      {...image}
      ratio={image?.ratio ?? '16 / 9'}
      sizes="(max-width: 900px) calc(100vw - 32px), 820px"
    />
  </div>

  <div class="attraction-body">
    <div class="attraction-copy">
      <div class="attraction-number">{String(index).padStart(2, '0')}</div>
      {kicker && <p class="attraction-kicker">{kicker}</p>}
      <h3>{title}</h3>
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      {href && <a class="attraction-link" href={href}>{hrefLabel}</a>}
    </div>

    {facts.length > 0 && (
      <dl class="attraction-facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>

<style>
.attraction-spot{
  margin:38px 0 58px;
  overflow:hidden;
  border:1px solid var(--border);
  border-radius:30px;
  background:#fffdf9;
  box-shadow:0 16px 42px rgba(16,55,41,.07);
  content-visibility:auto;
  contain-intrinsic-size:900px;
}
.attraction-visual{
  position:relative;
  background:#e9eee9;
}
.attraction-visual :global(.section-media){
  margin:0;
}
.attraction-visual :global(.media-frame){
  border:0;
  border-radius:0;
  box-shadow:none;
  aspect-ratio:16 / 9;
}
.attraction-visual :global(figcaption){
  display:flex;
  justify-content:space-between;
  gap:16px;
  margin:0;
  padding:10px 18px 11px;
  border-top:1px solid rgba(18,58,46,.08);
  background:#f7f3ea;
  color:#68766f;
  font-size:.74rem;
  line-height:1.35;
}
.attraction-visual :global(figcaption span){
  max-width:72%;
}
.attraction-visual :global(figcaption a){
  flex:0 0 auto;
  color:var(--green-700);
}
.attraction-body{
  display:grid;
  grid-template-columns:minmax(0,1.35fr) minmax(230px,.65fr);
  gap:clamp(26px,4vw,48px);
  align-items:start;
  padding:clamp(24px,4vw,40px);
}
.attraction-number{
  font:700 .94rem/1 Georgia,serif;
  color:var(--coral);
  letter-spacing:.08em;
  margin-bottom:15px;
}
.attraction-kicker{
  margin:0 0 8px!important;
  color:var(--green-700)!important;
  font-size:.72rem!important;
  font-weight:900!important;
  letter-spacing:.11em;
  text-transform:uppercase;
}
.attraction-copy h3{
  margin:0 0 14px;
  font-size:clamp(2rem,4.5vw,3.25rem);
  line-height:1.02;
}
.attraction-copy>p:not(.attraction-kicker){
  margin:0 0 12px!important;
  color:#425149!important;
  font-size:1rem!important;
  line-height:1.68!important;
}
.attraction-facts{
  display:grid;
  grid-template-columns:1fr;
  gap:10px;
  margin:0;
}
.attraction-facts div{
  padding:14px 15px;
  border-radius:15px;
  background:#f2eee3;
  border:1px solid rgba(18,58,46,.05);
}
.attraction-facts dt{
  color:var(--green-700);
  font-size:.65rem;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.attraction-facts dd{
  margin:4px 0 0;
  color:#33463e;
  font-size:.86rem;
  font-weight:800;
  line-height:1.35;
}
.attraction-link{
  display:inline-flex;
  margin-top:10px;
  color:var(--green-700);
  font-weight:850;
}
@media(max-width:820px){
  .attraction-body{grid-template-columns:1fr}
  .attraction-facts{grid-template-columns:repeat(2,minmax(0,1fr))}
  .attraction-visual :global(figcaption){flex-direction:column;gap:4px}
  .attraction-visual :global(figcaption span){max-width:none}
}
@media(max-width:560px){
  .attraction-spot{border-radius:20px;margin:26px 0 38px}
  .attraction-visual :global(.media-frame){aspect-ratio:16 / 10}
  .attraction-visual :global(figcaption){padding:8px 12px 9px;font-size:.69rem}
  .attraction-body{padding:19px}
  .attraction-facts{grid-template-columns:1fr;gap:8px}
  .attraction-facts div{padding:12px 13px}
  .attraction-copy h3{font-size:1.9rem}
  .attraction-copy>p:not(.attraction-kicker){font-size:.96rem!important;line-height:1.6!important}
}
</style>
