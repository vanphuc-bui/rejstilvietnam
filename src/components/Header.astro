---
const nav = [
  ['Rejsemål', '/destinationer/'],
  ['Rejseplaner', '/rejseplaner/'],
  ['Planlæg rejsen', '/rejseguide/'],
  ['Oplevelser', '/ture/'],
  ['Om os', '/om/'],
];
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="RejsTilVietnam.dk forside">
      <span class="brand-mark">V</span>
      <span>RejsTilVietnam<span class="dot">.dk</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Primær navigation">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="nav-cta" href="/book-rejsen/">Book rejsen</a>
    <details class="mobile-menu">
      <summary aria-label="Åbn menu">Menu</summary>
      <div class="mobile-panel">
        {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        <a class="mobile-book" href="/book-rejsen/">Book rejsen</a>
      </div>
    </details>
  </div>
</header>
<style>
.site-header { position: sticky; top: 0; z-index: 50; backdrop-filter: blur(16px); background: rgba(251,248,240,.88); border-bottom: 1px solid rgba(12,47,37,.08); }
.nav-wrap { height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 22px; }
.brand { display: inline-flex; align-items: center; gap: 10px; color: var(--green-950); font-weight: 900; letter-spacing: -.025em; white-space: nowrap; }
.brand-mark { width: 34px; height: 34px; display: grid; place-items: center; background: var(--green-950); color: #f5d98f; border-radius: 11px; font-family: Georgia, serif; }
.dot { color: var(--coral); }
.desktop-nav { display: flex; align-items: center; gap: 22px; color: #44534c; font-size: .91rem; font-weight: 650; }
.desktop-nav a { white-space: nowrap; }
.desktop-nav a:hover { color: var(--green-700); }
.nav-cta { padding: 10px 16px; border-radius: 999px; background: var(--green-950); color: white; font-size: .88rem; font-weight: 800; white-space: nowrap; }
.mobile-menu { display: none; position: relative; }
.mobile-menu summary { list-style: none; cursor: pointer; padding: 9px 13px; border: 1px solid var(--border); border-radius: 999px; font-size: .88rem; font-weight: 800; }
.mobile-menu summary::-webkit-details-marker { display: none; }
.mobile-panel { position: absolute; right: 0; top: 48px; min-width: 220px; padding: 10px; border: 1px solid var(--border); border-radius: 18px; background: #fffdf8; box-shadow: var(--shadow); display: grid; }
.mobile-panel a { padding: 11px 12px; border-radius: 11px; font-weight: 700; }
.mobile-panel a:hover { background: var(--green-100); }
.mobile-panel .mobile-book { margin-top: 5px; background: var(--green-950); color: white; }
@media (max-width: 980px) { .desktop-nav, .nav-cta { display: none; } .mobile-menu { display: block; } }
@media (max-width: 540px) { .brand { font-size: .94rem; } }
</style>
