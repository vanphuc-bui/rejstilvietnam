---
const nav = [
  ['Destinationer', '/destinationer/'],
  ['Rejseguide', '/rejseguide/'],
  ['Ture', '/ture/'],
  ['Rejseplaner', '/rejseplaner/'],
];
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="RejsTilVietnam.dk forside">
      <span class="brand-mark">V</span>
      <span>RejsTilVietnam<span class="dot">.dk</span></span>
    </a>
    <nav aria-label="Primær navigation">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="nav-cta" href="/rejseguide/">Planlæg rejsen</a>
  </div>
</header>
<style>
.site-header { position: sticky; top: 0; z-index: 50; backdrop-filter: blur(16px); background: rgba(251,248,240,.88); border-bottom: 1px solid rgba(12,47,37,.08); }
.nav-wrap { height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
.brand { display: inline-flex; align-items: center; gap: 10px; color: var(--green-950); font-weight: 900; letter-spacing: -.025em; }
.brand-mark { width: 34px; height: 34px; display: grid; place-items: center; background: var(--green-950); color: #f5d98f; border-radius: 11px; font-family: Georgia, serif; }
.dot { color: var(--coral); }
nav { display: flex; gap: 28px; color: #44534c; font-size: .94rem; font-weight: 650; }
nav a:hover { color: var(--green-700); }
.nav-cta { padding: 10px 16px; border-radius: 999px; background: var(--green-950); color: white; font-size: .88rem; font-weight: 800; }
@media (max-width: 820px) { nav { display: none; } }
@media (max-width: 480px) { .nav-cta { display: none; } }
</style>
