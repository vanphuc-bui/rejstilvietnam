---
const { name, kicker, description, href, image } = Astro.props;
const hasImage = Boolean(image);
---
<a class:list={{ destination:true, 'destination--plain':!hasImage }} href={href}>
  <div class="visual" aria-hidden="true">
    <div class="fallback-art">
      <span class="sun"></span>
      <span class="mountain mountain--one"></span>
      <span class="mountain mountain--two"></span>
      <span class="water"></span>
    </div>
    {hasImage && (
      <img
        src={image}
        alt=""
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        onerror="window.__rtvImageFallback?.(this)"
      />
    )}
  </div>
  <div class="overlay"></div>
  <div class="content"><span>{kicker}</span><h3>{name}</h3><p>{description}</p><b>Udforsk →</b></div>
</a>
<style>
.destination{position:relative;min-height:360px;overflow:hidden;border-radius:28px;background:#173d31;box-shadow:var(--shadow);isolation:isolate}
.visual,.overlay{position:absolute;inset:0}
.visual{overflow:hidden;background:linear-gradient(145deg,#174235,#3c765f 58%,#d5b06f)}
.visual img{position:absolute;z-index:2;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .55s ease}
.destination:hover .visual img{transform:scale(1.045)}
.fallback-art{position:absolute;inset:0;overflow:hidden}
.sun{position:absolute;width:94px;height:94px;border-radius:50%;right:12%;top:13%;background:rgba(250,226,169,.3);filter:blur(1px)}
.mountain{position:absolute;bottom:22%;width:75%;height:47%;background:rgba(5,37,28,.34);clip-path:polygon(0 100%,24% 40%,38% 65%,58% 20%,78% 57%,100% 100%)}
.mountain--one{left:-7%}.mountain--two{right:-22%;bottom:18%;transform:scale(.85);opacity:.6}
.water{position:absolute;left:0;right:0;bottom:0;height:31%;background:linear-gradient(180deg,rgba(64,127,111,.42),rgba(10,47,37,.78))}
.overlay{z-index:3;background:linear-gradient(180deg,rgba(5,28,21,.02) 20%,rgba(6,31,23,.9) 100%)}
.content{position:absolute;z-index:4;left:24px;right:24px;bottom:24px;color:white}
.content span{font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.12em;opacity:.88}
.content h3{color:white;font-size:2rem;margin:5px 0 7px}
.content p{opacity:.88;font-size:.94rem}
.content b{display:inline-block;margin-top:14px;font-size:.9rem}
@media(max-width:640px){.destination{min-height:300px;border-radius:20px}.content{left:18px;right:18px;bottom:18px}.content h3{font-size:1.65rem}.content p{font-size:.9rem;line-height:1.48}.content b{margin-top:11px}.visual img{transition:none}}
</style>
