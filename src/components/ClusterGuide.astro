---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import PlaceMap from './PlaceMap.astro';
import VideoEmbed from './VideoEmbed.astro';
import ActivityCardGrid from './ActivityCardGrid.astro';
import GuideCover from './GuideCover.astro';
import SectionMedia from './SectionMedia.astro';
import VisualHighlights from './VisualHighlights.astro';
import AffiliateActivityGrid from './AffiliateActivityGrid.astro';
import { getGuideVisuals } from '../data/guideVisuals.js';
import { getDestinationVisual, getDestinationVideo, getDestinationSectionVisual } from '../data/destinationVisuals.js';

const { page } = Astro.props;
const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const destinationIndex = pathParts.indexOf('destinationer');
const destinationSlug = destinationIndex >= 0 ? pathParts[destinationIndex + 1] : '';
const guideSlug = destinationIndex >= 0 ? pathParts[destinationIndex + 2] : '';
const visualPack = getGuideVisuals(destinationSlug, guideSlug);
const autoHeroMedia = getDestinationSectionVisual(page, { heading: page.heading ?? page.title }, 0, guideSlug, '') ?? getDestinationVisual(page);
const heroMedia = visualPack?.hero ?? autoHeroMedia ?? page.hero ?? getDestinationVisual(page);
const heroSrc = heroMedia?.src ?? '';
const sectionImageSrcs = new Set(
  (page.sections ?? [])
    .flatMap((section) => [
      section.image?.src,
      ...(section.subsections ?? []).map((sub) => sub.image?.src),
    ])
    .filter(Boolean)
);
const galleryItems = (page.gallery ?? [])
  .filter((item, index, items) => item?.src && item.src !== heroSrc && !sectionImageSrcs.has(item.src) && items.findIndex((candidate) => candidate?.src === item.src) === index);
const toc = (page.sections ?? []).map((section, i) => ({ id: section.id ?? `section-${i+1}`, label: section.toc ?? section.heading }));
const cleanDescription = (page.description ?? '').replace(/\s*[-–—]\s*Ingen affiliate-links endnu\.?/i, '').trim();
const publicParagraphs = (items = []) => items.filter((item) => !/affiliate/i.test(item));

const nhaTrangWaterSports = {
  src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Tr%C3%B2%20ch%C6%A1i%20bi%E1%BB%83n%20%E1%BB%9F%20%C4%91%E1%BA%A3o%20H%C3%B2n%20T%E1%BA%B1m.jpg?width=1400',
  alt: 'Vandsport på Hòn Tằm i Nha Trang-bugten',
  caption: 'Vandsport på Hòn Tằm i Nha Trang-bugten.',
  credit: 'Phạm Thúy An / Wikimedia Commons',
  creditUrl: 'https://commons.wikimedia.org/wiki/File:Tr%C3%B2_ch%C6%A1i_bi%E1%BB%83n_%E1%BB%9F_%C4%91%E1%BA%A3o_H%C3%B2n_T%E1%BA%B1m.jpg',
};

const effectiveActivityCards = (page.activityCards ?? []).map((item) => {
  if (page.destinationName !== 'Nha Trang') return item;
  if (!/jetski|parasailing/i.test(`${item.title ?? ''} ${item.text ?? ''}`)) return item;
  return {
    ...item,
    kicker: 'Nha Trang Bay',
    title: 'Jetski og parasailing',
    image: nhaTrangWaterSports,
  };
});
const titleText = `${page.title ?? ''} ${page.heading ?? ''}`.toLowerCase();
const earlyMap = (page.mapPlaces?.length ?? 0) > 0 && /hotel|hvor skal man bo|område|strand|snork|dykning|øhop|vandsport/.test(titleText);
const autoVideo = getDestinationVideo(page);
const showAutoVideo = !page.video && !page.videos?.length && !!autoVideo && /3 dage|4 dage|seværdigheder|oplevelser|strande|mad/.test(titleText);
---
<ArticleLayout
  title={page.title}
  description={cleanDescription}
  eyebrow={page.eyebrow}
  heading={page.heading}
  intro={page.intro}
  updated={page.updated}
  dateModified={page.dateModified}
  toc={toc}
  sources={page.sources ?? []}
>
  {heroMedia ? (
    <SectionMedia
      slot="heroMedia"
      {...heroMedia}
      ratio="16 / 7"
      loading="eager"
      fetchpriority="high"
      sizes="(max-width: 900px) calc(100vw - 32px), 1160px"
    />
  ) : (
    <GuideCover
      slot="heroMedia"
      destination={page.destinationName}
      title={page.heading ?? page.title}
      eyebrow={page.eyebrow}
    />
  )}

  {page.quickFacts?.length > 0 && (
    <div class="fact-grid">
      {page.quickFacts.map((fact) => <div class="fact"><span>{fact.label}</span><b>{fact.value}</b></div>)}
    </div>
  )}

  {page.affiliateActivity && (
    <AffiliateActivityGrid
      title={page.affiliateActivity.title}
      intro={page.affiliateActivity.intro ?? ''}
      items={[page.affiliateActivity.item]}
    />
  )}

  {visualPack?.highlights?.length > 0 && (
    <VisualHighlights
      items={visualPack.highlights}
      title={visualPack.highlightsTitle ?? 'Se guiden i billeder'}
      intro={visualPack.highlightsIntro ?? ''}
    />
  )}

  {!visualPack?.highlights?.length && galleryItems.length > 0 && (
    <VisualHighlights
      items={galleryItems}
      title={page.galleryTitle ?? 'Se guiden i billeder'}
      intro={page.galleryIntro ?? ''}
    />
  )}

  {effectiveActivityCards.length > 0 && (
    <ActivityCardGrid
      items={effectiveActivityCards}
      title={page.activityTitle ?? 'Vælg aktivitet efter den type dag, du vil have'}
      intro={page.activityIntro ?? ''}
      showImages={effectiveActivityCards.some((item) => Boolean(item.image?.src))}
    />
  )}

  {earlyMap && (
    <PlaceMap
      places={page.mapPlaces}
      title={page.mapTitle ?? `${page.destinationName} på kortet`}
      description={page.mapDescription ?? 'Se placeringerne på kortet før du vælger område, hotel eller aktivitet.'}
    />
  )}

  {page.comparisonRows?.length > 0 && (
    <section class="comparison-section">
      <div class="comparison-head">
        <p class="eyebrow">Sammenlign</p>
        <h2>{page.comparisonTitle ?? 'Hvilken aktivitet passer bedst?'}</h2>
        {page.comparisonIntro && <p>{page.comparisonIntro}</p>}
      </div>
      <div class="comparison-grid">
        {page.comparisonRows.map((row) => (
          <article class="comparison-card">
            <h3>{row.title}</h3>
            {row.bestFor && <p><b>Bedst til:</b> {row.bestFor}</p>}
            {row.time && <p><b>Tid:</b> {row.time}</p>}
            {row.notes && <p>{row.notes}</p>}
          </article>
        ))}
      </div>
    </section>
  )}

  {page.sections?.map((section, index) => {
    const contextualImage = section.image ?? (
      index % 2 === 0
        ? getDestinationSectionVisual(page, section, index, guideSlug, heroSrc)
        : null
    );
    return (
    <>
      <h2 id={section.id ?? `section-${index+1}`}>{section.heading}</h2>
      {section.lead && <p><strong>{section.lead}</strong></p>}
      {publicParagraphs(section.paragraphs).map((paragraph) => <p>{paragraph}</p>)}

      {contextualImage && contextualImage.src !== heroSrc && (
        <SectionMedia
          {...contextualImage}
          ratio={contextualImage.ratio ?? '16 / 9'}
          sizes="(max-width: 760px) calc(100vw - 32px), 760px"
        />
      )}

      {section.subsections?.length > 0 && (
        <div class="subsection-stack">
          {section.subsections.map((sub, subIndex) => (
            <>
              <div class="subsection-card">
                <div class="subsection-number">{String(subIndex + 1).padStart(2, '0')}</div>
                <div>
                  <h3>{sub.heading}</h3>
                  {publicParagraphs(sub.paragraphs).map((paragraph) => <p>{paragraph}</p>)}
                  {sub.image && sub.image.src !== heroSrc && (
                    <SectionMedia
                      {...sub.image}
                      ratio={sub.image.ratio ?? '4 / 3'}
                      sizes="(max-width: 760px) calc(100vw - 64px), 560px"
                    />
                  )}
                  {sub.bullets?.length > 0 && <ul>{sub.bullets.map((item) => <li>{item}</li>)}</ul>}
                </div>
              </div>
            </>
          ))}
        </div>
      )}

      {section.bullets?.length > 0 && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
      {section.callout && <div class="callout"><strong>{section.callout.title}</strong>{section.callout.text}</div>}
    </>
    );
  })}

  {page.sampleDay?.length > 0 && (
    <section class="day-plan">
      <div class="day-plan-head">
        <p class="eyebrow">Forslag til dag</p>
        <h2>{page.sampleDayTitle ?? 'Sådan kan en aktivitetsdag se ud'}</h2>
      </div>
      <ol class="day-plan-list">
        {page.sampleDay.map((stop) => (
          <li>
            <span>{stop.time}</span>
            <div><h3>{stop.title}</h3><p>{stop.text}</p></div>
          </li>
        ))}
      </ol>
    </section>
  )}

  {showAutoVideo && (
    <VideoEmbed
      youtubeId={autoVideo.youtubeId}
      title={autoVideo.title}
      caption={autoVideo.caption}
    />
  )}

  {page.videos?.length > 0 && (
    <section class="video-stack">
      {page.videos.map((video) => (
        <VideoEmbed youtubeId={video.youtubeId} title={video.title} caption={video.caption} />
      ))}
    </section>
  )}

  {!earlyMap && page.mapPlaces?.length > 0 && (
    <PlaceMap
      places={page.mapPlaces}
      title={page.mapTitle ?? `${page.destinationName} på kortet`}
      description={page.mapDescription ?? 'Kortet viser de steder, der er vigtigst for denne guide.'}
    />
  )}

  {page.video && (
    <VideoEmbed youtubeId={page.video.youtubeId} title={page.video.title} caption={page.video.caption} />
  )}

  {page.related?.length > 0 && (
    <>
      <h2>Læs videre</h2>
      <div class="link-list">
        {page.related.map((item) => <a class="link-card" href={item.href}>{item.title}<span>{item.text}</span></a>)}
      </div>
    </>
  )}
</ArticleLayout>

<style>
.subsection-stack{display:grid;gap:14px;margin:20px 0 30px}.subsection-card{display:grid;grid-template-columns:46px 1fr;gap:16px;padding:20px 22px;border:1px solid var(--border);border-radius:20px;background:rgba(255,255,255,.64);box-shadow:0 8px 24px rgba(16,55,41,.045)}.subsection-number{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;background:var(--green-950);color:#fff;font-size:.77rem;font-weight:900;letter-spacing:.04em}.subsection-card h3{margin:2px 0 8px;font-size:1.23rem}.subsection-card p{margin:0!important;color:var(--muted)!important}.subsection-card p+p{margin-top:8px!important}.subsection-card ul{margin:10px 0 0}.comparison-section,.day-plan{margin:42px 0}.comparison-head,.day-plan-head{margin-bottom:18px}.comparison-head h2,.day-plan-head h2{font-size:clamp(1.8rem,4vw,2.5rem);margin:0}.comparison-head>p:not(.eyebrow){margin-top:8px;max-width:720px;color:var(--muted)}.comparison-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.comparison-card{padding:20px;border:1px solid var(--border);border-radius:18px;background:#fffdf8}.comparison-card h3{margin:0 0 9px;font-size:1.18rem}.comparison-card p{margin:5px 0!important;color:var(--muted)!important}.day-plan-list{list-style:none;padding:0;margin:0;display:grid;gap:0}.day-plan-list li{display:grid;grid-template-columns:88px 1fr;gap:18px;position:relative;padding:0 0 24px}.day-plan-list li:not(:last-child)::after{content:'';position:absolute;left:43px;top:39px;bottom:0;width:1px;background:var(--border)}.day-plan-list>li>span{display:grid;place-items:center;align-self:start;min-height:38px;padding:7px;border-radius:12px;background:var(--green-950);color:white;font-size:.78rem;font-weight:850}.day-plan-list h3{margin:1px 0 6px;font-size:1.12rem}.day-plan-list p{margin:0!important;color:var(--muted)!important}.video-stack{display:grid;gap:24px;margin:36px 0}
@media(max-width:700px){.comparison-grid{grid-template-columns:1fr}.day-plan-list li{grid-template-columns:72px 1fr;gap:12px}.day-plan-list li:not(:last-child)::after{left:35px}}
@media(max-width:640px){.subsection-card{grid-template-columns:38px 1fr;padding:17px 16px;gap:12px}.subsection-number{width:34px;height:34px;border-radius:10px}.subsection-card h3{font-size:1.08rem}}
</style>
