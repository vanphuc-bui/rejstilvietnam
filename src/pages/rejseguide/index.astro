---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionMedia from '../../components/SectionMedia.astro';
import { hubVisuals } from '../../data/hubVisuals.js';

const topics = [
  { icon:'🥾', title:'Aktiv ferie i Vietnam', text:'Løb, cykling, vandring, kajak og SUP med distance, tidsforbrug, sværhedsgrad og kort til startområdet.', href:'/aktiv-ferie-i-vietnam/' },
  { icon:'🇻🇳', title:'Rejser til Vietnam', text:'Den komplette startguide til rute, rejsetid, bookingrækkefølge og de valg der påvirker hele ferien.', href:'/rejseguide/rejser-til-vietnam/' },
  { icon:'🧭', title:'Vietnam rejsevejledning', text:'Aktuel dansk guide til sikkerhed, pas, visumfri indrejse, trafik, sundhed og checkliste før afrejse.', href:'/rejseguide/vietnam-rejsevejledning/' },
  { icon:'☀️', title:'Bedste rejsetid', text:'Se hvornår nord, midt og syd passer bedst - og hvordan du justerer ruten, hvis feriedatoerne allerede er faste.', href:'/rejseguide/bedste-rejsetid/' },
  { icon:'🛂', title:'Visum og indrejse', text:'45 dages visumfri indrejse, paskrav og det praktiske du bør gemme på telefonen før afrejse.', href:'/rejseguide/visum/' },
  { icon:'💳', title:'Penge og priser', text:'Kort, kontanter, hæveautomater og hvad vi synes det giver mening at betale lidt mere for.', href:'/rejseguide/penge-og-priser/' },
  { icon:'🚆', title:'Transport', text:'Hvornår vi ville vælge fly, tog, bus, taxi eller Grab - og hvornår tid er vigtigere end den laveste pris.', href:'/rejseguide/transport/' },
  { icon:'📱', title:'eSIM i Vietnam', text:'Sammenlign Airalo, Holafly og Nomad, se hvor meget data du behøver og installer før afrejse.', href:'/rejseguide/esim-vietnam/' },
  { icon:'🧳', title:'Pakkeliste til Vietnam', text:'Dokumenter, tøj, elektronik og de ting vi ville lade blive hjemme på en rundrejse.', href:'/rejseguide/pakkeliste-vietnam/' },
  { icon:'🍜', title:'Mad i Vietnam', text:'15 retter fra nord, midt og syd plus konkrete råd til street food og bestilling.', href:'/rejseguide/mad-i-vietnam/' },
  { icon:'💉', title:'Vaccinationer til Vietnam', text:'Sådan bruger du SSI efter rejselængde, rute og særlige risici i stedet for en fast standardliste.', href:'/rejseguide/vaccinationer-vietnam/' },
  { icon:'🛡️', title:'Rejseforsikring', text:'Tjek sygdom, hjemtransport, scooter, dykning og andre aktiviteter før du vælger police.', href:'/rejseguide/rejseforsikring-vietnam/' },
  { icon:'🙏', title:'Kultur og etikette', text:'Templer, bordskik, billeder, drikkepenge og de små vaner der gør mødet med hverdagen lettere.', href:'/rejseguide/kultur-og-etikette-vietnam/' },
  { icon:'👨‍👩‍👧', title:'Vietnam med børn', text:'Familievenlig rute med færre hotelskift, pool- og stranddage samt praktiske råd til transport og mad.', href:'/rejseguide/vietnam-med-boern/' },
  { icon:'💸', title:'Billige rejser til Vietnam', text:'Spar på fly, rute, hotel og transport uden at gøre ferien unødigt besværlig.', href:'/rejseguide/billige-rejser-til-vietnam/' },
  { icon:'🗺️', title:'Vietnam på 2 uger', text:'En konkret rute med fem stop og råd om, hvad vi ville fjerne, hvis du vil have strand eller mindre transport.', href:'/rejseplaner/vietnam-2-uger/' },
];
---
<BaseLayout title="Vietnam rejseguide 2026 | Visum, vejr, penge og transport" description="Praktisk Vietnam-rejseguide for danskere: rejsetid, visum, penge, eSIM, pakkeliste, vaccinationer, forsikring og transport før afrejse.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Planlæg rejsen</p>
      <h1>Vietnam rejseguide: få styr på det praktiske før afrejse.</h1>
      <p class="lead">Før du booker ture og hoteller, er det bedre at få styr på årstid, rute, transport og hvor mange hotelskift du faktisk gider have.</p>
    </div>
  </section>
  <div class="container hub-hero-media">
    <SectionMedia {...hubVisuals.planningHero} loading="eager" fetchpriority="high" />
  </div>

  <section class="section section--tight">
    <div class="container grid grid--3">
      {topics.map((topic) => (
        <a class="card icon-card" href={topic.href}>
          <span class="icon">{topic.icon}</span>
          <h3>{topic.title}</h3>
          <p>{topic.text}</p>
          <span class="more">Læs guiden →</span>
        </a>
      ))}
    </div>
  </section>
  <section class="section tools-section">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Gratis værktøjer</p><h2>Byg ruten, kontrollér transporten og test budgettet.</h2></div>
        <p>Start med Trip Planner, brug Transport Matrix til de store hop, og kontrollér derefter budget og vejrsæson.</p>
      </div>
      <div class="tools-grid">
        <a class="card tool-card tool-card--lead" href="/vaerktoejer/vietnam-trip-planner/"><span>🧭</span><h3>Vietnam Trip Planner</h3><p>Få en personlig 10-, 14- eller 21-dages rute ud fra måned, rejsetype, tempo, budget og interesser.</p><b>Byg min rute →</b></a>
        <a class="card tool-card tool-card--lead" href="/vaerktoejer/transport-matrix/"><span>⇄</span><h3>Transport Matrix</h3><p>Sammenlign realistisk rejsetid, pris og besvær mellem de vigtigste stop.</p><b>Sammenlign transport →</b></a>
        <a class="card tool-card" href="/vaerktoejer/vietnam-rutekort/"><span>🗺️</span><h3>Vietnam rutekort</h3><p>Sammenlign 10, 14 og 21 dage og se de store transporthop på én skærm.</p><b>Åbn rutekort →</b></a>
        <a class="card tool-card" href="/vaerktoejer/vietnam-budgetberegner/"><span>🧮</span><h3>Budgetberegner</h3><p>Regn hotel, mad, transport, ture og fly om til både DKK og VND.</p><b>Beregn budget →</b></a>
        <a class="card tool-card" href="/vaerktoejer/vietnam-vejrhjaelp/"><span>☀️</span><h3>Vejrplanlægger</h3><p>Vælg måned og sammenlign nord, central, syd og Phu Quoc.</p><b>Vælg måned →</b></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container article-shell">
      <article class="prose">
        <p class="eyebrow">Hvis det er første gang</p>
        <h2>Vi ville planlægge i denne rækkefølge</h2>
        <p>Vælg først dato og antal rejsedage. Derefter vælger du 3-5 hovedstop. Først når ruten giver mening, ville vi booke indenrigsfly, hoteller og større ture.</p>
        <p>På to uger ville vi ikke prøve at kombinere Hanoi, Sapa, Ha Long Bay, Ninh Binh, Hue, Hoi An, Da Nang, Ho Chi Minh City, Mekong og Phu Quoc. Det kan lade sig gøre på papiret, men du kommer til at pakke og transportere dig gennem en stor del af ferien.</p>
        <div class="notice"><strong>Aktuelle regler først.</strong> Visum, indrejse, sundhed og rejsevejledninger kan ændres. På de relevante artikler linker vi til de officielle kilder, som bør være din sidste kontrol før afrejse.</div>
      </article>
      <aside class="card sidebar">
        <h3>En enkel rækkefølge</h3>
        <p style="margin-top:12px;color:var(--muted)">1. Dato og rejsetid<br/>2. Visum<br/>3. 3-5 stop<br/>4. Internationale og indenrigsfly<br/>5. Hoteller<br/>6. Forsikring, sundhed og eSIM<br/>7. Ture og oplevelser</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>.hub-hero-media{margin-top:8px}.tools-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px}.tool-card{grid-column:span 2}.tool-card--lead{grid-column:span 3}.hub-hero-media :global(.section-media){margin-top:0}.tools-section{background:#f5efe2}.tool-card{display:flex;flex-direction:column;padding:26px;min-height:250px}.tool-card>span{font-size:1.7rem}.tool-card h3{margin-top:14px}.tool-card p{margin-top:8px;color:var(--muted)}.tool-card b{margin-top:auto;padding-top:20px;color:var(--green-700)}@media(max-width:900px){.tools-grid{grid-template-columns:1fr 1fr}.tool-card,.tool-card--lead{grid-column:auto}}@media(max-width:640px){.tools-grid{grid-template-columns:1fr}.hub-hero-media{margin-top:0}.tool-card{min-height:0}}</style>
