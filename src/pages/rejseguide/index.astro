---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionMedia from '../../components/SectionMedia.astro';
import VietnamRouteMap from '../../components/VietnamRouteMap.astro';
import { hubVisuals } from '../../data/hubVisuals.js';

const sections = [
  { id: 'kort-svar', label: 'Vietnam på 1 minut' },
  { id: 'rejsetid', label: 'Bedste rejsetid' },
  { id: 'rejsemaal', label: 'Vælg rejsemål' },
  { id: 'rejseplan', label: '10, 14 eller 21 dage?' },
  { id: 'budget', label: 'Budget i danske kroner' },
  { id: 'transport', label: 'Transport mellem byerne' },
  { id: 'praktisk', label: 'Visum, pas og sikkerhed' },
  { id: 'bestilling', label: 'Booking i den rigtige rækkefølge' },
  { id: 'faq', label: 'Ofte stillede spørgsmål' },
];

const relatedTopics = [
  { label: 'Visum og indrejse', href: '/rejseguide/visum/', text: 'Pas, visumregler og officiel kontrol før afrejse.' },
  { label: 'Vietnam rejsevejledning', href: '/rejseguide/vietnam-rejsevejledning/', text: 'Sikkerhed, trafik, sundhed og rejseråd.' },
  { label: 'Bedste rejsetid', href: '/rejseguide/bedste-rejsetid/', text: 'Måned-for-måned gennemgang af vejret.' },
  { label: 'Transport i Vietnam', href: '/rejseguide/transport/', text: 'Hvornår fly, tog, bus og bil giver mening.' },
  { label: 'Penge og priser', href: '/rejseguide/penge-og-priser/', text: 'Kort, kontanter og udgifter undervejs.' },
  { label: 'eSIM i Vietnam', href: '/rejseguide/esim-vietnam/', text: 'Data, dækning og opsætning før afrejse.' },
  { label: 'Vietnam med børn', href: '/rejseguide/vietnam-med-boern/', text: 'Færre skift og gode pauser for familier.' },
  { label: 'Pakkeliste til Vietnam', href: '/rejseguide/pakkeliste-vietnam/', text: 'En praktisk liste uden unødvendig bagage.' },
  { label: 'Vaccinationer til Vietnam', href: '/rejseguide/vaccinationer-vietnam/', text: 'Forbered konsultationen med relevante kilder.' },
  { label: 'Rejseforsikring', href: '/rejseguide/rejseforsikring-vietnam/', text: 'Vælg dækning til aktiviteter og rejseform.' },
  { label: 'Mad i Vietnam', href: '/rejseguide/mad-i-vietnam/', text: 'Lokale retter og praktiske spiseoplevelser.' },
  { label: 'Aktiv ferie i Vietnam', href: '/aktiv-ferie-i-vietnam/', text: 'Løb, cykling, vandring og andre aktive dage.' },
];
---
<BaseLayout
  title="Vietnam rejseguide | Ruter, vejr, budget og visum"
  description="Komplet Vietnam rejseguide på dansk: vælg rejsetid, planlæg 10–21 dage, sammenlign rejsemål og budget i DKK, og få styr på visum og transport."
  image={hubVisuals.planningHero.src}
>
  <header class="page-hero pillar-hero">
    <div class="container">
      <p class="eyebrow">Vietnam rejseguide for danskere</p>
      <h1>Vietnam rejseguide: planlæg en rejse, der faktisk hænger sammen</h1>
      <p class="lead">Første gang i Vietnam? Her får du overblikket over rejsetid, rute, pris og de praktiske valg – med konkrete genveje til de guider, hvor du kan gå i dybden.</p>
      <div class="pillar-actions">
        <a class="btn btn--primary" href="#kort-svar">Start med overblikket</a>
        <a class="btn btn--outline" href="/vaerktoejer/vietnam-trip-planner/">Byg din egen rejseplan</a>
      </div>
      <p class="pillar-byline">Udarbejdet af <a href="/om/van-phuc-bui/">Van-Phuc Bui</a> · Om vores rejsefaglige redaktion: <a href="/om/">Mød holdet bag guiden</a></p>
    </div>
  </header>
  <div class="container pillar-hero-media">
    <SectionMedia {...hubVisuals.planningHero} loading="eager" fetchpriority="high" sizes="(max-width: 640px) calc(100vw - 24px), 1180px" />
  </div>

  <div class="container pillar-layout">
    <article class="prose pillar-article">
      <section id="kort-svar" class="pillar-section" aria-labelledby="kort-svar-title">
        <p class="eyebrow">Kort svar</p>
        <h2 id="kort-svar-title">Vietnam på ét minut</h2>
        <p><strong>Den bedste start er at vælge datoer og antal dage, før du vælger hoteller.</strong> Vietnam strækker sig langt fra nord til syd, og vejret kan være vidt forskelligt i Hanoi, Hoi An og på Phu Quoc. For en første rejse er 14–21 dage ofte et godt udgangspunkt, men 10 dage kan også fungere, hvis du vælger færre steder.</p>
        <div class="fact-grid" aria-label="Tre hurtige råd">
          <div class="fact"><span>Førstegangsrejse</span><b>14 dage: 3–5 hovedstop</b></div>
          <div class="fact"><span>Vejr</span><b>Vælg region efter måned</b></div>
          <div class="fact"><span>Transport</span><b>Regn med rejsedage</b></div>
        </div>
        <p>Vores vigtigste råd: Du behøver ikke krydse hele landet for at få en god ferie. To regioner med tid til oplevelser slår ofte seks byer og daglige hotelskift. Skal du af sted i skoleferien, bør du især vurdere varme, regn og hvor mange lange transportdage børnene orker.</p>
        <div class="callout"><strong>Tre beslutninger før du booker</strong>Fastlæg (1) hvornår I kan rejse, (2) hvor mange hele dage I har i Vietnam, og (3) om I helst vil opleve natur, byer, mad eller strand. Brug derefter <a href="/vaerktoejer/vietnam-trip-planner/">Trip Planner</a> til en første rute.</div>
      </section>

      <section id="rejsetid" class="pillar-section" aria-labelledby="rejsetid-title">
        <p class="eyebrow">Vejr og sæson</p>
        <h2 id="rejsetid-title">Hvornår er det bedst at rejse til Vietnam?</h2>
        <p>Der findes ikke én perfekt rejsemåned til hele Vietnam. Nord har køligere vinter og varme, fugtige somre. På centralkysten ligger den mest regnfulde periode ofte senere på året, mens syd typisk har tørre måneder omkring december–april. Derfor er <strong>rejseruten vigtigere end en enkelt “bedste måned”</strong>.</p>
        <div class="pillar-table-wrap" role="region" aria-label="Sammenligning af rejsevejr i Vietnam" tabindex="0">
          <table>
            <caption>Hurtigt sæsonoverblik – typiske mønstre, ikke en vejrgaranti</caption>
            <thead><tr><th scope="col">Område</th><th scope="col">Godt udgangspunkt</th><th scope="col">Vær særligt opmærksom på</th></tr></thead>
            <tbody>
              <tr><th scope="row">Nord: Hanoi, Ninh Binh, Ha Long</th><td>Ca. marts–maj og september–november</td><td>Kølige vinterdage; varme, regn og mulig storm om sommeren</td></tr>
              <tr><th scope="row">Midt: Hue, Da Nang, Hoi An</th><td>Ofte februar–august, afhængigt af byen</td><td>Kraftig regn og risiko for oversvømmelse især i efteråret</td></tr>
              <tr><th scope="row">Syd: Ho Chi Minh City, Mekong</th><td>Typisk december–april for mere tørt vejr</td><td>Byger i den våde sæson og høj varme året rundt</td></tr>
              <tr><th scope="row">Phu Quoc</th><td>Ofte december–april til strandferie</td><td>Regn og uroligt hav i sommer-/sensommerperioden</td></tr>
            </tbody>
          </table>
        </div>
        <p><strong>Rejser du i oktober eller november?</strong> Lad være med automatisk at booke lange strandophold omkring Hoi An. Her kan regnen være markant anderledes end i Hanoi eller på Phu Quoc. Rejser du i juli, er varme og byger noget, du bør planlægge pauser omkring. Vi ville hellere flytte på destinationerne end holde fast i en rute fra en flot reklame.</p>
        <p>Se den detaljerede <a href="/rejseguide/bedste-rejsetid/">måned-for-måned-guide til Vietnam</a>, eller <a href="/vaerktoejer/vietnam-vejrhjaelp/">sammenlign regionerne i vejrplanlæggeren</a>. Klimamønstret er opsummeret med udgangspunkt i <a href="https://vietnam.travel/things-to-do/weather-and-climate-vietnam/" target="_blank" rel="noopener noreferrer">Vietnam Tourisms regionale vejrguide</a>.</p>
      </section>

      <section id="rejsemaal" class="pillar-section" aria-labelledby="rejsemaal-title">
        <p class="eyebrow">Find din type ferie</p>
        <h2 id="rejsemaal-title">Hvor i Vietnam skal du starte?</h2>
        <p>Hvis du kan lide storby, kultur og lette naturudflugter, er Nordvietnam et stærkt førstevalg. Vil du kombinere strand, historiske gader og korte transportstræk, giver Centralvietnam mening. Sydvietnam passer godt til storby, Mekongdelta og en mulig afslutning på Phu Quoc.</p>
        <div class="region-grid">
          <div class="region-card">
            <SectionMedia {...hubVisuals.hanoiThreeDaysHero} ratio="4 / 3" loading="lazy" sizes="(max-width: 700px) calc(100vw - 48px), 250px" />
            <h3>Nordvietnam</h3>
            <p><strong>Vælg nord for:</strong> Hanoi, natur i Ninh Binh, Ha Long Bay og ture mod Sapa. Godt til historie, mad og landskaber.</p>
            <a href="/destinationer/hanoi/">Start med vores Hanoi-guide →</a>
          </div>
          <div class="region-card">
            <SectionMedia {...hubVisuals.plans.fourteenDays} caption="Strand ved Hoi An. Kombinér byen med rolige dage ved kysten." ratio="4 / 3" loading="lazy" sizes="(max-width: 700px) calc(100vw - 48px), 250px" />
            <h3>Centralvietnam</h3>
            <p><strong>Vælg midt for:</strong> Hoi An, Da Nang og Hue. Nem kombination af gamle byer, mad, strand og korte transfers.</p>
            <a href="/destinationer/hoi-an/">Se Hoi An og området →</a>
          </div>
          <div class="region-card">
            <SectionMedia {...hubVisuals.hotels.phuQuoc} caption="Phu Quoc er en mulighed, hvis du vil afslutte med strand." ratio="4 / 3" loading="lazy" sizes="(max-width: 700px) calc(100vw - 48px), 250px" />
            <h3>Sydvietnam</h3>
            <p><strong>Vælg syd for:</strong> Ho Chi Minh City, Mekongdeltaet og Phu Quoc. Godt til en kombination af by og afslapning.</p>
            <a href="/destinationer/ho-chi-minh-city/">Læs om Ho Chi Minh City →</a>
          </div>
        </div>
        <p>Skal du have mere end én region med, så overvej et <em>open-jaw</em>-fly: ind i Hanoi og hjem fra Ho Chi Minh City, eller omvendt. Det kan spare en unødvendig tur tilbage til startbyen. Sammenlign dog den samlede billetpris og forbindelserne, før du beslutter dig.</p>
        <p><a href="/destinationer/">Sammenlign alle rejsemål i Vietnam</a> – her finder du også Nha Trang, Hue, Da Lat og flere steder, som passer til mere specifikke ønsker.</p>
      </section>

      <section id="rejseplan" class="pillar-section" aria-labelledby="rejseplan-title">
        <p class="eyebrow">Vælg et tempo</p>
        <h2 id="rejseplan-title">Vietnam på 10, 14 eller 21 dage?</h2>
        <p>En god Vietnam-rute afhænger mere af antallet af transportskift end af antallet af seværdigheder. Vi tæller en stor transportstrækning som mindst en halv feriedag, også når selve flyveturen kun varer lidt over en time: hotel, lufthavn, ventetid og transfer skal med.</p>
        <div class="pillar-table-wrap" role="region" aria-label="Sammenlign rejseplaner til Vietnam" tabindex="0">
          <table>
            <caption>Eksempler på ruter – tilpas efter vejr, ankomstby og interesser</caption>
            <thead><tr><th scope="col">Varighed</th><th scope="col">Eksempel på rute</th><th scope="col">Hvem passer den til?</th></tr></thead>
            <tbody>
              <tr><th scope="row"><a href="/rejseplaner/vietnam-10-dage/">10 dage</a></th><td>Hanoi → Ninh Binh → Hoi An → Ho Chi Minh City</td><td>Første indtryk; stramt tempo. Overvej kun to regioner, hvis du vil slappe af.</td></tr>
              <tr><th scope="row"><a href="/rejseplaner/vietnam-2-uger/">14 dage</a></th><td>Hanoi → Ninh Binh → Ha Long Bay → Hoi An → Ho Chi Minh City</td><td>Balanceret rundrejse, men kræver planlagte transportdage.</td></tr>
              <tr><th scope="row"><a href="/rejseplaner/vietnam-3-uger/">21 dage</a></th><td>Nord → Centralvietnam → Syd, evt. Mekong og Phu Quoc</td><td>Mere tid til natur, mad og flere afslappede dage.</td></tr>
            </tbody>
          </table>
        </div>
        <VietnamRouteMap route="14" compact />
        <p>På en 14-dages tur ville vi især undgå en sen indenrigsflyvning samme dag som et cruise slutter. Flytider, bådtransport og trafik er ikke altid forudsigelige. Rejser du med små børn, så fjern et stop i stedet for at presse flere aktiviteter ind på hver dag.</p>
        <p><a href="/rejseplaner/vietnam-2-uger/">Se vores komplette 14-dages rejseplan</a> eller <a href="/vaerktoejer/vietnam-rutekort/">sammenlign rutekort for 10, 14 og 21 dage</a>.</p>
      </section>

      <section id="budget" class="pillar-section" aria-labelledby="budget-title">
        <p class="eyebrow">Budget i DKK</p>
        <h2 id="budget-title">Hvad koster 14 dage i Vietnam?</h2>
        <p>Den store forskel på et billigt og dyrt ophold er sjældent en skål nudler. Det er typisk internationale fly, valg af hoteller, antal indenrigsfly og private ture. Derfor er et budget kun nyttigt, hvis du kan se antagelserne bag tallet.</p>
        <div class="pillar-table-wrap" role="region" aria-label="Eksempelbudget for to personer" tabindex="0">
          <table>
            <caption>Regneeksempel: 2 voksne, 14 dage og 13 hotelnætter – ikke aktuelle tilbud eller markedspriser</caption>
            <thead><tr><th scope="col">Udgift</th><th scope="col">Antagelse</th><th scope="col">I alt</th></tr></thead>
            <tbody>
              <tr><th scope="row">Hoteller</th><td>450 DKK pr. værelse × 13 nætter</td><td>5.850 DKK</td></tr>
              <tr><th scope="row">Mad og drikke</th><td>200 DKK × 2 personer × 14 dage</td><td>5.600 DKK</td></tr>
              <tr><th scope="row">Lokal transport</th><td>75 DKK × 2 × 14</td><td>2.100 DKK</td></tr>
              <tr><th scope="row">Aktiviteter</th><td>150 DKK × 2 × 14</td><td>4.200 DKK</td></tr>
              <tr><th scope="row">Transport mellem byer</th><td>1.500 DKK × 2</td><td>3.000 DKK</td></tr>
              <tr><th scope="row">Fly Danmark–Vietnam tur/retur</th><td>6.500 DKK × 2</td><td>13.000 DKK</td></tr>
              <tr><th scope="row">Buffer</th><td>10 % af beløbet ovenfor</td><td>3.375 DKK</td></tr>
              <tr class="total-row"><th scope="row" colspan="2">Samlet eksempel</th><td>37.125 DKK</td></tr>
            </tbody>
          </table>
        </div>
        <p>Dette er et <strong>illustrativt budget</strong>, ikke et prisløfte. Det er baseret på startværdierne i vores budgetberegner, og virkelige priser varierer efter sæson, standard og bookingtidspunkt. Kig især på dit fly og dine konkrete hotelmuligheder, før du bruger et samlet beløb.</p>
        <div class="callout"><strong>Prøv dine egne tal</strong>Brug <a href="/vaerktoejer/vietnam-budgetberegner/">budgetberegneren i DKK og VND</a> til at ændre antal personer, hotelpris, fly, udflugter og buffer. Se også <a href="/rejseguide/penge-og-priser/">vores guide til kontanter, betalingskort og prisniveau</a>.</div>
      </section>

      <section id="transport" class="pillar-section" aria-labelledby="transport-title">
        <p class="eyebrow">Tidsforbrug mellem stop</p>
        <h2 id="transport-title">Transport i Vietnam: køb ikke kun den billigste billet</h2>
        <p>Et billigt nattog kan være en oplevelse, men på en kort ferie kan et indenrigsfly give mere tid på destinationen. Omvendt er fly mellem nærliggende byer ofte unødvendige, når bil eller tog er enklere fra dør til dør.</p>
        <div class="pillar-table-wrap" role="region" aria-label="Valg af transporttype" tabindex="0">
          <table>
            <caption>Beslutningshjælp til almindelige transportvalg</caption>
            <thead><tr><th scope="col">Situation</th><th scope="col">Vi ville undersøge først</th><th scope="col">Husk</th></tr></thead>
            <tbody>
              <tr><th scope="row">Hanoi ↔ Ninh Binh</th><td>Bil, tog eller organiseret dagstur</td><td>En overnatning giver mere ro end en presset dagstur.</td></tr>
              <tr><th scope="row">Da Nang ↔ Hoi An</th><td>Bil, Grab eller hoteltransfer</td><td>Praktisk med bagage; undgå unødvendigt hotelskift.</td></tr>
              <tr><th scope="row">Nord ↔ Centralvietnam</th><td>Fly eller nattog alt efter tid og lyst</td><td>Medregn hele rejsedagen, ikke kun flytid.</td></tr>
              <tr><th scope="row">Centralvietnam ↔ Ho Chi Minh City</th><td>Indenrigsfly på en kort rundrejse</td><td>Forbindelse, bagage og transfer påvirker prisen.</td></tr>
            </tbody>
          </table>
        </div>
        <p>Vi ville ikke leje scooter i hektisk storbytrafik bare for at spare lidt på taxi. Overvej sikkerhed, forsikring, lovligt kørekort og erfaring. Se <a href="/rejseguide/transport/">den fulde transportguide</a> og brug <a href="/vaerktoejer/transport-matrix/">Transport Matrix</a> til at sammenligne større hop i ruten.</p>
      </section>

      <section id="praktisk" class="pillar-section" aria-labelledby="praktisk-title">
        <p class="eyebrow">Før du rejser</p>
        <h2 id="praktisk-title">Visum, pas, forsikring og sikkerhed</h2>
        <p>For danske statsborgere oplyser Udenrigsministeriet, at Vietnam har <strong>visumfri indrejse i op til 45 dage</strong>, og at passet som udgangspunkt skal være gyldigt mindst seks måneder ved indrejsen. Regler kan ændre sig, og der gælder andre forhold for nogle pas- og statsborgerskabstyper. Kontrollér derfor altid <a href="https://um.dk/rejse-og-ophold/rejse-til-udlandet/pas-og-visum/vietnam/" target="_blank" rel="noopener noreferrer">Udenrigsministeriets side om pas og visum</a> og Vietnams ambassade før afrejse.</p>
        <p>Ved ankomst til Ho Chi Minh Citys Tan Son Nhat-lufthavn kan der desuden gælde krav om en digital indrejseformular. Tjek den aktuelle procedure, når du kender din ankomstlufthavn. Rejseråd om trafik, tyveri og sundhed finder du hos <a href="https://um.dk/rejse-og-ophold/rejse-til-udlandet/rejsevejledninger/vietnam" target="_blank" rel="noopener noreferrer">Udenrigsministeriet</a>.</p>
        <ol>
          <li><strong>Pas og indrejse:</strong> Kontrollér gyldighed, visumfri periode, transit og dokumentkrav ud fra dit eget pas.</li>
          <li><strong>Forsikring:</strong> Tjek dækning for sygdom, hjemtransport og aktiviteter som scooter eller dykning. Det gule og blå sundhedskort dækker ikke almindelig rejsebehandling i Vietnam.</li>
          <li><strong>Sundhed:</strong> Få rejsevaccinationsråd ud fra rute, varighed og aktiviteter – ikke bare fra en generisk liste.</li>
          <li><strong>Telefon og penge:</strong> Gem offline-kopier af billetter og pasoplysninger, og hav både betalingskort og en lille kontantreserve.</li>
          <li><strong>Transport fra lufthavnen:</strong> Aftal første transfer på forhånd, hvis du lander sent eller rejser med børn.</li>
        </ol>
        <p>Læs videre om <a href="/rejseguide/visum/">Vietnam-visum</a>, <a href="/rejseguide/rejseforsikring-vietnam/">rejseforsikring</a>, <a href="/rejseguide/vaccinationer-vietnam/">vaccinationer</a> og <a href="/rejseguide/esim-vietnam/">eSIM</a>.</p>
      </section>

      <section id="bestilling" class="pillar-section" aria-labelledby="bestilling-title">
        <p class="eyebrow">Fra idé til reservation</p>
        <h2 id="bestilling-title">Sådan ville vi planlægge og booke rejsen</h2>
        <p>Det er fristende at begynde med et lækkert hotel. Men hvis du senere opdager, at det ligger i den forkerte region i regnsæsonen, kan en billig booking ende som en dyr beslutning. Brug hellere rækkefølgen nedenfor.</p>
        <ol class="booking-steps">
          <li><strong>Fastlæg datoer og antal dage.</strong> Tjek højtider, ankomsttid og hvilke regioner der passer til vejret.</li>
          <li><strong>Vælg få, logiske baser.</strong> Lav en rute med realistiske transportdage. Kig på <a href="/rejseplaner/vietnam-2-uger/">vores 14-dages eksempel</a>.</li>
          <li><strong>Sammenlign internationale fly.</strong> Overvej forskellige ankomst- og afrejsebyer, hvis ruten er nord–syd.</li>
          <li><strong>Lås de store strækninger.</strong> Tjek indenrigsfly, tog og lange transfers, før du binder dig til alle hoteller.</li>
          <li><strong>Vælg hotelområde før hotel.</strong> Eksempelvis kan en central base i <a href="/destinationer/hanoi/hvor-skal-man-bo/">Hanoi</a> spare tid og transport.</li>
          <li><strong>Book kun de tidskritiske oplevelser tidligt.</strong> Eksempelvis <a href="/ture/halong-bay-cruise/">Ha Long Bay cruise</a> eller en nøje udvalgt <a href="/ture/ninh-binh-fra-hanoi/">Ninh Binh-tur</a>.</li>
          <li><strong>Gennemgå pas, visum, forsikring og eSIM.</strong> Tag den sidste kontrol tæt på afrejse.</li>
        </ol>
        <div class="pillar-cta">
          <div><p class="eyebrow">Byg videre</p><h3>Klar til din egen Vietnam-rute?</h3><p>Vælg rejsemåned, antal dage, tempo og interesser. Tilpas derefter transport og budget – før du bestiller.</p></div>
          <div class="pillar-cta-buttons"><a class="btn btn--primary" href="/vaerktoejer/vietnam-trip-planner/">Åbn Trip Planner</a><a class="btn btn--outline" href="/vaerktoejer/vietnam-budgetberegner/">Beregn budget</a></div>
        </div>
      </section>

      <section id="faq" class="pillar-section" aria-labelledby="faq-title">
        <p class="eyebrow">Ofte stillede spørgsmål</p>
        <h2 id="faq-title">Spørgsmål før den første Vietnam-rejse</h2>
        <div class="pillar-faq">
          <h3>Er 14 dage nok til Vietnam?</h3>
          <p>Ja, til en første rundrejse med udvalgte stop. Vi ville ikke presse både Sapa, Hue, Mekong og Phu Quoc ind oven i den klassiske 14-dages rute.</p>
          <h3>Skal man rejse fra nord til syd?</h3>
          <p>Nej. Retningen bør afhænge af flypriser, sæson og dine prioriterede destinationer. Du kan også holde dig til én eller to regioner.</p>
          <h3>Er Vietnam billigt for danskere?</h3>
          <p>Daglige udgifter kan være lavere end i Danmark, men internationale fly og ture kan dominere budgettet. Brug dine egne tal frem for en generel dagspris.</p>
