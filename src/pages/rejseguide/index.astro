---
import BaseLayout from '../../layouts/BaseLayout.astro';

const topics = [
  { icon:'☀️', title:'Bedste rejsetid', text:'Se vejret i nord, midt og syd – og vælg dato efter din rute.', href:'/rejseguide/bedste-rejsetid/' },
  { icon:'🛂', title:'Visum og indrejse', text:'45 dages visumfri indrejse, paskrav og den nye PAI-regel ved SGN.', href:'/rejseguide/visum/' },
  { icon:'💳', title:'Penge og priser', text:'Byg et realistisk budget og forstå kort, kontanter og de dyre poster.', href:'/rejseguide/penge-og-priser/' },
  { icon:'🚆', title:'Transport', text:'Fly, tog, bus, taxi og hvordan du undgår at bruge ferien på transport.', href:'/rejseguide/transport/' },
  { icon:'🗺️', title:'Vietnam på 2 uger', text:'En konkret nord-til-syd-rute, der ikke prøver at nå alt.', href:'/rejseplaner/vietnam-2-uger/' },
  { icon:'🛳️', title:'Ha Long Bay', text:'Dagstur eller overnatning? Sådan sammenligner du cruises.', href:'/ture/halong-bay-cruise/' },
];
---
<BaseLayout title="Vietnam rejseguide for danskere | RejsTilVietnam.dk" description="Praktisk Vietnam rejseguide for danskere: rejsetid, visum, penge, transport, rejseplaner og oplevelser.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Rejseguide</p>
      <h1>Det praktiske, før du tager af sted.</h1>
      <p class="lead">Start med de valg, der påvirker hele turen: hvornår du rejser, hvor længe du bliver, og hvor hurtigt du vil bevæge dig gennem landet.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container grid grid--3">
      {topics.map((topic) => (
        <a class="card icon-card" href={topic.href}>
          <span class="icon">{topic.icon}</span>
          <h3>{topic.title}</h3>
          <p>{topic.text}</p>
          <span class="more">Læs guiden →</span>
        </a>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="container article-shell">
      <article class="prose">
        <p class="eyebrow">Start her</p>
        <h2>Sådan ville vi planlægge den første Vietnam-rejse</h2>
        <p>Vælg først årstid og rejselængde. Derefter vælger du 3–5 stop, så turen ikke bliver en konstant transportøvelse. For en to ugers rejse er Hanoi, Ninh Binh, Ha Long Bay, Hoi An og Ho Chi Minh City et stærkt udgangspunkt.</p>
        <p>Book de vigtigste langdistancetransporter og overnatninger på forhånd, men behold lidt fleksibilitet til mad, caféliv og spontane oplevelser.</p>
        <div class="notice"><strong>Aktuelle regler først.</strong> Visum, indrejse og rejsevejledninger kan ændres. Vi linker til officielle kilder på de artikler, hvor det er relevant.</div>
      </article>
      <aside class="card sidebar">
        <h3>God rækkefølge</h3>
        <p style="margin-top:12px;color:var(--muted)">1. Rejsetid<br/>2. Visum<br/>3. Rute<br/>4. Fly & hoteller<br/>5. Ture<br/>6. Lokal transport</p>
      </aside>
    </div>
  </section>
</BaseLayout>
