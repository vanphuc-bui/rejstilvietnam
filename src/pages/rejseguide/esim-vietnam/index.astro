---
import GuideCover from '../../../components/GuideCover.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const providers = [
  { label:'Nemt valg', name:'Airalo', mode:'Fast data + unlimited muligheder', fit:'God hvis du vil vælge mellem flere datamængder og styre alt i en app.', watch:'Tjek gyldighed, fair-use og om den konkrete plan er data-only.', href:'https://www.airalo.com/da/Vietnam-esim' },
  { label:'Meget data', name:'Holafly', mode:'Fokus på unlimited-planer', fit:'Relevant hvis du bruger meget data og helst ikke vil holde øje med GB under rejsen.', watch:'“Unlimited” kan stadig have fair-use eller hotspot-begrænsninger. Læs den konkrete plan.', href:'https://esim.holafly.com/esim-vietnam/' },
  { label:'Sammenlign pris', name:'Nomad', mode:'Fast data + forskellige perioder', fit:'God som tredje prischeck, især hvis du allerede ved omtrent hvor mange GB du bruger.', watch:'Netværk og planvilkår kan variere efter produkt og dato.', href:'https://www.getnomad.app/vietnam-eSIM' },
];
---
<BaseLayout title="eSIM i Vietnam 2026 | Airalo, Holafly eller Nomad? | RejsTilVietnam.dk" description="Guide til eSIM i Vietnam for danskere: sammenlign Airalo, Holafly og Nomad, se hvor meget data du behøver og hvordan du installerer eSIM før rejsen.">
  <section class="esim-hero"><div class="container hero-grid"><div><p class="eyebrow">eSIM i Vietnam</p><h1>Internet fra du lander.</h1><p class="lead">Et eSIM er den nemmeste løsning for de fleste, hvis telefonen understøtter det. Køb hjemmefra, installer på Wi-Fi og aktiver data, når du ankommer.</p><div class="hero-actions"><a class="btn btn--primary" href="#sammenlign">Sammenlign eSIM →</a><a class="btn btn--outline" href="#saadan">Se opsætning</a></div></div><div class="phone-card"><div class="phone-top"><span>VIETNAM</span><i>5G</i></div><div class="signal">▂▄▆█</div><b>eSIM aktiv</b><p>Maps · Grab · beskeder · booking</p><small>Behold dit danske SIM til SMS, hvis telefonen understøtter dual SIM.</small></div></div></section>
<div class="container guide-cover-wrap"><GuideCover destination="Vietnam" title="eSIM og internet i Vietnam" eyebrow="Praktisk guide" /></div>

  <section class="section section--tight"><div class="container answer-grid"><div><span>7-10 dage</span><b>5-10 GB er ofte rigeligt</b><p>Maps, Grab, chat og normal browsing.</p></div><div><span>2-3 uger</span><b>10-20 GB eller unlimited</b><p>Hvis du også streamer og uploader billeder/video.</p></div><div><span>Vores råd</span><b>Køb ikke kun på “unlimited”</b><p>Tjek netværk, hotspot og fair-use først.</p></div></div></section>

  <section class="section compare-section" id="sammenlign"><div class="container"><div class="section-head"><div><p class="eyebrow">Sammenligning</p><h2>Tre steder vi ville prischecke.</h2></div><p>Priser og datapakker ændrer sig ofte. Derfor fokuserer vi på hvilken type bruger hver løsning passer til og sender dig videre til aktuelle planer.</p></div><div class="provider-grid">{providers.map((p)=><article class="provider card"><span>{p.label}</span><h3>{p.name}</h3><b class="mode">{p.mode}</b><p>{p.fit}</p><div class="watch"><b>Tjek før køb</b><small>{p.watch}</small></div><a class="btn btn--outline" href={p.href} target="_blank" rel="noopener nofollow">Se aktuelle planer ↗</a><small class="external">Eksternt link · ikke annoncelink endnu</small></article>)}</div></div></section>

  <section class="section usage-section"><div class="container"><div class="section-head"><div><p class="eyebrow">Hvor meget data?</p><h2>Vælg efter din telefonbrug.</h2></div></div><div class="usage-bars"><div><span>Maps + Grab + WhatsApp</span><b>Lavt forbrug</b><i style="--w:30%"></i></div><div><span>+ sociale medier hver dag</span><b>Mellem</b><i style="--w:58%"></i></div><div><span>+ video, hotspot, cloud upload</span><b>Højt</b><i style="--w:92%"></i></div></div></div></section>

  <section class="section setup-section" id="saadan"><div class="container setup-grid"><div><p class="eyebrow">Opsætning</p><h2>Gør det hjemme på Wi-Fi.</h2><p class="lead">Installer eSIM før afrejse, men følg udbyderens aktiveringsregel - nogle planer starter først ved netværksforbindelse, andre kan have en anden gyldighedslogik.</p></div><ol><li><b>01</b><span>Tjek at telefonen er eSIM-kompatibel og ikke operatørlåst.</span></li><li><b>02</b><span>Køb planen og installer eSIM via app eller QR-kode på stabil Wi-Fi.</span></li><li><b>03</b><span>Navngiv den “Vietnam”, så du ikke blander den sammen med dit danske SIM.</span></li><li><b>04</b><span>Ved ankomst: vælg Vietnam-eSIM til mobildata og følg instruktionen om data roaming.</span></li><li><b>05</b><span>Slå data roaming fra på dit danske SIM, hvis du vil undgå uventet roaming.</span></li></ol></div></section>

  <section class="section section--tight"><div class="container local-sim"><div><p class="eyebrow">eSIM eller lokalt SIM?</p><h2>eSIM vinder på bekvemmelighed.</h2><p>Et lokalt fysisk SIM kan stadig være attraktivt, hvis du vil have lokal tale/SMS eller finder en god officiel operatørpakke. Til en normal 1-3 ugers ferie ville vi dog vælge eSIM for at være online allerede i lufthavnen.</p></div><a class="btn btn--primary" href="/rejseguide/transport/">Næste: transport i Vietnam →</a></div></section>
</BaseLayout>

<style>
.esim-hero{padding:84px 0 64px;background:linear-gradient(135deg,#eaf4ef,#f7ebd7)}.hero-grid{display:grid;grid-template-columns:1.1fr .6fr;gap:60px;align-items:center}.esim-hero h1{font-size:clamp(3.2rem,8vw,6rem)}.esim-hero .lead{margin-top:20px}.hero-actions{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}.phone-card{max-width:320px;justify-self:center;padding:28px 24px;border:8px solid #15372d;border-radius:38px;background:#fffdf8;box-shadow:var(--shadow);min-height:390px;display:flex;flex-direction:column}.phone-top{display:flex;justify-content:space-between;font-size:.72rem;font-weight:900;color:var(--muted)}.phone-top i{font-style:normal;color:var(--green-700)}.signal{font-size:3rem;letter-spacing:.06em;color:var(--green-700);margin:auto 0 12px}.phone-card>b{font-size:1.6rem;color:var(--green-950)}.phone-card p{color:var(--muted);margin-top:6px}.phone-card small{margin-top:auto;padding-top:24px;color:#78837e}.answer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.answer-grid>div{padding:20px;border:1px solid var(--border);border-radius:18px;background:rgba(255,255,255,.75)}.answer-grid span{display:block;color:var(--coral);font-size:.75rem;text-transform:uppercase;font-weight:850}.answer-grid b{display:block;margin-top:5px}.answer-grid p{margin-top:4px;color:var(--muted);font-size:.9rem}.compare-section{background:#f5efe2}.provider-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.provider{padding:28px;display:flex;flex-direction:column}.provider>span{align-self:flex-start;padding:5px 9px;border-radius:999px;background:var(--green-100);color:var(--green-800);font-size:.72rem;font-weight:850;text-transform:uppercase}.provider h3{font-size:2rem;margin-top:12px}.provider .mode{margin-top:8px;color:var(--coral)}.provider>p{margin-top:10px;color:var(--muted)}.watch{margin:20px 0;padding:14px;border-radius:15px;background:#f7f1e7}.watch b,.watch small{display:block}.watch small{margin-top:3px;color:var(--muted)}.provider .btn{margin-top:auto}.external{display:block;margin-top:8px;color:#87908b;text-align:center;font-size:.72rem}.usage-bars{display:grid;gap:18px;max-width:820px}.usage-bars>div{display:grid;grid-template-columns:1fr auto;gap:8px 16px}.usage-bars span{font-weight:750}.usage-bars b{color:var(--muted);font-size:.85rem}.usage-bars i{grid-column:1/-1;height:12px;border-radius:999px;background:#e4e8e5;overflow:hidden;position:relative}.usage-bars i:after{content:"";position:absolute;inset:0 auto 0 0;width:var(--w);background:var(--green-700);border-radius:999px}.setup-section{background:var(--green-950);color:white}.setup-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:56px}.setup-grid h2{color:white}.setup-grid .eyebrow{color:#f0cb90}.setup-grid .lead{color:rgba(255,255,255,.72)}.setup-grid ol{list-style:none;margin:0;padding:0;display:grid;gap:10px}.setup-grid li{display:grid;grid-template-columns:46px 1fr;gap:12px;align-items:start;padding:15px;border:1px solid rgba(255,255,255,.13);border-radius:16px;background:rgba(255,255,255,.05)}.setup-grid li b{color:#f0cb90}.local-sim{padding:36px;border-radius:30px;background:var(--sand);display:flex;align-items:center;justify-content:space-between;gap:30px}.local-sim p:not(.eyebrow){margin-top:10px;color:#48554f;max-width:720px}
@media(max-width:850px){.hero-grid,.setup-grid{grid-template-columns:1fr}.phone-card{justify-self:start}.provider-grid,.answer-grid{grid-template-columns:1fr}.local-sim{align-items:flex-start;flex-direction:column}}
@media(max-width:600px){.hero-actions{flex-direction:column}.phone-card{max-width:100%}}
</style>

<style>.guide-cover-wrap{margin-top:24px;margin-bottom:22px}@media(max-width:640px){.guide-cover-wrap{margin-top:14px}}</style>
