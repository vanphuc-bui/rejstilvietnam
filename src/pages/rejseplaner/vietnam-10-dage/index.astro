---
import GuideCover from '../../../components/GuideCover.astro';
import ActiveTripCallout from '../../../components/ActiveTripCallout.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionMedia from '../../../components/SectionMedia.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import { hubVisuals } from '../../../data/hubVisuals.js';
import VietnamRouteMap from '../../../components/VietnamRouteMap.astro';

const stops = [
  { day:'Dag 1-3', place:'Hanoi', nights:'3 dage', text:'Land, få rytmen efter flyveturen og brug dagene på Old Quarter, Hoan Kiem, mad og et par historiske stop.', link:'/destinationer/hanoi/', tip:'Bo centralt - på en kort rejse er transporttid dyr.' },
  { day:'Dag 4', place:'Ninh Binh', nights:'1 dag', text:'Tag tidligt fra Hanoi. Vælg Trang An eller Tam Coc og kombiner med ét udsigtspunkt i stedet for at presse alle stop ind.', link:'/ture/ninh-binh-fra-hanoi/', tip:'En overnatning er bedre end en meget lang dagstur, hvis tempoet skal være roligt.' },
  { day:'Dag 5-8', place:'Hoi An', nights:'4 dage', text:'Fly via Hanoi/Da Nang afhængigt af ruten. Brug Hoi An som base til gammel by, cykling, mad og en halv eller hel stranddag.', link:'/destinationer/hoi-an/', tip:'Fire dage her giver rejsen den pause, som en 10-dages rute ellers mangler.' },
  { day:'Dag 9-10', place:'Ho Chi Minh City', nights:'2 dage', text:'Afslut med storby, historie og street food. Hold programmet enkelt, især hvis hjemrejsen ligger på dag 10.', link:'/destinationer/ho-chi-minh-city/', tip:'Book hotel med nem adgang til District 1, så sidste dage ikke drukner i transport.' },
];
---
<BaseLayout title="Vietnam på 10 dage | Realistisk rejseplan fra nord til syd | RejsTilVietnam.dk" description="Et realistisk forslag til 10 dage i Vietnam: Hanoi, Ninh Binh, Hoi An og Ho Chi Minh City med færre stop og mindre transportstress.">
  <section class="route-hero">
    <div class="container route-hero-grid">
      <div><p class="eyebrow">Vietnam på 10 dage</p><h1>Fire stop er nok.</h1><p class="lead">På 10 dage ville vi <strong>ikke</strong> forsøge at se hele Vietnam. Denne rute giver dig nord, central og syd uden at skifte hotel hver anden nat.</p><div class="hero-buttons"><a class="btn btn--primary" href="#rute">Se dag-for-dag →</a><a class="btn btn--outline" href="/rejseplaner/vietnam-2-uger/">Har du 14 dage?</a></div></div>
      <div class="route-summary"><span>Ruten</span><b>Hanoi</b><i>↓</i><b>Ninh Binh</b><i>↓</i><b>Hoi An</b><i>↓</i><b>Ho Chi Minh City</b></div>
    </div>
  </section>
<div class="container guide-cover-wrap"><GuideCover destination="Vietnam" title="Vietnam på 10 dage" eyebrow="Rejseplan" /></div>

  <section class="section section--tight">
    <div class="container facts"><div><span>Tempo</span><b>Mellem</b></div><div><span>Hotelskift</span><b>3</b></div><div><span>Bedst til</span><b>Første rejse</b></div><div><span>Vi springer over</span><b>Sapa + Phu Quoc</b></div></div>
  </section>

  <section class="section route-section" id="rute">
    <div class="container"><div class="section-head"><div><p class="eyebrow">Dag for dag</p><h2>En rute med plads til at opleve noget.</h2></div><p>Dagene kan flyttes efter flytider. Pointen er rækkefølgen og antallet af stop - ikke at hver aktivitet skal ligge på et bestemt klokkeslæt.</p></div>
      <div class="timeline">{stops.map((stop, i) => <article class="stop"><div class="stop-line"><span>{i+1}</span></div><div class="stop-copy"><small>{stop.day} · {stop.nights}</small><h3>{stop.place}</h3><p>{stop.text}</p><div class="tip"><b>Vores valg:</b> {stop.tip}</div><a href={stop.link}>Se guide til {stop.place} →</a></div></article>)}</div>
    </div>
  </section>
  <div class="container route-visuals">
    <SectionMedia src={hubVisuals.tours.ninhBinh.src} alt={hubVisuals.tours.ninhBinh.alt} caption="Ninh Binh giver naturkontrast uden at kræve endnu en lang indenrigsflyvning." />
    <SectionMedia src={hubVisuals.hotels.hoiAn.src} alt={hubVisuals.hotels.hoiAn.alt} caption="Hoi An er det langsommere midtpunkt i 10-dages ruten og giver plads til både gammel by og strand." />
  </div>
  <div class="container route-video"><VideoEmbed youtubeId="NgvC-Frin1Y" title="Vietnam i levende billeder" caption="Den officielle Vietnam Tourism-video giver et hurtigt visuelt indtryk af landet; brug rejseplanen her til den praktiske rækkefølge." /></div>

  <section class="section cut-section"><div class="container"><div class="cut-grid"><div><p class="eyebrow">Hvad ville vi skære væk?</p><h2>Det svære er at sige nej.</h2></div><div class="card cut-card"><b>Drop Ha Long Bay</b><p>Hvis Hoi An og Ho Chi Minh City er vigtigere. Du sparer endnu et transportled og en overnatning.</p></div><div class="card cut-card"><b>Drop Ho Chi Minh City</b><p>Hvis du hellere vil have Ha Long Bay. Så kan du holde hele turen i nord + central Vietnam og flyve hjem via Da Nang/Hanoi.</p></div></div><VietnamRouteMap route="10" compact /><p class="tool-link"><a href="/vaerktoejer/vietnam-rutekort/?rute=10">Åbn rutekortet i fuld størrelse →</a></p></div></section>

  <section class="section section--tight"><div class="container"><ActiveTripCallout /></div></section>

  <section class="section section--tight"><div class="container booking-cta"><div><p class="eyebrow">Når ruten passer</p><h2>Book i den rigtige rækkefølge.</h2><p>Internationale fly → centrale hoteller → indenrigsfly → de få ture der kræver reservation.</p></div><a class="btn btn--primary" href="/book-rejsen/">Gå til Book rejsen →</a></div></section>
</BaseLayout>

<style>
.route-hero{padding:84px 0 62px;background:linear-gradient(135deg,#eef4ef,#f4e8d2)}.route-hero-grid{display:grid;grid-template-columns:1.2fr .65fr;gap:54px;align-items:center}.route-hero h1{font-size:clamp(3.2rem,8vw,6rem)}.route-hero .lead{margin-top:20px}.hero-buttons{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}.route-summary{padding:30px;border-radius:28px;background:var(--green-950);color:white;display:flex;flex-direction:column;gap:8px;box-shadow:var(--shadow)}.route-summary>span{color:#f0cc91;font-size:.75rem;font-weight:850;text-transform:uppercase;letter-spacing:.1em}.route-summary b{font-size:1.25rem}.route-summary i{color:#f0cc91;font-style:normal}.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.facts>div{padding:18px;border:1px solid var(--border);border-radius:18px;background:rgba(255,255,255,.7)}.facts span{display:block;color:var(--muted);font-size:.76rem;text-transform:uppercase;font-weight:800}.facts b{display:block;margin-top:4px}.route-section{background:#f5efe2}.timeline{max-width:880px;margin:0 auto;display:grid;gap:0}.stop{display:grid;grid-template-columns:72px 1fr;gap:18px}.stop-line{position:relative;display:flex;justify-content:center}.stop-line:after{content:"";position:absolute;top:44px;bottom:-8px;width:2px;background:rgba(28,106,77,.2)}.stop:last-child .stop-line:after{display:none}.stop-line span{width:42px;height:42px;display:grid;place-items:center;border-radius:50%;background:var(--green-950);color:white;font-weight:900;z-index:1}.stop-copy{padding:0 0 42px}.stop-copy small{color:var(--coral);font-weight:850;text-transform:uppercase;letter-spacing:.08em}.stop-copy h3{font-size:2rem;margin-top:5px}.stop-copy>p{margin-top:10px;color:#44514b}.tip{margin-top:14px;padding:14px 16px;border-radius:14px;background:#fffdf8;border:1px solid var(--border);color:#48554f}.stop-copy>a{display:inline-block;margin-top:14px;color:var(--green-700);font-weight:850}.cut-grid{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:20px;align-items:stretch}.cut-card{padding:26px}.cut-card b{font-size:1.2rem;color:var(--green-950)}.cut-card p{margin-top:8px;color:var(--muted)}.booking-cta{padding:36px;border-radius:30px;background:var(--sand);display:flex;align-items:center;justify-content:space-between;gap:30px}.booking-cta p:not(.eyebrow){margin-top:10px;color:#48554f}
@media(max-width:800px){.route-hero-grid,.cut-grid{grid-template-columns:1fr}.facts{grid-template-columns:repeat(2,1fr)}.booking-cta{align-items:flex-start;flex-direction:column}}
@media(max-width:520px){.facts{grid-template-columns:1fr}.stop{grid-template-columns:48px 1fr}.hero-buttons{flex-direction:column}}
.route-visuals{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:28px}.route-visuals :global(.section-media){margin:0}.route-video{margin-top:28px}@media(max-width:720px){.route-visuals{grid-template-columns:1fr}}
.tool-link{text-align:center;margin-top:-8px}.tool-link a{color:var(--green-700);font-weight:850}
</style>

<style>.guide-cover-wrap{margin-top:24px;margin-bottom:22px}@media(max-width:640px){.guide-cover-wrap{margin-top:14px}}</style>
