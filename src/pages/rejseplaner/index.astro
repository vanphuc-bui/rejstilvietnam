---
import BaseLayout from '../../layouts/BaseLayout.astro';

const plans = [
  { days:'10 dage', route:'Hanoi → Ninh Binh → Hoi An → Ho Chi Minh City', text:'Fire stop er nok. En fokuseret rute til dig der vil opleve nord, central og syd uden at skifte hotel hele tiden.', href:'/rejseplaner/vietnam-10-dage/' },
  { days:'14 dage', route:'Hanoi → Ninh Binh → Ha Long Bay → Hoi An → Ho Chi Minh City', text:'Den rute vi ville vælge første gang, hvis du gerne vil have både nord, midt og syd med.', href:'/rejseplaner/vietnam-2-uger/' },
  { days:'3 uger', route:'Hanoi → Ninh Binh → Ha Long → Hoi An → Saigon → Mekong → Phu Quoc', text:'Tre uger giver plads til både oplevelser og fem rolige stranddage til sidst.', href:'/rejseplaner/vietnam-3-uger/' },
];
---
<BaseLayout title="Vietnam rejseplaner - 10 dage, 2 uger og 3 uger | RejsTilVietnam.dk" description="Konkrete Vietnam-ruter for 10 dage, 2 uger og 3 uger med realistisk transport, færre hotelskift og plads til at opleve stederne.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Rejseplaner</p>
      <h1>Hvor meget kan du nå uden at skynde dig?</h1>
      <p class="lead">Vi bygger ruter efter reel transporttid og antal hotelskift - ikke efter hvor mange steder der kan stå på en liste.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container grid grid--3">
      {plans.map((plan, i) => (
        <a class={`card plan ${i === 1 ? 'plan--featured' : ''}`} href={plan.href}>
          <div class="plan-image plan-image--graphic"><span>{plan.days}</span><small>Rejseplan</small></div>
          <div class="plan-copy">
            <span>{plan.days}</span>
            <h3>{plan.route}</h3>
            <p>{plan.text}</p>
            <b>Se hele planen →</b>
          </div>
        </a>
      ))}
    </div>
  </section>
  <section class="section section--tight">
    <div class="container notice"><strong>Hvis det er første gang:</strong> Start med 14-dages planen. Gå ned til 10 dage ved at fjerne et stop - eller op til 3 uger ved at tilføje mere ro, ikke bare flere byer.</div>
  </section>
</BaseLayout>
<style>
.plan{overflow:hidden;transition:transform .2s ease,border-color .2s ease}.plan:hover{transform:translateY(-3px);border-color:rgba(28,106,77,.25)}.plan-image{aspect-ratio:16/10;overflow:hidden;background:#e9eee9}.plan-image--graphic{display:grid;place-items:center;align-content:center;gap:8px;background:linear-gradient(145deg,#173d31,#2f6c55);color:#fff}.plan-image--graphic span{font-size:2rem;font-weight:900}.plan-image--graphic small{font-weight:800;letter-spacing:.1em;text-transform:uppercase;opacity:.75}.plan-copy{padding:26px}.plan-copy>span{font-size:.78rem;font-weight:900;text-transform:uppercase;letter-spacing:.1em;color:var(--coral)}.plan h3{margin:10px 0;font-size:1.45rem}.plan p{color:var(--muted)}.plan b{display:inline-block;margin-top:20px;color:var(--green-700)}.plan--featured{box-shadow:var(--shadow)}
</style>
