---
import BaseLayout from '../../layouts/BaseLayout.astro';

const plans = [
  { days:'10 dage', route:'Hanoi → Ninh Binh → Hoi An → Ho Chi Minh City', text:'Til dig der vil se meget, men stadig have tid til at opleve hvert stop.', href:'' },
  { days:'14 dage', route:'Hanoi → Ninh Binh → Ha Long Bay → Hoi An → Ho Chi Minh City', text:'Vores foretrukne balance til en første rejse gennem Vietnam.', href:'/rejseplaner/vietnam-2-uger/' },
  { days:'3 uger', route:'Nord → Central → Syd + strand', text:'Mere luft i planen og mulighed for Sapa, Hue, Mekong eller Phu Quoc.', href:'' },
];
---
<BaseLayout title="Vietnam rejseplaner – 10 dage, 2 uger og 3 uger | RejsTilVietnam.dk" description="Forslag til Vietnam rejseplaner for 10 dage, 2 uger og 3 uger, lavet til danske rejsende.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Rejseplaner</p>
      <h1>Se mere. Skynd dig mindre.</h1>
      <p class="lead">En god Vietnam-rute handler lige så meget om, hvad du springer over, som hvad du tager med.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container grid grid--3">
      {plans.map((plan) => (
        <article class={`card plan ${!plan.href ? 'plan--soon' : ''}`}>
          <span>{plan.days}</span>
          <h3>{plan.route}</h3>
          <p>{plan.text}</p>
          {plan.href ? <a href={plan.href}>Se hele planen →</a> : <small>Detaljeret plan kommer snart</small>}
        </article>
      ))}
    </div>
  </section>
  <section class="section section--tight">
    <div class="container notice"><strong>Start med 14 dage?</strong> Det er den første rute, vi har bygget helt ud, fordi den passer godt til en klassisk førstegangsrejse og giver naturlige steder til både destination- og tour-guides.</div>
  </section>
</BaseLayout>
<style>
.plan{padding:28px}.plan>span{font-size:.78rem;font-weight:900;text-transform:uppercase;letter-spacing:.1em;color:var(--coral)}.plan h3{margin:10px 0;font-size:1.45rem}.plan p{color:var(--muted)}.plan a{display:inline-block;margin-top:20px;font-weight:800;color:var(--green-700)}.plan small{display:inline-block;margin-top:20px;color:#87908b;font-weight:700}.plan--soon{background:rgba(255,255,255,.5)}
</style>
