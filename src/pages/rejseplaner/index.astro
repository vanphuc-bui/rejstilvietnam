---
import BaseLayout from '../../layouts/BaseLayout.astro';

const plans = [
  { days:'10 dage', route:'Hanoi → Ninh Binh → Hoi An → Ho Chi Minh City', text:'På 10 dage ville vi skære Ha Long Bay eller Sydvietnam fra i stedet for at presse alt ind.', href:'' },
  { days:'14 dage', route:'Hanoi → Ninh Binh → Ha Long Bay → Hoi An → Ho Chi Minh City', text:'Den rute vi ville vælge første gang, hvis du gerne vil have både nord, midt og syd med.', href:'/rejseplaner/vietnam-2-uger/' },
  { days:'3 uger', route:'Nord → Central → Syd + evt. strand', text:'Her er der bedre plads til en ekstra overnatning i Ninh Binh, Hue, Mekong eller Phu Quoc.', href:'' },
];
---
<BaseLayout title="Vietnam rejseplaner - 10 dage, 2 uger og 3 uger | RejsTilVietnam.dk" description="Forslag til Vietnam-ruter for 10 dage, 2 uger og 3 uger med fokus på realistisk transport og færre hotelskift.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Rejseplaner</p>
      <h1>Hvor meget kan du nå uden at skynde dig?</h1>
      <p class="lead">Vi bygger ruter efter reel transporttid og antal hotelskift - ikke efter hvor mange steder der kan stå på en liste.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container grid grid--3">
      {plans.map((plan) => (
        <article class={`card plan ${!plan.href ? 'plan--soon' : ''}`}>
          <span>{plan.days}</span>
          <h3>{plan.route}</h3>
          <p>{plan.text}</p>
          {plan.href ? <a href={plan.href}>Se hele planen →</a> : <small>Detaljeret plan kommer senere</small>}
        </article>
      ))}
    </div>
  </section>
  <section class="section section--tight">
    <div class="container notice"><strong>Hvis det er første gang:</strong> Start med 14-dages planen. Selv hvis du ender med en anden rute, er den et godt udgangspunkt for at se, hvor meget tid transport mellem nord, midt og syd faktisk tager.</div>
  </section>
</BaseLayout>
<style>
.plan{padding:28px}.plan>span{font-size:.78rem;font-weight:900;text-transform:uppercase;letter-spacing:.1em;color:var(--coral)}.plan h3{margin:10px 0;font-size:1.45rem}.plan p{color:var(--muted)}.plan a{display:inline-block;margin-top:20px;font-weight:800;color:var(--green-700)}.plan small{display:inline-block;margin-top:20px;color:#87908b;font-weight:700}.plan--soon{background:rgba(255,255,255,.5)}
</style>
