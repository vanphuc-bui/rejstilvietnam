---
import BaseLayout from '../../layouts/BaseLayout.astro';
const plans = [
  ['10 dage','Hanoi → Ninh Binh → Hoi An → Ho Chi Minh City','Til dig der vil se meget, men stadig have tid til at opleve hvert stop.'],
  ['14 dage','Hanoi → Ha Long → Ninh Binh → Hoi An → Ho Chi Minh City','Vores foretrukne balance til en første rejse gennem Vietnam.'],
  ['3 uger','Nord → Central → Syd + strand','Mere luft i planen og mulighed for Sapa, Hue, Mekong eller Phu Quoc.'],
];
---
<BaseLayout title="Vietnam rejseplaner – 10 dage, 2 uger og 3 uger | RejsTilVietnam.dk" description="Forslag til Vietnam rejseplaner for 10 dage, 2 uger og 3 uger, lavet til danske rejsende.">
<section class="page-hero"><div class="container"><p class="eyebrow">Rejseplaner</p><h1>Se mere. Skynd dig mindre.</h1><p class="lead">En god Vietnam-rute handler lige så meget om, hvad du springer over, som hvad du tager med.</p></div></section>
<section class="section section--tight"><div class="container grid grid--3">{plans.map(([days,route,text]) => <article class="card plan"><span>{days}</span><h3>{route}</h3><p>{text}</p><a href="/rejseguide/">Planen kommer snart →</a></article>)}</div></section>
</BaseLayout>
<style>.plan{padding:28px}.plan>span{font-size:.78rem;font-weight:900;text-transform:uppercase;letter-spacing:.1em;color:var(--coral)}.plan h3{margin:10px 0;font-size:1.45rem}.plan p{color:var(--muted)}.plan a{display:inline-block;margin-top:20px;font-weight:800;color:var(--green-700)}</style>
