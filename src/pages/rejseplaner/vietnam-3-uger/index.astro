---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const stops = [
  { day:'Dag 1-3', place:'Hanoi', text:'Land roligt, udforsk Old Quarter, Hoan Kiem og et par historiske stop.', link:'/destinationer/hanoi/' },
  { day:'Dag 4-5', place:'Ninh Binh', text:'To dage giver plads til bådtur, udsigtspunkt og en aften uden at skulle tilbage til Hanoi samme dag.', link:'/ture/ninh-binh-fra-hanoi/' },
  { day:'Dag 6-7', place:'Ha Long Bay', text:'Én nat på båd er nok for de fleste. Vælg cruise efter rute og nyere anmeldelser - ikke kun billederne.', link:'/ture/halong-bay-cruise/' },
  { day:'Dag 8-11', place:'Hoi An', text:'Fire dage giver god balance mellem gammel by, mad, cykling og strand.', link:'/destinationer/hoi-an/' },
  { day:'Dag 12-14', place:'Ho Chi Minh City', text:'Brug byen som base til historie, mad og moderne storbyliv.', link:'/destinationer/ho-chi-minh-city/' },
  { day:'Dag 15-16', place:'Mekongdeltaet', text:'En overnatning gør oplevelsen mere rolig end en meget lang dagstur fra byen.', link:'/destinationer/ho-chi-minh-city/' },
  { day:'Dag 17-21', place:'Phu Quoc', text:'Slut med fem dage ved stranden, så rejsen ikke føles som tre uger med konstant transport.', link:'/destinationer/phu-quoc/' },
];
---
<BaseLayout title="Vietnam på 3 uger | 21-dages rejseplan med strand | RejsTilVietnam.dk" description="Forslag til 3 uger i Vietnam: Hanoi, Ninh Binh, Ha Long Bay, Hoi An, Ho Chi Minh City, Mekong og Phu Quoc i et roligt tempo.">
  <section class="hero-3w"><div class="container hero-grid"><div><p class="eyebrow">Vietnam på 3 uger</p><h1>Nu er der plads til både oplevelser og pauser.</h1><p class="lead">Tre uger er nok til nord, central og syd - hvis du stadig holder igen med antallet af stop.</p><div class="actions"><a class="btn btn--primary" href="#rute">Se 21-dages ruten →</a><a class="btn btn--outline" href="/rejseplaner/vietnam-2-uger/">Sammenlign med 14 dage</a></div></div><div class="route-card"><span>21 dage</span><b>Hanoi</b><i>→</i><b>Ninh Binh</b><i>→</i><b>Ha Long</b><i>→</i><b>Hoi An</b><i>→</i><b>Ho Chi Minh City</b><i>→</i><b>Mekong</b><i>→</i><b>Phu Quoc</b></div></div></section>

  <section class="section section--tight"><div class="container facts"><div><span>Tempo</span><b>Roligt til mellem</b></div><div><span>Store regioner</span><b>Nord · Central · Syd</b></div><div><span>Strand</span><b>5 dage</b></div><div><span>Bedst til</span><b>Første længere rejse</b></div></div></section>

  <section class="section route-section" id="rute"><div class="container"><div class="section-head"><div><p class="eyebrow">Ruten</p><h2>21 dage uden at jagte en checkliste.</h2></div><p>Flyt gerne én eller to dage mellem stop. Strukturen er vigtigere end den præcise kalender.</p></div><div class="route-grid">{stops.map((stop, i) => <article class="stop-card"><div class="num">0{i+1}</div><small>{stop.day}</small><h3>{stop.place}</h3><p>{stop.text}</p><a href={stop.link}>Se guide →</a></article>)}</div></div></section>

  <section class="section swap-section"><div class="container"><div class="section-head"><div><p class="eyebrow">Tilpas ruten</p><h2>Byt efter det, du faktisk glæder dig til.</h2></div></div><div class="grid grid--3"><div class="card swap"><span>⛰️</span><h3>Vil du hellere have bjerge?</h3><p>Byt Phu Quoc eller to Hoi An-dage ud med Sapa. Gør det kun, hvis trekking og bjerglandskab er en hovedgrund til rejsen.</p></div><div class="card swap"><span>🏖️</span><h3>Vil du have mere strand?</h3><p>Behold Phu Quoc og skær Mekong væk. Det giver 6-7 rolige dage til sidst.</p></div><div class="card swap"><span>🚆</span><h3>Vil du have mindre fly?</h3><p>Overvej Hue mellem nord og Hoi An, men pas på at du ikke bare tilføjer endnu et hotelskift.</p></div></div></div></section>

  <section class="section section--tight"><div class="container end-cta"><div><p class="eyebrow">Planlæg næste lag</p><h2>Har du ruten? Så kommer bookingen.</h2><p>Book de dyreste og mest tidskritiske led først. Resten kan være fleksibelt.</p></div><a class="btn btn--primary" href="/book-rejsen/">Gå til Book rejsen →</a></div></section>
</BaseLayout>

<style>
.hero-3w{padding:84px 0 62px;background:linear-gradient(135deg,#edf3ed,#f7ead4)}.hero-grid{display:grid;grid-template-columns:1.1fr .75fr;gap:50px;align-items:center}.hero-3w h1{font-size:clamp(3rem,7vw,5.6rem)}.hero-3w .lead{margin-top:20px}.actions{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}.route-card{padding:28px;border-radius:28px;background:var(--green-950);color:white;display:flex;flex-wrap:wrap;gap:8px;align-items:center;box-shadow:var(--shadow)}.route-card>span{width:100%;color:#f0cb90;font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;font-weight:850;margin-bottom:4px}.route-card b{font-size:1.05rem}.route-card i{font-style:normal;color:#f0cb90}.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.facts>div{padding:18px;border:1px solid var(--border);border-radius:18px;background:rgba(255,255,255,.7)}.facts span{display:block;color:var(--muted);font-size:.76rem;text-transform:uppercase;font-weight:800}.facts b{display:block;margin-top:4px}.route-section{background:#f5efe2}.route-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.stop-card{position:relative;padding:28px;background:#fffdf8;border:1px solid var(--border);border-radius:24px}.num{position:absolute;right:22px;top:20px;font:700 1.2rem Georgia,serif;color:#d6a85f}.stop-card small{color:var(--coral);font-weight:850;text-transform:uppercase;letter-spacing:.08em}.stop-card h3{font-size:1.8rem;margin-top:6px}.stop-card p{margin-top:9px;color:var(--muted)}.stop-card a{display:inline-block;margin-top:16px;color:var(--green-700);font-weight:850}.swap-section{background:rgba(255,255,255,.32)}.swap{padding:26px}.swap>span{font-size:1.8rem}.swap h3{margin-top:12px}.swap p{margin-top:9px;color:var(--muted)}.end-cta{padding:36px;border-radius:30px;background:var(--sand);display:flex;align-items:center;justify-content:space-between;gap:30px}.end-cta p:not(.eyebrow){margin-top:10px;color:#48554f}
@media(max-width:800px){.hero-grid{grid-template-columns:1fr}.facts{grid-template-columns:repeat(2,1fr)}.end-cta{align-items:flex-start;flex-direction:column}}
@media(max-width:640px){.route-grid,.facts{grid-template-columns:1fr}.actions{flex-direction:column}}
</style>
