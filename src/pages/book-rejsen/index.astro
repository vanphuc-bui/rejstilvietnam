---
import GuideCover from '../../components/GuideCover.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const bookingOptions = [
  { icon:'🏨', title:'Hoteller', text:'Start med området - derefter hotellet. Se hotelguides efter destination.', href:'/bedste-hoteller/' },
  { icon:'🛶', title:'Ture & oplevelser', text:'Sammenlign ture, cruises og dagsture, hvor det giver mening at booke på forhånd.', href:'/ture/' },
  { icon:'✈️', title:'Fly', text:'Internationale og indenrigsfly bliver samlet her med fokus på realistiske forbindelser og bagageregler.', href:'' },
  { icon:'📱', title:'eSIM & internet', text:'Sammenlign Airalo, Holafly og Nomad og vælg efter dataforbrug - ikke bare ordet unlimited.', href:'/rejseguide/esim-vietnam/' },
  { icon:'🛡️', title:'Rejseforsikring', text:'Vi tilføjer en uafhængig guide til, hvad du bør kontrollere før du vælger forsikring.', href:'' },
  { icon:'🧳', title:'Pakkerejser', text:'Sammenlign skræddersyet privat rejse, aktiv rejse og grupperejse med dansk rejseleder.', href:'/book-rejsen/pakkerejser/' },
];
---
<BaseLayout title="Book din rejse til Vietnam | Hoteller, eSIM, ture og pakkerejser | RejsTilVietnam.dk" description="Saml booking til Vietnam ét sted: hotelguides, ture, eSIM, fly, rejseforsikring og sammenligning af pakkerejser med tydelig markering af annoncelinks.">
  <section class="page-hero booking-hero">
    <div class="container">
      <p class="eyebrow">Book rejsen</p>
      <h1>Når ruten er på plads, kan du begynde at booke.</h1>
      <p class="lead">Vi samler de dele af Vietnam-rejsen, hvor det kan betale sig at sammenligne mulighederne. Du bestemmer selv, om du vil booke separat eller få en rejse planlagt for dig.</p>
    </div>
  </section>
<div class="container guide-cover-wrap"><GuideCover destination="Vietnam" title="Book rejsen" eyebrow="Planlægning" /></div>

  <section class="section section--tight">
    <div class="container grid grid--3">
      {bookingOptions.map((item) => (
        item.href ? (
          <a class="card booking-card" href={item.href}>
            <span class="booking-icon">{item.icon}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <b>Se guide →</b>
          </a>
        ) : (
          <article class="card booking-card booking-card--soon">
            <span class="booking-icon">{item.icon}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <small>Guide kommer senere</small>
          </article>
        )
      ))}
    </div>
  </section>

  <section class="section package-section">
    <div class="container package-grid">
      <div>
        <p class="eyebrow">Pakkerejser</p>
        <h2>Vil du helst have andre til at planlægge rejsen?</h2>
        <p class="lead">Vi har nu lavet en enkel sammenligning af tre forskellige modeller: privat skræddersyet rejse, aktiv rejse og klassisk grupperejse med dansk rejseleder.</p>
        <p class="muted">Det gør det lettere at vælge rejsetype før du begynder at sammenligne priser.</p>
      </div>
      <aside class="card package-card">
        <span>Ny guide</span>
        <h3>Pakkerejser til Vietnam</h3>
        <p>Vietnam Rejser · Topas · Stjernegaard - sammenlignet efter rejseform, ikke reklameplacering.</p>
        <a href="/book-rejsen/pakkerejser/">Se sammenligningen →</a>
      </aside>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container notice"><strong>God rækkefølge:</strong> Vælg først rejsetid og rute. Book derefter de vigtigste fly og hoteller. Til sidst kan du tilføje ture og aktiviteter, så du undgår at låse hele ferien for tidligt.</div>
  </section>
</BaseLayout>

<style>
.booking-hero{background:linear-gradient(180deg,#f7f0e3 0%,rgba(247,240,227,.25) 100%)}
.booking-card{padding:28px;display:flex;flex-direction:column;min-height:280px;transition:transform .2s ease,border-color .2s ease}
a.booking-card:hover{transform:translateY(-3px);border-color:rgba(28,106,77,.25)}
.booking-icon{font-size:2rem;margin-bottom:18px}.booking-card h3{font-size:1.55rem}.booking-card p{margin-top:10px;color:var(--muted)}.booking-card b,.booking-card small{margin-top:auto;padding-top:24px}.booking-card b{color:var(--green-700)}.booking-card small{color:#87908b;font-weight:700}.booking-card--soon{background:rgba(255,255,255,.45)}
.package-section{background:#f5efe2}.package-grid{display:grid;grid-template-columns:1.35fr .75fr;gap:36px;align-items:center}.package-grid .lead{margin-top:18px}.muted{margin-top:16px;color:var(--muted)}.package-card{padding:30px;background:var(--green-950);color:white}.package-card>span{color:#f0c986;font-size:.76rem;font-weight:850;text-transform:uppercase;letter-spacing:.1em}.package-card h3{color:white;margin-top:8px;font-size:1.75rem}.package-card p{margin-top:12px;color:rgba(255,255,255,.72)}.package-card a{display:inline-block;margin-top:22px;font-weight:800;color:#f4d59a}
@media(max-width:800px){.package-grid{grid-template-columns:1fr}}
</style>

<style>.guide-cover-wrap{margin-top:24px;margin-bottom:22px}@media(max-width:640px){.guide-cover-wrap{margin-top:14px}}</style>
