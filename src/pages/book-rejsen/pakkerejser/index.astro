---
import GuideCover from '../../../components/GuideCover.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const agencies = [
  { label:'Skræddersyet & privat', name:'Vietnam Rejser', best:'Dig der vil rejse privat med egen chauffør/guide og have ruten tilpasset.', model:'Individuel / skræddersyet', note:'De fleste rejser kan ændres efter ønsker, tempo og budget. Internationale fly prissættes separat på flere pakkeforslag.', href:'https://vietnam-rejser.dk/individuelle-rejser/' },
  { label:'Aktiv & individuel', name:'Topas', best:'Dig der prioriterer natur, aktivitet og rejseforslag med en tydelig rejseprofil.', model:'Individuelle rejser + aktive ture', note:'Topas har Vietnam-rejseforslag med fokus på natur, cykling, trekking og oplevelser uden for klassiske storbyruter.', href:'https://www.topas.dk/vietnam/' },
  { label:'Gruppe & dansk rejseleder', name:'Stjernegaard Rejser', best:'Dig der gerne vil have faste afrejsedatoer, dansk rejseleder og en klassisk grupperejse.', model:'Grupperejser + individuelle rejser', note:'Stjernegaard tilbyder bl.a. Vietnam-rundrejser med dansk rejseleder og faste afrejsedatoer.', href:'https://www.stjernegaard-rejser.dk/vietnam/rundrejser-vietnam/' },
];
---
<BaseLayout title="Pakkerejser til Vietnam | Sammenlign 3 typer rejsebureau | RejsTilVietnam.dk" description="Sammenlign pakkerejser og rejsebureauer til Vietnam: skræddersyet privat rejse, aktiv rejse eller grupperejse med dansk rejseleder.">
  <section class="package-hero"><div class="container hero-grid"><div><p class="eyebrow">Pakkerejser til Vietnam</p><h1>Vælg rejsetype før rejsebureau.</h1><p class="lead">Det vigtigste er ikke, hvilket logo du kender. Det er om du vil rejse <strong>privat, aktivt eller i gruppe</strong>.</p><div class="hero-actions"><a class="btn btn--primary" href="#sammenlign">Sammenlign muligheder →</a><a class="btn btn--outline" href="/rejseplaner/">Se vores rejseplaner først</a></div></div><div class="choice-box"><span>3 spørgsmål</span><b>Vil du rejse privat?</b><b>Vil du have dansk rejseleder?</b><b>Vil du selv bestemme tempoet?</b></div></div></section>
<div class="container guide-cover-wrap"><GuideCover destination="Vietnam" title="Pakkerejser til Vietnam" eyebrow="Booking" /></div>

  <section class="section section--tight"><div class="container type-grid"><div><span>🙋</span><b>Privat</b><p>Du og dit eget selskab. Mere fleksibilitet.</p></div><div><span>🥾</span><b>Aktiv</b><p>Natur, cykling, trekking og tydeligt tema.</p></div><div><span>🚌</span><b>Gruppe</b><p>Fast program og ofte dansk rejseleder.</p></div></div></section>

  <section class="section compare-section" id="sammenlign"><div class="container"><div class="section-head"><div><p class="eyebrow">Tre forskellige modeller</p><h2>De løser ikke det samme problem.</h2></div><p>Vi viser dem side om side, fordi “bedst” afhænger af, hvordan du helst vil rejse.</p></div><div class="agency-list">{agencies.map((a,i)=><article class="agency"><div class="agency-num">0{i+1}</div><div class="agency-copy"><span>{a.label}</span><h3>{a.name}</h3><p class="best"><b>Bedst til:</b> {a.best}</p><div class="agency-facts"><div><small>Model</small><b>{a.model}</b></div><div><small>Vores vurdering</small><p>{a.note}</p></div></div></div><div class="agency-action"><a class="btn btn--outline" href={a.href} target="_blank" rel="noopener nofollow">Besøg bureau ↗</a><small>Eksternt link · ikke annoncelink endnu</small></div></article>)}</div></div></section>

  <section class="section decision-section"><div class="container"><div class="section-head"><div><p class="eyebrow">Hurtigt valg</p><h2>Hvad ville vi vælge hvornår?</h2></div></div><div class="grid grid--3"><div class="card decision"><span>01</span><h3>“Planlæg det for os”</h3><p>Start med et <b>skræddersyet privat tilbud</b>, hvis I er familie, par eller venner og gerne vil bestemme tempo og hotelniveau selv.</p></div><div class="card decision"><span>02</span><h3>“Vi vil have guide og gruppe”</h3><p>Se på <b>grupperejser med dansk rejseleder</b>, hvis tryghed, faste afgange og social rejseform betyder mest.</p></div><div class="card decision"><span>03</span><h3>“Vi vil opleve mere aktivt”</h3><p>Se efter en <b>aktiv rejseprofil</b>, hvis trekking, cykling og natur er vigtigere end klassisk sightseeing.</p></div></div></div></section>

  <section class="section checklist-section"><div class="container check-grid"><div><p class="eyebrow">Før du accepterer et tilbud</p><h2>Sammenlign det, der faktisk er inkluderet.</h2></div><div class="check-list"><span>✓ Internationale fly eller ej?</span><span>✓ Indenrigsfly og bagage?</span><span>✓ Private eller fælles transfers?</span><span>✓ Hvilket hotelniveau?</span><span>✓ Hvor mange måltider?</span><span>✓ Dansk eller lokal guide?</span><span>✓ Afbestilling og ændringer?</span><span>✓ Rejsegaranti / pakkerejsedækning?</span></div></div></section>

  <section class="section section--tight"><div class="container independent"><div><p class="eyebrow">Om sammenligningen</p><h2>Ingen betaler for placeringen her.</h2><p>Vi har endnu ikke aktive affiliateaftaler med bureauerne på denne side. Hvis det ændrer sig, markerer vi partnerlinks tydeligt som annoncelinks.</p></div><a class="btn btn--primary" href="/om/#affiliate">Sådan arbejder vi med affiliate →</a></div></section>
</BaseLayout>

<style>
.package-hero{padding:84px 0 62px;background:linear-gradient(135deg,#eef4ef,#f4ead8)}.hero-grid{display:grid;grid-template-columns:1.1fr .7fr;gap:52px;align-items:center}.package-hero h1{font-size:clamp(3rem,7vw,5.7rem)}.package-hero .lead{margin-top:20px}.hero-actions{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}.choice-box{padding:30px;border-radius:28px;background:var(--green-950);color:white;display:grid;gap:12px}.choice-box>span{color:#f2ce92;font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;font-weight:850}.choice-box b{padding:11px 0;border-bottom:1px solid rgba(255,255,255,.12)}.choice-box b:last-child{border:0}.type-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.type-grid>div{padding:22px;border:1px solid var(--border);border-radius:20px;background:rgba(255,255,255,.72)}.type-grid span{font-size:1.8rem}.type-grid b{display:block;margin-top:7px;font-size:1.1rem}.type-grid p{margin-top:4px;color:var(--muted)}.compare-section{background:#f5efe2}.agency-list{display:grid;gap:16px}.agency{display:grid;grid-template-columns:70px 1fr 210px;gap:22px;align-items:center;padding:28px;background:#fffdf8;border:1px solid var(--border);border-radius:26px}.agency-num{font:700 1.3rem Georgia,serif;color:var(--coral)}.agency-copy>span{font-size:.75rem;color:var(--green-700);font-weight:850;text-transform:uppercase;letter-spacing:.08em}.agency-copy h3{font-size:1.8rem;margin-top:5px}.best{margin-top:10px;color:#44514b}.agency-facts{display:grid;grid-template-columns:.65fr 1.35fr;gap:18px;margin-top:18px}.agency-facts>div{padding:14px 16px;border-radius:15px;background:var(--green-100)}.agency-facts small{display:block;color:var(--muted);font-size:.72rem;text-transform:uppercase;font-weight:800}.agency-facts b,.agency-facts p{display:block;margin-top:3px}.agency-action .btn{width:100%}.agency-action small{display:block;text-align:center;color:#87908b;margin-top:8px;font-size:.72rem}.decision{padding:26px}.decision>span{color:var(--coral);font-weight:900}.decision h3{margin-top:8px}.decision p{margin-top:9px;color:var(--muted)}.checklist-section{background:var(--green-950);color:white}.check-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:52px;align-items:start}.check-grid h2{color:white}.check-grid .eyebrow{color:#f0cb90}.check-list{display:grid;grid-template-columns:1fr 1fr;gap:12px}.check-list span{padding:14px 16px;border:1px solid rgba(255,255,255,.14);border-radius:16px;background:rgba(255,255,255,.06)}.independent{padding:36px;border-radius:30px;background:var(--sand);display:flex;align-items:center;justify-content:space-between;gap:30px}.independent p:not(.eyebrow){margin-top:10px;color:#48554f;max-width:700px}
@media(max-width:850px){.hero-grid,.check-grid{grid-template-columns:1fr}.agency{grid-template-columns:52px 1fr}.agency-action{grid-column:2;max-width:260px}.type-grid{grid-template-columns:1fr}.independent{align-items:flex-start;flex-direction:column}}
@media(max-width:600px){.agency{grid-template-columns:1fr}.agency-num{display:none}.agency-action{grid-column:auto;max-width:none}.agency-facts,.check-list{grid-template-columns:1fr}.hero-actions{flex-direction:column}}
</style>

<style>.guide-cover-wrap{margin-top:24px;margin-bottom:22px}@media(max-width:640px){.guide-cover-wrap{margin-top:14px}}</style>
