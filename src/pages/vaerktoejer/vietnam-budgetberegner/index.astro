---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const appStructuredData = {
  '@context':'https://schema.org',
  '@type':'WebApplication',
  name:"Vietnam budgetberegner i DKK og VND",
  description:"Gratis rejsebudgetberegner til Vietnam med hotel, mad, transport, oplevelser, fly, buffer og justerbar DKK/VND-kurs.",
  url:new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString(),
  applicationCategory:'TravelApplication',
  operatingSystem:'Any',
  inLanguage:'da-DK',
  isAccessibleForFree:true,
};
---
<BaseLayout
  title="Vietnam budgetberegner | DKK og VND"
  description="Beregn et realistisk Vietnam-budget i danske kroner og vietnamesiske dong. Justér hotel, mad, transport, oplevelser, fly, antal personer og valutakurs."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(appStructuredData)}></script>
  <section class="page-hero budget-hero">
    <div class="container">
      <p class="eyebrow">Gratis budgetværktøj</p>
      <h1>Hvor meget skal du budgettere til Vietnam?</h1>
      <p class="lead">Indtast dine egne tal i stedet for at stole på ét generelt “Vietnam er billigt”-budget. Resultatet vises i både DKK og VND.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container calculator-shell">
      <form class="budget-form" id="budget-form">
        <div class="form-head">
          <div>
            <p class="eyebrow">Dine antagelser</p>
            <h2>Byg budgettet post for post.</h2>
          </div>
          <button class="text-reset" id="budget-reset" type="button">Nulstil eksempel</button>
        </div>

        <div class="input-grid">
          <label>
            <span>Rejsende</span>
            <input name="people" type="number" min="1" max="12" step="1" value="2" />
          </label>
          <label>
            <span>Rejsedage</span>
            <input name="days" type="number" min="1" max="120" step="1" value="14" />
          </label>
          <label>
            <span>Hotel pr. nat / værelse</span>
            <div class="money-input"><input name="hotel" type="number" min="0" step="25" value="450" /><b>DKK</b></div>
          </label>
          <label>
            <span>Mad pr. person / dag</span>
            <div class="money-input"><input name="food" type="number" min="0" step="25" value="200" /><b>DKK</b></div>
          </label>
          <label>
            <span>Lokal transport pr. person / dag</span>
            <div class="money-input"><input name="localTransport" type="number" min="0" step="25" value="75" /><b>DKK</b></div>
          </label>
          <label>
            <span>Oplevelser pr. person / dag</span>
            <div class="money-input"><input name="activities" type="number" min="0" step="25" value="150" /><b>DKK</b></div>
          </label>
          <label>
            <span>Tog/fly mellem byer pr. person i alt</span>
            <div class="money-input"><input name="longTransport" type="number" min="0" step="100" value="1500" /><b>DKK</b></div>
          </label>
          <label>
            <span>Fly Danmark ↔ Vietnam pr. person</span>
            <div class="money-input"><input name="internationalFlights" type="number" min="0" step="250" value="6500" /><b>DKK</b></div>
          </label>
          <label>
            <span>Buffer</span>
            <div class="money-input"><input name="buffer" type="number" min="0" max="50" step="1" value="10" /><b>%</b></div>
          </label>
          <label>
            <span>Planlægningskurs</span>
            <div class="money-input"><input name="rate" type="number" min="1" step="10" value="4050" /><b>VND / DKK</b></div>
          </label>
        </div>

        <div class="rate-note">
          <strong>Kursen er kun en startværdi.</strong>
          <p>4.050 VND pr. DKK ligger tæt på markedsniveauet i begyndelsen af september 2026. Justér feltet før du bruger resultatet som rejsebudget; kort, banker og vekselsteder kan afvige.</p>
        </div>
      </form>

      <aside class="budget-result" aria-live="polite">
        <p class="eyebrow">Estimat</p>
        <div class="grand-total">
          <span>Samlet rejsebudget</span>
          <strong id="total-dkk">—</strong>
          <small id="total-vnd">—</small>
        </div>
        <div class="result-list">
          <div><span>Hotel</span><b id="hotel-total">—</b></div>
          <div><span>Mad</span><b id="food-total">—</b></div>
          <div><span>Lokal transport</span><b id="local-total">—</b></div>
          <div><span>Oplevelser</span><b id="activity-total">—</b></div>
          <div><span>Transport mellem byer</span><b id="long-total">—</b></div>
          <div><span>Internationale fly</span><b id="flight-total">—</b></div>
          <div><span>Buffer</span><b id="buffer-total">—</b></div>
        </div>
        <div class="per-day">
          <span>Ca. pr. person / dag inkl. alt</span>
          <b id="per-day-total">—</b>
        </div>
        <button class="share-budget" id="copy-budget-link" type="button">Kopiér link til dette budget</button>
        <span class="share-status" id="copy-budget-status" aria-live="polite"></span>
      </aside>
    </div>
  </section>

  <section class="section budget-context">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Brug tallet rigtigt</p><h2>Et budget er mere nyttigt, når du kan se hvad der driver det.</h2></div>
        <p>På en kortere rundrejse er internationale fly ofte den største post. På en længere rejse betyder hotelniveau og antallet af bookede ture langt mere.</p>
      </div>
      <div class="context-grid">
        <article><span>🏨</span><h3>Hotel</h3><p>Prisen varierer meget efter by, område, weekend og ferieperioder. Brug din konkrete hotelshortlist som input.</p></article>
        <article><span>🛶</span><h3>Oplevelser</h3><p>Ha Long cruise, dykning og private ture kan flytte budgettet mere end street food og korte Grab-ture.</p></article>
        <article><span>✈️</span><h3>Transport</h3><p>En rute med mange indenrigsfly bliver dyrere end en langsommere rejse med færre store hop.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container source-note">
      <div>
        <p class="eyebrow">Valutakurs</p>
        <h2>Brug en opdateret kurs før booking.</h2>
      </div>
      <p>Startværdien er afrundet fra markedsniveauet i begyndelsen af september 2026. Værktøjet henter ikke bankdata og sender ikke dine budgettal til en ekstern tjeneste.</p>
      <a class="btn btn--outline" href="https://www.xe.com/currencyconverter/" target="_blank" rel="noopener noreferrer">Tjek kurs hos XE ↗</a>
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.getElementById('budget-form');
      if (!form) return;

      const defaults = {
        people:2, days:14, hotel:450, food:200, localTransport:75,
        activities:150, longTransport:1500, internationalFlights:6500,
        buffer:10, rate:4050,
      };

      const number = (name) => {
        const field = form.elements.namedItem(name);
        return Math.max(0, Number(field?.value || 0));
      };
      const dkk = (value) => new Intl.NumberFormat('da-DK', {
        style:'currency', currency:'DKK', maximumFractionDigits:0
      }).format(value);
      const vnd = (value) => new Intl.NumberFormat('vi-VN', {
        style:'currency', currency:'VND', maximumFractionDigits:0
      }).format(value);

      const paramNames = {
        people:'personer', days:'dage', hotel:'hotel', food:'mad',
        localTransport:'lokal', activities:'oplevelser', longTransport:'transport',
        internationalFlights:'fly', buffer:'buffer', rate:'kurs',
      };

      const loadFromUrl = () => {
        const params = new URL(window.location.href).searchParams;
        Object.entries(paramNames).forEach(([name,param]) => {
          const value = params.get(param);
          const field = form.elements.namedItem(name);
          if (value !== null && field && Number.isFinite(Number(value))) field.value = value;
        });
      };

      const scenarioUrl = () => {
        const url = new URL(window.location.href);
        Object.entries(paramNames).forEach(([name,param]) => {
          const field = form.elements.namedItem(name);
          url.searchParams.set(param, String(field?.value ?? defaults[name]));
        });
        return url;
      };

      const set = (id, value) => {
        const node = document.getElementById(id);
        if (node) node.textContent = value;
      };

      const calculate = () => {
        const people = Math.max(1, number('people'));
        const days = Math.max(1, number('days'));
        const nights = Math.max(1, days - 1);
        const hotel = number('hotel') * nights;
        const food = number('food') * people * days;
        const local = number('localTransport') * people * days;
        const activities = number('activities') * people * days;
        const longTransport = number('longTransport') * people;
        const flights = number('internationalFlights') * people;
        const subtotal = hotel + food + local + activities + longTransport + flights;
        const buffer = subtotal * (number('buffer') / 100);
        const total = subtotal + buffer;
        const rate = Math.max(1, number('rate'));

        set('total-dkk', dkk(total));
        set('total-vnd', vnd(total * rate));
        set('hotel-total', dkk(hotel));
        set('food-total', dkk(food));
        set('local-total', dkk(local));
        set('activity-total', dkk(activities));
        set('long-total', dkk(longTransport));
        set('flight-total', dkk(flights));
        set('buffer-total', dkk(buffer));
        set('per-day-total', dkk(total / people / days));
      };

      loadFromUrl();
      form.addEventListener('input', calculate);
      document.getElementById('copy-budget-link')?.addEventListener('click', async () => {
        const url = scenarioUrl();
        const status = document.getElementById('copy-budget-status');
        try {
          await navigator.clipboard.writeText(url.toString());
          history.replaceState({}, '', url);
          if (status) status.textContent = 'Link kopieret.';
        } catch {
          if (status) status.textContent = 'Kopiér adressen fra browserens adresselinje.';
        }
      });

      document.getElementById('budget-reset')?.addEventListener('click', () => {
        Object.entries(defaults).forEach(([name,value]) => {
          const field = form.elements.namedItem(name);
          if (field) field.value = String(value);
        });
        calculate();
      });
      calculate();
    })();
  </script>
</BaseLayout>

<style>
.budget-hero{background:linear-gradient(145deg,#f0f5ef,#f8ead4)}
.calculator-shell{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr);gap:24px;align-items:start}
.budget-form,.budget-result{padding:28px;border:1px solid var(--border);border-radius:28px;background:#fffdf8;box-shadow:0 12px 34px rgba(16,55,41,.05)}
.form-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:22px}
.form-head h2{font-size:clamp(1.8rem,4vw,2.6rem)}
.text-reset{border:0;background:transparent;color:var(--green-700);font-weight:850;cursor:pointer;text-decoration:underline;text-underline-offset:3px}
.input-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.input-grid label{display:grid;gap:7px}
.input-grid label>span{color:#52605a;font-size:.78rem;font-weight:800}
.input-grid input{width:100%;min-height:48px;padding:0 12px;border:1px solid var(--border);border-radius:12px;background:white;color:var(--green-950);font:inherit;font-weight:750}
.money-input{display:grid;grid-template-columns:1fr auto;align-items:center;border:1px solid var(--border);border-radius:12px;background:white;overflow:hidden}
.money-input input{border:0;border-radius:0}
.money-input b{padding:0 12px;color:var(--muted);font-size:.75rem}
.rate-note{margin-top:18px;padding:16px 18px;border-radius:16px;background:var(--green-100)}
.rate-note p{margin-top:4px;color:#4b5952;font-size:.86rem}
.budget-result{position:sticky;top:92px;background:var(--green-950);color:white}
.budget-result .eyebrow{color:#f0c986}
.grand-total{display:grid;gap:4px;padding-bottom:20px;border-bottom:1px solid rgba(255,255,255,.14)}
.grand-total span{color:rgba(255,255,255,.62);font-size:.8rem}
.grand-total strong{font-size:clamp(2rem,5vw,3.2rem);line-height:1}
.grand-total small{color:#b8dec9;font-size:.92rem;font-weight:750}
.result-list{display:grid;gap:10px;padding:20px 0}
.result-list div,.per-day{display:flex;justify-content:space-between;gap:18px}
.result-list span,.per-day span{color:rgba(255,255,255,.62);font-size:.82rem}
.result-list b,.per-day b{white-space:nowrap}
.per-day{padding-top:16px;border-top:1px solid rgba(255,255,255,.14)}.share-budget{width:100%;min-height:44px;margin-top:20px;border:1px solid rgba(255,255,255,.25);border-radius:999px;background:rgba(255,255,255,.08);color:white;font:inherit;font-size:.82rem;font-weight:850;cursor:pointer}.share-budget:hover{background:rgba(255,255,255,.14)}.share-status{display:block;min-height:18px;margin-top:8px;color:#b8dec9;font-size:.76rem;text-align:center}
.budget-context{background:#f5efe2}
.context-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.context-grid article{padding:24px;border:1px solid var(--border);border-radius:22px;background:#fffdf8}
.context-grid article>span{font-size:1.6rem}
.context-grid h3{margin-top:12px}
.context-grid p{margin-top:8px;color:var(--muted)}
.source-note{display:grid;grid-template-columns:.8fr 1fr auto;gap:26px;align-items:center;padding:30px;border-radius:24px;background:var(--green-100)}
.source-note>p{color:#45534c}
@media(max-width:900px){.calculator-shell,.source-note{grid-template-columns:1fr}.budget-result{position:static}.source-note .btn{justify-self:start}.context-grid{grid-template-columns:1fr}}
@media(max-width:640px){.budget-form,.budget-result{padding:21px;border-radius:22px}.input-grid{grid-template-columns:1fr}.form-head{align-items:flex-start;flex-direction:column}.source-note{padding:24px}.source-note .btn{width:100%;text-align:center}}
</style>
