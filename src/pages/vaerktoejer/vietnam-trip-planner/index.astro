.result-insights{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:16px}.result-insights>div{padding:20px;border-radius:18px;background:#f6f0e4}.insight-label{display:block;margin-bottom:9px;color:var(--green-800);font-size:.72rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.result-insights ul{margin:0 0 13px;padding-left:18px;color:#45534c;font-size:.86rem}.result-insights p{color:#45534c;font-size:.88rem;margin-bottom:15px}.result-insights a:not(.btn){color:var(--green-700);font-weight:850;font-size:.82rem}.result-actions{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-top:18px}.result-actions .btn{width:auto}.result-actions span{color:var(--green-700);font-size:.78rem;font-weight:800}
