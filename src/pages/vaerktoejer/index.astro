---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  {
    icon:'🧭',
    title:'Vietnam Trip Planner',
    text:'Vælg 10, 14 eller 21 dage, måned, rejsetype, tempo, budget og interesser. Få en personlig rute med sæsoncheck og transport mellem stop.',
    href:'/vaerktoejer/vietnam-trip-planner/',
    cta:'Byg min rute →',
    featured:true,
  },
  {
    icon:'⇄',
    title:'Transport Matrix',
    text:'Sammenlign populære strækninger på tid, transportform, planlægningspris, komfort og besvær — fra Hanoi til Phu Quoc.',
    href:'/vaerktoejer/transport-matrix/',
    cta:'Sammenlign transport →',
    featured:true,
  },
  {
    icon:'🗺️',
    title:'Vietnam rutekort',
    text:'Sammenlign 10, 14 og 21 dage på ét skematisk kort og se, hvor mange store transporthop hver rute kræver.',
    href:'/vaerktoejer/vietnam-rutekort/',
    cta:'Se rutekort →',
  },
  {
    icon:'🧮',
    title:'Vietnam budgetberegner',
    text:'Regn hotel, mad, transport, oplevelser og fly om til både DKK og VND med en kurs, du selv kan justere.',
    href:'/vaerktoejer/vietnam-budgetberegner/',
    cta:'Beregn budget →',
  },
  {
    icon:'☀️',
    title:'Hvornår skal man rejse hvor?',
    text:'Vælg måned og sammenlign Nordvietnam, Centralvietnam, Sydvietnam og Phu Quoc på samme skærm.',
    href:'/vaerktoejer/vietnam-vejrhjaelp/',
    cta:'Åbn vejrplanlægger →',
  },
];
---
<BaseLayout
  title="Gratis Vietnam-værktøjer | Trip Planner, transport og budget"
  description="Gratis danske Vietnam-værktøjer: byg en personlig rute, sammenlign transport, se 10/14/21-dages kort, beregn budget og vælg region efter måned."
>
  <section class="page-hero tools-hero">
    <div class="container">
      <p class="eyebrow">Gratis værktøjer</p>
      <h1>Planlæg med noget, du faktisk kan bruge.</h1>
      <p class="lead">Fem gratis værktøjer til de valg, der normalt tager længst tid: personlig rute, transport, rejsetempo, budget og vejret mellem Vietnams regioner.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container tools-grid">
      {tools.map((tool) => (
        <a class:list={{'tool-card':true,'tool-card--featured':tool.featured}} href={tool.href}>
          <span class="tool-icon" aria-hidden="true">{tool.icon}</span>
          <h2>{tool.title}</h2>
          <p>{tool.text}</p>
          <b>{tool.cta}</b>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--tight">
    <div class="container methodology">
      <div>
        <p class="eyebrow">Sådan bruger vi dem</p>
        <h2>Værktøjerne er planlægningshjælp – ikke en facitliste.</h2>
      </div>
      <div>
        <p>Rutekortet er skematisk, budgetberegneren bruger dine egne tal, og vejrplanlæggeren viser sæsonmønstre frem for en konkret prognose.</p>
        <p>Det gør dem nemme at gemme, dele og vende tilbage til, når flydatoer eller rejsetempo ændrer sig.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.tools-hero{background:linear-gradient(145deg,#edf4ef,#f6ead6)}
.tools-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:18px}.tool-card{grid-column:span 2}.tool-card--featured{grid-column:span 3}
.tool-card{display:flex;flex-direction:column;min-height:320px;padding:30px;border:1px solid var(--border);border-radius:28px;background:#fffdf8;box-shadow:0 12px 34px rgba(16,55,41,.06);transition:transform .2s ease,border-color .2s ease}
.tool-card:hover{transform:translateY(-3px);border-color:rgba(28,106,77,.26)}
.tool-icon{width:58px;height:58px;display:grid;place-items:center;border-radius:18px;background:var(--green-100);font-size:1.65rem}
.tool-card h2{margin-top:22px;font-size:1.75rem}
.tool-card p{margin-top:12px;color:var(--muted)}
.tool-card b{margin-top:auto;padding-top:24px;color:var(--green-700)}
.methodology{display:grid;grid-template-columns:.9fr 1.1fr;gap:54px;padding:38px;border-radius:28px;background:var(--green-950);color:white}
.methodology h2{color:white}
.methodology>div:last-child{display:grid;gap:14px;color:rgba(255,255,255,.76);align-content:center}
@media(max-width:900px){.tools-grid{grid-template-columns:1fr}.tool-card,.tool-card--featured{grid-column:auto;min-height:0}.methodology{grid-template-columns:1fr;gap:20px}}
@media(max-width:640px){.tool-card{padding:24px;border-radius:22px}.methodology{padding:26px 22px;border-radius:22px}}
</style>
