---
import ClusterGuide from '../../../components/ClusterGuide.astro';
import { hoiAnPages } from '../../../data/hoiAnCluster.js';
import { hoChiMinhPages } from '../../../data/hoChiMinhCluster.js';
import { phuQuocPages } from '../../../data/phuQuocCluster.js';
import { daNangPages } from '../../../data/daNangCluster.js';
import { nhaTrangPages } from '../../../data/nhaTrangCluster.js';
import { huePages } from '../../../data/hueCluster.js';
import { ninhBinhPages } from '../../../data/ninhBinhCluster.js';
import { sapaPages } from '../../../data/sapaCluster.js';
import { haLongBayPages } from '../../../data/haLongBayCluster.js';
import { daLatPages } from '../../../data/daLatCluster.js';
import { enhanceMarineCluster } from '../../../data/marineActivityCluster.js';

export function getStaticPaths() {
  const clusters = {
    'hoi-an': hoiAnPages,
    'ho-chi-minh-city': hoChiMinhPages,
    'phu-quoc': enhanceMarineCluster(phuQuocPages, 'phu-quoc'),
    'da-nang': daNangPages,
    'nha-trang': enhanceMarineCluster(nhaTrangPages, 'nha-trang'),
    'hue': huePages,
    'ninh-binh': ninhBinhPages,
    'sapa': sapaPages,
    'ha-long-bay': haLongBayPages,
    'da-lat': daLatPages,
  };

  return Object.entries(clusters).flatMap(([destination, pages]) =>
    Object.entries(pages).map(([guide, page]) => ({
      params: { destination, guide },
      props: { page },
    }))
  );
}

const { page } = Astro.props;
---
<ClusterGuide page={page} />
