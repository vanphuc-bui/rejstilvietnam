  { id: 'se', label: 'Hvad skal du se?' },
  { id: 'transport', label: 'Transport fra Hanoi' },
  { id: 'plan', label: 'Forslag til dagstur' },
  { id: 'overnat', label: 'Hvornår skal du overnatte?' },
];

const sources = [
  { label: 'Vietnam Tourism - Ninh Binh', href: 'https://vietnam.travel/node/196' },
  { label: 'Vietnam Tourism - day trips from Hanoi', href: 'https://vietnam.travel/node/1170' },
