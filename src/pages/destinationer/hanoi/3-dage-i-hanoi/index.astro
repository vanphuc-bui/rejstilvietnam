import SectionMedia from '../../../../components/SectionMedia.astro';
import PracticalTable from '../../../../components/PracticalTable.astro';
import CommercialCta from '../../../../components/CommercialCta.astro';

const toc = [
  { id: 'overblik', label: 'Planen i korte træk' },
  { id: 'budget', label: 'Tid og entrébudget' },
  { id: 'dag1', label: 'Dag 1: Old Quarter' },
  { id: 'dag2', label: 'Dag 2: historie' },
  { id: 'dag3', label: 'Dag 3: vælg efter interesse' },
  { id: 'kortere', label: 'Hvis du kun har 2 dage' },
  { id: 'mere', label: 'Hvis du har 4-5 dage' },
];

const sources = [
  { label: 'Vietnam Tourism - Hanoi', href: 'https://vietnam.travel/places-to-go/northern-vietnam/ha-noi' },
  { label: 'Văn Miếu - official visitor information', href: 'https://www.vanmieu.gov.vn/en/introduction/visitor-information' },
  { label: 'Hoa Lo Prison - official tickets', href: 'https://hoalo.vn/EN/Home/Ve' },
  { label: 'Imperial Citadel - official ticket price', href: 'https://hoangthanhthanglong.vn/en/ticket-price/' },
];

const dayColumns = [
  { key: 'day', label: 'Dag' },
  { key: 'area', label: 'Fokus' },
  { key: 'paid', label: 'Typisk betalt stop' },
  { key: 'budget', label: 'Entrébudget' },
];
const dayRows = [
  { day: 'Dag 1', area: 'Old Quarter + Hoan Kiem', paid: 'Evt. Hoa Lo Prison', budget: '0-50.000 VND ≈ 0-13 DKK' },
  { day: 'Dag 2', area: 'Văn Miếu + Ba Dinh / citadel', paid: 'Văn Miếu 70k; citadel 100k hvis du vælger begge', budget: '70.000-170.000 VND ≈ 18-42 DKK' },
  { day: 'Dag 3', area: 'Train Street / West Lake / langsom bydag', paid: 'Kan holdes næsten gratis', budget: '0-variabelt' },
];
---
<ArticleLayout
  title="3 dage i Hanoi 2026 | Rejseplan dag for dag"
  description="En realistisk 3-dages Hanoi-rejseplan med områder, tidsforbrug og entrébudget i VND/DKK - uden at presse for meget ind."
  eyebrow="Hanoi · Rejseplan"
  heading="3 dage i Hanoi: en plan med plads til selve byen"
  intro="Tre dage er nok til en god første oplevelse, hvis du holder dag 1 central, samler de historiske stop på dag 2 og bruger dag 3 fleksibelt. Selve entrébudgettet kan være overraskende lavt; det er hotel, ture og transport der typisk fylder mere."
  updated="15. september 2026"
  toc={toc}
  sources={sources}
>
  <SectionMedia slot="heroMedia" src="https://commons.wikimedia.org/wiki/Special:FilePath/Old%20Quarter%20street%20scene%2C%20Hanoi%20%2812%29%20%2838441027296%29.jpg?width=1800" alt="Gadeliv i Hanois Old Quarter" caption="Første dag fungerer bedst, hvis du bliver i centrum og lader byen komme til dig." credit="Richard Mortel / Wikimedia Commons" creditUrl="https://commons.wikimedia.org/wiki/File:Old_Quarter_street_scene,_Hanoi_(12)_(38441027296).jpg" ratio="16 / 7" />

  <h2 id="overblik">Planen i korte træk</h2>
  <div class="fact-grid"><div class="fact"><span>Dag 1</span><b>Old Quarter + Hoan Kiem + mad</b></div><div class="fact"><span>Dag 2</span><b>Litteraturtemplet + historie</b></div><div class="fact"><span>Dag 3</span><b>Train Street, West Lake eller rolig bydag</b></div></div>
  <p>Planen er lavet til en førstegangsrejse, hvor du bor centralt omkring Old Quarter eller Hoan Kiem. Hvis du bor i Tay Ho, skal du regne med lidt mere transport hver dag.</p>
  <div class="callout"><strong>Ankomst om aftenen?</strong> Tæl ikke ankomstdagen som en rigtig sightseeingdag. Check ind, spis tæt på hotellet og begynd planen næste morgen.</div>

  <h2 id="budget">Tid og entrébudget for tre dage</h2>
  <PracticalTable title="Så meget behøver du faktisk at booke" intro="Vi har bevidst holdt planen fri for betalte aktiviteter hvert eneste tidsrum. Det gør den nemmere at ændre efter vejr og energi." columns={dayColumns} rows={dayRows} note="DKK-beløb er afrundet med ca. 100.000 VND = 25 DKK den 15. september 2026. Billetterne til Văn Miếu, Hoa Lo og Thang Long-citadellet er kontrolleret mod deres officielle sider." />

  <h2 id="dag1">Dag 1: Old Quarter og Hoan Kiem</h2>
  <h3>Morgen: gå før byen bliver varm</h3>
  <p>Start omkring Hoan Kiem-søen og gå derefter ind i Old Quarter. Du behøver ikke følge en fast rute gennem alle de gamle handelsgader. Vælg et område på kortet, gå langsomt og stop, når du ser et sted med morgenmad eller kaffe.</p>
  <p>Hvis du vil begynde med noget meget Hanoi-agtigt, så spis phở eller bánh cuốn til morgenmad. Se vores <a href="/destinationer/hanoi/mad-i-hanoi/">madguide til Hanoi</a> for retter og realistiske priser.</p>
  <h3>Eftermiddag: ét konkret stop</h3>
  <p>Efter frokost ville vi vælge <strong>Hoa Lo Prison</strong> frem for at køre rundt mellem flere seværdigheder. Voksenbilletten er 50.000 VND, cirka 12-13 DKK, og besøget giver dagen struktur uden at gøre den tung.</p>
  <h3>Aften: tilbage til centrum</h3>
  <p>Gå omkring søen igen og spis i eller omkring Old Quarter. Stemningen er anderledes end om morgenen, og du slipper for at bruge aftenen i en bil på tværs af byen.</p>
  <SectionMedia src="https://commons.wikimedia.org/wiki/Special:FilePath/Hoan%20Kiem%20Lake%20photo.jpg?width=1400" alt="Hoan Kiem-søen i Hanoi" caption="Hoan Kiem er et naturligt udgangspunkt både morgen og aften." credit="Tranhuutukkt / Wikimedia Commons" creditUrl="https://commons.wikimedia.org/wiki/File:Hoan_Kiem_Lake_photo.jpg" ratio="16 / 9" />

  <h2 id="dag2">Dag 2: historie vest for centrum</h2>
  <h3>Morgen: Litteraturtemplet</h3>
  <p>Tag en kort Grab eller taxi til Litteraturtemplet. Den officielle standardbillet er 70.000 VND, cirka 17-18 DKK. Det er et overskueligt sted at begynde, og formiddagen er som regel bedre end den varmeste del af dagen.</p>
  <h3>Sen formiddag: vælg Ba Dinh eller citadellet</h3>
  <p>Hvis du er interesseret i Vietnams moderne historie, fortsæt mod Ba Dinh. Hvis arkitektur og ældre historie interesserer dig mere, ville vi prioritere Imperial Citadel of Thang Long; voksenbilletten er 100.000 VND, cirka 25 DKK.</p>
  <p>Prøv ikke nødvendigvis at nå begge dele plus flere museer. Hanoi bliver mere interessant, når du har tid til at læse og kigge frem for kun at tage et billede ved indgangen.</p>
  <SectionMedia src="https://commons.wikimedia.org/wiki/Special:FilePath/Hanoi%20-%20Temple%20of%20Literature.jpg?width=1400" alt="Litteraturtemplet i Hanoi" caption="Dag to samler de historiske stop, der ligger vest for Old Quarter." credit="P. Hughes / Wikimedia Commons" creditUrl="https://commons.wikimedia.org/wiki/File:Hanoi_-_Temple_of_Literature.jpg" ratio="4 / 3" />
  <h3>Aften: street food eller et roligt måltid</h3>
  <p>Hvis du har lyst til at prøve mange små retter, er anden aften et godt tidspunkt til en street-food-rute. Hvis du allerede er mæt af indtryk, vælg i stedet ét sted med bún chả eller chả cá og gør aftenen enkel.</p>
  <CommercialCta eyebrow="Valgfrit" title="Vil du bruge en guide én gang i Hanoi?" text="Dag 2 om aftenen er et godt sted at lægge en food tour: du har allerede orienteret dig i byen, men har stadig en hel dag bagefter til at genbesøge steder på egen hånd." primaryHref="https://www.getyourguide.com/s/?q=Hanoi%20street%20food%20tour" primaryLabel="Se food tours →" provider="GetYourGuide" secondaryHref="/destinationer/hanoi/mad-i-hanoi/" secondaryLabel="Læs madguiden først" />

  <h2 id="dag3">Dag 3: vælg efter interesse</h2>
  <p>På tredjedagen ville vi ikke bruge samme plan til alle. Efter to dage ved du bedre, om du vil have mere by, mere historie eller bare en roligere dag.</p>
  <h3>Valg A: Train Street + caféer</h3><p>Train Street kan passe ind om formiddagen eller senere på dagen, men adgang og togtider ændrer sig. Læs vores <a href="/destinationer/hanoi/train-street/">aktuelle Train Street-guide</a> og tjek forholdene samme dag.</p>
  <h3>Valg B: West Lake og Tran Quoc-pagoden</h3><p>Hvis du trænger til mere luft og færre smalle gader, så tag til Tay Ho/West Lake. Det er især et godt valg, hvis du overvejer at bo der på et længere ophold.</p>
  <h3>Valg C: en langsom dag i centrum</h3><p>Det er også helt legitimt at bruge tredje dag på caféer, et ekstra museum, shopping og mad. Det giver ofte mere mening end at tilføje endnu en attraktion kun for at kunne sige, at du har været der.</p>

  <h2 id="kortere">Hvis du kun har 2 dage</h2>
  <p>Behold dag 1 næsten uændret. På dag 2 ville vi vælge Litteraturtemplet plus enten Ba Dinh eller Hoa Lo. Train Street er kun værd at presse ind, hvis det faktisk står højt på din ønskeliste.</p>

  <h2 id="mere">Hvis du har 4-5 dage</h2>
  <p>Så ville vi normalt ikke bruge alle dagene inde i Hanoi. Brug byen som base og tilføj <a href="/destinationer/hanoi/ninh-binh-fra-hanoi/">Ninh Binh</a> eller <a href="/destinationer/hanoi/ha-long-bay-fra-hanoi/">Ha Long Bay</a>. Begge giver en markant anden oplevelse end endnu en dag med storby.</p>
  <div class="link-list"><a class="link-card" href="/destinationer/hanoi/sevaerdigheder/">Seværdigheder i Hanoi <span>Vælg de steder, der passer bedst til din rejse.</span></a><a class="link-card" href="/destinationer/hanoi/hvor-skal-man-bo/">Hvor skal man bo i Hanoi? <span>Vælg område, før du vælger hotel.</span></a><a class="link-card" href="/destinationer/hanoi/bedste-hoteller/">Bedste hoteller i Hanoi <span>Vores korte shortlist til forskellige typer ophold.</span></a></div>
</ArticleLayout>
