---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import HotelMap from '../../../../components/HotelMap.astro';
import PracticalTable from '../../../../components/PracticalTable.astro';
import { editorialPeople, formatDanishEditorialDate } from '../../../../data/editorialMetadata.js';

const datePublished = '2026-09-14';
const dateModified = '2026-09-18';
const publishedLabel = formatDanishEditorialDate(datePublished);
const modifiedLabel = formatDanishEditorialDate(dateModified);

const hotels = [
  {
    tag:'Bedst samlet',
    name:'Peridot Grand Luxury Boutique Hotel',
    area:'Old Quarter',
    address:'33 Duong Thanh, Hoan Kiem, Hanoi',
    why:'God hvis du vil bo centralt uden at give afkald på pool, rooftop og en mere rolig hoteloplevelse.',
    fit:'Par · første gang · komfort',
    price:'$$$',
    query:'Peridot+Grand+Luxury+Boutique+Hotel+Hanoi',
    image:'https://content.skyscnr.com/available/2306043177/2306043177_WxH.jpg',
    imageAlt:'Rooftop ved Peridot Grand Luxury Boutique Hotel i Hanoi',
    imageSource:'Skyscanner',
    imageSourceHref:'https://www.skyscanner.ca/hotels/vietnam/hanoi-hotels/peridot-grand-luxury-boutique-hotel/ht-204266570',
    lat:21.033037,
    lng:105.846306,
  },
  {
    tag:'Boutique',
    name:'La Siesta Classic Ma May',
    area:'Old Quarter',
    address:'94 Ma May, Hoan Kiem, Hanoi',
    why:'Meget central placering og et godt valg, hvis du vil kunne gå til mad, caféer og seværdigheder.',
    fit:'Par · byliv · kort ophold',
    price:'$$$',
    query:'La+Siesta+Classic+Ma+May+Hanoi',
    image:'https://photos.hotelbeds.com/giata/original/37/372732/372732a_hb_a_010.jpg',
    imageAlt:'Indgangen til La Siesta Classic Ma May i Hanoi',
    imageSource:'Hotelbeds',
    imageSourceHref:'https://stworld.jp/area/vietnam/hotel/hanoi/21990',
    lat:21.03428,
    lng:105.85332,
  },
  {
    tag:'God værdi',
    name:'Salute Premium Hotel & Spa',
    area:'Old Quarter',
    address:'5-7 Cua Dong, Hoan Kiem, Hanoi',
    why:'Et stærkt mellemklassevalg, hvis beliggenhed og komfort betyder mere end store resortfaciliteter.',
    fit:'Par · venner · value',
    price:'$$',
    query:'Salute+Premium+Hotel+Spa+Hanoi',
    image:'https://www.hanoisalutehotel.com/files/images/banner/5O4A0377-copy.jpg',
    imageAlt:'Værelse på Salute Premium Hotel & Spa i Hanoi',
    imageSource:'Hotellets officielle side',
    imageSourceHref:'https://www.hanoisalutehotel.com/',
    lat:21.0351,
    lng:105.8475,
  },
  {
    tag:'Familie',
    name:'Hanoi Emerald Waters Hotel Valley',
    area:'Hoan Kiem',
    address:'22 Lo Su, Hoan Kiem, Hanoi',
    why:'Praktisk base med nem adgang til søen og Old Quarter. Relevant hvis I vil have central beliggenhed uden at bo midt i den mest hektiske del.',
    fit:'Familier · første gang',
    price:'$$',
    query:'Hanoi+Emerald+Waters+Hotel+Valley',
    image:'https://www.hanoiemeraldwatershotel.com/UploadFile/Hotel22/Gallery/Rooms/Suite-Double-room/2.jpg',
    imageAlt:'Suite på Hanoi Emerald Waters Hotel Valley',
    imageSource:'Hanoi Emerald Waters Hotel',
    imageSourceHref:'https://www.hanoiemeraldwatershotel.com/hotel22/rooms-rates/suites-king-double.htm',
    lat:21.031349,
    lng:105.855393,
  },
  {
    tag:'Luksus',
    name:'Capella Hanoi',
    area:'French Quarter',
    address:'11 Le Phung Hieu, Hoan Kiem, Hanoi',
    why:'Til dig der prioriterer design, service og ro højere end at bo midt i Old Quarters mest travle gader.',
    fit:'Luksus · par · special occasion',
    price:'$$$$',
    query:'Capella+Hanoi',
    image:'https://capellahotels.com/assets/img/site_images/hanoi/hanoi-home01a.jpg',
    imageAlt:'Capella Hanoi set udefra',
    imageSource:'Capella Hotels',
    imageSourceHref:'https://capellahotels.com/en/capella-hanoi',
    lat:21.02573,
    lng:105.85681,
  },
];

const priceColumns = [
  { key:'tier', label:'Niveau' },
  { key:'vnd', label:'2026-pejlemærke' },
  { key:'dkk', label:'Ca. DKK / nat' },
  { key:'expect', label:'Hvad det betyder' },
];
const priceRows = [
  { tier:'Budget privat', vnd:'400.000-700.000 VND', dkk:'100-175 DKK', expect:'Enkelt privat værelse; læs især om støj, vindue og badeværelse' },
  { tier:'Mellemklasse', vnd:'800.000-1.500.000 VND', dkk:'200-375 DKK', expect:'Det stærkeste value-segment for mange par og førstegangsrejsende' },
  { tier:'Boutique / bedre 4-stjernet', vnd:'1.500.000-3.000.000+ VND', dkk:'375-750+ DKK', expect:'Mere design, bedre service og ofte pool/rooftop' },
  { tier:'Luksus', vnd:'Meget variabelt', dkk:'Ofte klart over 750 DKK', expect:'French Quarter og high-end boutique; sammenlign din konkrete dato' },
];
---
<BaseLayout
  title="Bedste hoteller i Hanoi 2026 | 5 gode valg + kort | RejsTilVietnam.dk"
  description="5 hoteller i Hanoi til forskellige rejsetyper med område, 2026-prisniveau i VND/DKK, bookinglinks og interaktivt kort."
  pageType="article"
  headline="Bedste hoteller i Hanoi: 5 steder vi ville starte med"
  datePublished={datePublished}
  dateModified={dateModified}
  author={editorialPeople.author}
  reviewer={editorialPeople.reviewer}
  authorName={editorialPeople.author.name}
>
  <section class="hotel-hero">
    <div class="container hero-grid">
      <div>
        <a class="hub-back" href="/destinationer/hanoi/">← Hanoi rejseguide</a>
        <p class="eyebrow">Hoteller i Hanoi</p>
        <h1>Bedste hoteller i Hanoi: 5 steder vi ville starte med.</h1>
        <div class="answer"><span>Kort svar</span><p>På en første rejse ville vi booke i <strong>Old Quarter eller Hoan Kiem</strong>. Vælg derefter hotel efter støj, værelset og faciliteter - ikke kun stjerner eller dagens laveste pris.</p></div>
        <div class="article-meta"><span>Af <a href={editorialPeople.author.url}>{editorialPeople.author.name}</a></span><span>Rejsefagligt gennemgået af <a href={editorialPeople.reviewer.url}>{editorialPeople.reviewer.name}</a></span><span>Udgivet {publishedLabel}</span><span>Opdateret {modifiedLabel}</span></div>
        <div class="hero-actions"><a class="btn btn--primary" href="#hoteller">Se de 5 hoteller</a><a class="btn btn--outline" href="/destinationer/hanoi/hvor-skal-man-bo/">Vælg område først →</a></div>
      </div>
      <div class="hero-photo hero-photo--graphic"><span>🏨</span><strong>Hanoi</strong><small>Vælg område før hotel</small></div>
    </div>
  </section>

  <section class="section section--tight"><div class="container quick-grid"><div><span>Første gang</span><b>Old Quarter / Hoan Kiem</b></div><div><span>Mere ro</span><b>French Quarter</b></div><div><span>Value sweet spot</span><b>Ca. 200-375 DKK / nat</b></div><div><span>Vores regel</span><b>Placering før stjerner</b></div></div></section>

  <section class="section section--tight">
    <div class="container price-guide">
      <div class="section-head"><div><p class="eyebrow">Prisniveau</p><h2>Hvad er billigt eller dyrt i Hanoi?</h2></div><p>En pris uden dato er kun et pejlemærke. Vi bruger derfor brede 2026-bånd fra Old Quarter og viser altid aktuelle priser hos bookingudbyderen.</p></div>
      <PracticalTable title="Hotelbudget som pejlemærke" columns={priceColumns} rows={priceRows} note="Prisintervallerne er 2026-markedspejlemærker for Old Quarter. DKK er afrundet med ca. 100.000 VND = 25 DKK den 15. september 2026. Helligdage, Tết, weekender og værelsestype kan ændre priserne kraftigt." />
      <div class="method-card"><strong>Sådan vælger vi hotellerne</strong><p>Vi prioriterer placering, praktisk brug som base, rejsetype og et tydeligt formål med hvert valg. Listen er ikke en rangering efter Booking-score, og vi lover ikke, at hotel nr. 1 er bedst for alle.</p></div>
    </div>
  </section>

  <section class="section hotels-section" id="hoteller">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Shortlist</p><h2>Fem valg til fem forskellige behov.</h2></div><p>Tjek altid din konkrete dato. Knapperne går lige nu til almindelige Booking.com-søgninger og er <strong>ikke affiliate-links endnu</strong>.</p></div>
      <div class="hotel-list">
        {hotels.map((hotel, i) => (
          <article class="hotel-card">
            <div class="hotel-image-wrap"><div class="hotel-image-fallback" aria-hidden="true"><span>Hotel</span><b>{hotel.name}</b></div><img src={hotel.image} alt={hotel.imageAlt} loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none'" /><span class="hotel-rank">0{i+1}</span><a class="photo-source" href={hotel.imageSourceHref} target="_blank" rel="noopener nofollow">Foto: {hotel.imageSource} ↗</a></div>
            <div class="hotel-main"><div class="hotel-meta"><span>{hotel.tag}</span><small>{hotel.area}</small></div><h3>{hotel.name}</h3><p>{hotel.why}</p><div class="hotel-detail-row"><span>Passer godt til</span><b>{hotel.fit}</b></div><div class="hotel-detail-row"><span>Adresse</span><b>{hotel.address}</b></div></div>
            <div class="hotel-action"><div class="price-level"><span>Relativt prisniveau</span><b>{hotel.price}</b></div><a class="btn btn--primary" href={`https://www.booking.com/searchresults.html?ss=${hotel.query}`} target="_blank" rel="noopener nofollow">Se aktuelle priser ↗</a><small>Eksternt link til Booking.com · ikke annoncelink endnu</small></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section compare-section"><div class="container"><div class="section-head"><div><p class="eyebrow">Sammenlign</p><h2>De 5 valg på 20 sekunder.</h2></div><p>Hvis du allerede ved, hvilken type ophold du vil have, er denne oversigt nok til at indsnævre feltet.</p></div><div class="table-wrap card"><table class="hotel-table"><thead><tr><th>Hotel</th><th>Område</th><th>Bedst til</th><th>Niveau</th></tr></thead><tbody>{hotels.map((hotel, i) => <tr><td><b>{i+1}. {hotel.name}</b></td><td>{hotel.area}</td><td>{hotel.fit}</td><td><strong>{hotel.price}</strong></td></tr>)}</tbody></table></div></div></section>

  <section class="section decision-section"><div class="container decision-grid"><div><p class="eyebrow">Vælg hurtigt</p><h2>Hvis du bare vil have ét svar.</h2></div><div class="decision-card"><b>Første rejse til Hanoi</b><p>Bo omkring Old Quarter eller den nordlige del af Hoan Kiem. Det gør de første dage, mad og tour-pickups enklere.</p></div><div class="decision-card"><b>Vil du sove mere roligt?</b><p>Se mod French Quarter eller gader lige syd for Old Quarter i stedet for midt ved Beer Street.</p></div></div></section>

  <section class="section map-section"><div class="container"><HotelMap hotels={hotels} /></div></section>

  <section class="section section--tight"><div class="container next-card"><div><p class="eyebrow">Næste valg</p><h2>Er du stadig i tvivl om området?</h2><p>Læs områdeguiden først. Den forklarer gåafstand, støj og hvem de forskellige kvarterer passer til.</p></div><div class="next-actions"><a class="btn btn--primary" href="/destinationer/hanoi/hvor-skal-man-bo/">Hvor skal man bo i Hanoi? →</a><a class="text-link" href="/destinationer/hanoi/">Tilbage til Hanoi-guiden</a></div></div></section>

  <section class="section sources-section"><div class="container sources-card"><p class="eyebrow">Kilder og metode</p><a href="https://pholio.click/questions/hanoi/hotel-cost-hanoi-old-quarter-2026/" target="_blank" rel="noopener noreferrer">2026 Old Quarter hotel price bands ↗</a><a href="https://vietnam.travel/places-to-go/northern-vietnam/ha-noi" target="_blank" rel="noopener noreferrer">Vietnam Tourism - Hanoi ↗</a><a href="/destinationer/hanoi/hvor-skal-man-bo/">Vores områdeguide →</a></div></section>
</BaseLayout>

<style>
.hotel-hero{padding:76px 0 56px;background:linear-gradient(180deg,#f4ecdc 0%,var(--cream) 100%)}.hub-back{display:inline-block;margin-bottom:18px;color:var(--green-700);font-weight:800}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}.hotel-hero h1{font-size:clamp(2.8rem,6vw,5.3rem)}.answer{max-width:720px;margin-top:22px;padding:18px 20px;border-radius:18px;background:var(--green-950);color:white}.answer span{display:block;color:#f0cf95;font-size:.72rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.answer p{margin-top:5px;color:rgba(255,255,255,.82);line-height:1.55}.article-meta{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px;color:var(--muted);font-size:.86rem}.article-meta a{color:var(--green-700);font-weight:800}.hero-actions{display:flex;gap:12px;margin-top:24px;flex-wrap:wrap}.hero-photo{position:relative;overflow:hidden;border-radius:32px;box-shadow:var(--shadow);aspect-ratio:4/3}.hero-photo img{width:100%;height:100%;object-fit:cover}.hero-photo--graphic{display:grid;place-items:center;align-content:center;gap:8px;background:linear-gradient(145deg,#dfe9e3,#f2eadb);color:var(--green-950)}.hero-photo--graphic span{font-size:3.2rem}.hero-photo--graphic strong{font-size:1.6rem}.hero-photo--graphic small{color:var(--muted);font-weight:750}.hero-photo-source{position:absolute;left:12px;bottom:12px;padding:6px 9px;border-radius:999px;background:rgba(0,0,0,.62);color:white;font-size:.66rem;backdrop-filter:blur(8px)}.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.quick-grid>div{padding:20px;border:1px solid var(--border);border-radius:18px;background:rgba(255,255,255,.7)}.quick-grid span{display:block;color:var(--muted);font-size:.78rem;text-transform:uppercase;letter-spacing:.07em;font-weight:800}.quick-grid b{display:block;margin-top:5px;color:var(--green-950)}.price-guide{max-width:1100px}.method-card{margin-top:18px;padding:20px;border-left:4px solid var(--green-700);border-radius:16px;background:var(--green-100)}.method-card p{margin-top:6px;color:#46534d}.hotels-section{background:#f5efe2}.hotel-list{display:grid;gap:18px}.hotel-card{display:grid;grid-template-columns:250px minmax(0,1fr) 210px;gap:24px;align-items:stretch;background:#fffdf8;border:1px solid var(--border);border-radius:26px;overflow:hidden}.hotel-image-wrap{position:relative;min-height:230px;background:#e9eee9;overflow:hidden}.hotel-image-wrap img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1}.hotel-image-fallback{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:28px;background:linear-gradient(145deg,#dfe9e3,#f2eadb);color:var(--green-950)}.hotel-rank{position:absolute;left:14px;top:14px;display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:rgba(12,47,37,.92);color:white;font:700 .95rem Georgia,serif;z-index:3}.photo-source{position:absolute;left:10px;bottom:10px;padding:5px 8px;border-radius:999px;background:rgba(0,0,0,.58);color:white;font-size:.66rem;z-index:3}.hotel-main{padding:26px 0}.hotel-meta{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.hotel-meta span{padding:5px 9px;border-radius:999px;background:var(--green-100);color:var(--green-800);font-size:.74rem;font-weight:850}.hotel-meta small{color:var(--muted);font-weight:700}.hotel-main h3{margin-top:10px;font-size:1.6rem}.hotel-main>p{margin-top:10px;color:var(--muted)}.hotel-detail-row{display:grid;grid-template-columns:110px 1fr;gap:10px;margin-top:14px;font-size:.87rem}.hotel-detail-row span{color:var(--muted)}.hotel-detail-row b{color:var(--green-950)}.hotel-action{padding:26px 24px 26px 0;display:flex;flex-direction:column;justify-content:center}.price-level{margin-bottom:18px}.price-level span{display:block;color:var(--muted);font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;font-weight:800}.price-level b{display:block;margin-top:3px;color:var(--green-950);font-size:1.25rem;letter-spacing:.12em}.hotel-action .btn{width:100%;text-align:center}.hotel-action small{display:block;margin-top:9px;color:#87908b;font-size:.7rem;text-align:center}.table-wrap{overflow:auto}.hotel-table{width:100%;border-collapse:collapse;background:#fffdf8;min-width:700px}.hotel-table th,.hotel-table td{padding:16px 18px;text-align:left;border-bottom:1px solid var(--border);vertical-align:top}.hotel-table th{background:var(--green-100);color:var(--green-950);font-size:.78rem;text-transform:uppercase;letter-spacing:.07em}.hotel-table tr:last-child td{border-bottom:0}.decision-grid{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:20px}.decision-card{padding:26px;border-radius:22px;background:var(--green-950);color:white}.decision-card p{margin-top:8px;color:rgba(255,255,255,.72)}.map-section{padding-top:28px}.next-card{padding:34px;border-radius:28px;background:var(--sand);display:flex;justify-content:space-between;gap:28px;align-items:center}.next-card p:not(.eyebrow){margin-top:10px;color:#48554f}.next-actions{display:flex;flex-direction:column;align-items:center;gap:12px}.text-link{color:var(--green-700);font-size:.88rem;font-weight:800}.sources-section{padding-top:10px}.sources-card{padding:24px;border-top:1px solid var(--border);display:flex;gap:14px;flex-wrap:wrap}.sources-card .eyebrow{width:100%}.sources-card a{color:var(--green-700);font-size:.84rem;font-weight:750}
@media(max-width:1000px){.hotel-card{grid-template-columns:210px 1fr}.hotel-action{grid-column:2;padding:0 24px 24px 0;max-width:280px}.hero-grid,.decision-grid{grid-template-columns:1fr}.quick-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.hotel-card{grid-template-columns:1fr}.hotel-image-wrap{min-height:240px;aspect-ratio:16/10}.hotel-main{padding:0 22px}.hotel-action{grid-column:auto;padding:0 22px 24px;max-width:none}.hotel-detail-row{grid-template-columns:1fr}.quick-grid{grid-template-columns:1fr}.next-card{align-items:flex-start;flex-direction:column}.next-actions{align-items:flex-start}.hero-actions{flex-direction:column}}
</style>
