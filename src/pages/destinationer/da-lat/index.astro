    caption:'Da Lat er et godt temposkifte på en længere rejse, især hvis du vil have kaffe, natur og køligere aftener.',
    credit:'Tuong Lam Photos / Wikimedia Commons',
    creditUrl:'https://commons.wikimedia.org/wiki/File:Da_Lat_-_Viet_Nam.jpg',
    ratio:'16 / 7'
  }}
