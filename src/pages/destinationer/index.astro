---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DestinationCard from '../../components/DestinationCard.astro';

const places = [
  { name:'Hanoi', kicker:'Nordvietnam', description:'God til den første del af rejsen, hvis du vil have mad, historie og nem adgang til Ninh Binh og Ha Long.', image:'https://commons.wikimedia.org/wiki/Special:FilePath/Hanoi%20Skyline.jpg?width=1200', href:'/destinationer/hanoi/' },
  { name:'Ha Long Bay', kicker:'Nordvietnam', description:'Mest oplagt med 1 overnatning, hvis bugten er en vigtig del af rejsen.', image:'https://commons.wikimedia.org/wiki/Special:FilePath/Ha%20Long%20Bay%2C%20Vietnam%2C%20Boats.jpg?width=1200', href:'/ture/halong-bay-cruise/' },
  { name:'Hoi An', kicker:'Centralvietnam', description:'Et roligt stop med gammel by, mad, cykling og mulighed for strand.', image:'https://commons.wikimedia.org/wiki/Special:FilePath/HoiAnOldQuarter.jpg?width=1200', href:'/destinationer/hoi-an/' },
  { name:'Da Nang', kicker:'Centralvietnam', description:'Vælg byen hvis strand, større hoteller og nem adgang til lufthavnen betyder meget.', image:'https://commons.wikimedia.org/wiki/Special:FilePath/Panorama%20of%20Danang%20coast.jpg?width=1200', href:'/destinationer/da-nang/' },
  { name:'Nha Trang', kicker:'Sydcentral Vietnam', description:'Strandby med seafood, byliv og nem adgang til bugten og øture.', image:'https://commons.wikimedia.org/wiki/Special:FilePath/Nha%20Trang%20skyline.jpg?width=1200', href:'/destinationer/nha-trang/' },
  { name:'Ho Chi Minh City', kicker:'Sydvietnam', description:'Storby, historie og mad. God som sidste base før hjemrejsen.', image:'https://commons.wikimedia.org/wiki/Special:FilePath/Saigon%20skyline.jpg?width=1200', href:'/destinationer/ho-chi-minh-city/' },
  { name:'Phu Quoc', kicker:'Sydvietnam', description:'Til dig der bevidst vil bruge flere dage på strand og ro - ikke bare tilføje endnu et stop.', image:'https://commons.wikimedia.org/wiki/Special:FilePath/Sunset%20at%20Phu%20Quoc.jpg?width=1200', href:'/destinationer/phu-quoc/' },
];
---
<BaseLayout title="Rejsemål i Vietnam | Hanoi, Hoi An, Nha Trang, Phu Quoc m.fl. | RejsTilVietnam.dk" description="Danske guider til rejsemål i Vietnam: Hanoi, Ha Long Bay, Hoi An, Da Nang, Nha Trang, Ho Chi Minh City og Phu Quoc - og hjælp til at vælge de rigtige stop.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Rejsemål</p>
      <h1>Hvilke steder skal du faktisk vælge?</h1>
      <p class="lead">På en ferie på 2-3 uger kan du ikke nå hele Vietnam uden at bruge meget af tiden på transport. Vælg færre stop og giv dem ordentlig tid.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container grid grid--3">{places.map((place) => <DestinationCard {...place} />)}</div>
  </section>
</BaseLayout>
