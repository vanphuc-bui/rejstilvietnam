---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DestinationCard from '../../components/DestinationCard.astro';

const places = [
  { name:'Hanoi', kicker:'Nordvietnam', description:'God til den første del af rejsen, hvis du vil have mad, historie og nem adgang til Ninh Binh og Ha Long.', image:'https://images.unsplash.com/photo-1555921015-5532091f6026?auto=format&fit=crop&w=1200&q=82', href:'/destinationer/hanoi/' },
  { name:'Ha Long Bay', kicker:'Nordvietnam', description:'Mest oplagt med 1 overnatning, hvis bugten er en vigtig del af rejsen.', image:'https://images.unsplash.com/photo-1504457047772-27faf1c00561?auto=format&fit=crop&w=1200&q=82', href:'/ture/halong-bay-cruise/' },
  { name:'Hoi An', kicker:'Centralvietnam', description:'Et roligt stop med gammel by, mad, cykling og mulighed for strand.', image:'https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?auto=format&fit=crop&w=1200&q=82', href:'/destinationer/hoi-an/' },
  { name:'Da Nang', kicker:'Centralvietnam', description:'Vælg byen hvis strand, større hoteller og nem adgang til lufthavnen betyder meget.', image:'https://images.unsplash.com/photo-1564596823821-79b97151055e?auto=format&fit=crop&w=1200&q=82', href:'/destinationer/da-nang/' },
  { name:'Ho Chi Minh City', kicker:'Sydvietnam', description:'Storby, historie og mad. God som sidste base før hjemrejsen.', image:'https://images.unsplash.com/photo-1583417319070-4a69db38a482?auto=format&fit=crop&w=1200&q=82', href:'/destinationer/ho-chi-minh-city/' },
  { name:'Phu Quoc', kicker:'Sydvietnam', description:'Til dig der bevidst vil bruge flere dage på strand og ro - ikke bare tilføje endnu et stop.', image:'https://images.unsplash.com/photo-1570366583862-f91883984fde?auto=format&fit=crop&w=1200&q=82', href:'/destinationer/phu-quoc/' },
];
---
<BaseLayout title="Rejsemål i Vietnam | Hanoi, Hoi An, Phu Quoc m.fl. | RejsTilVietnam.dk" description="Danske guider til rejsemål i Vietnam: Hanoi, Ha Long Bay, Hoi An, Da Nang, Ho Chi Minh City og Phu Quoc - og hjælp til at vælge de rigtige stop.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Rejsemål</p>
      <h1>Hvilke steder skal du faktisk vælge?</h1>
      <p class="lead">På en ferie på 2-3 uger kan du ikke nå hele Vietnam uden at bruge meget af tiden på transport. Vælg færre stop og giv dem ordentlig tid.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container grid grid--3">{places.map((place) => <DestinationCard {...place} />)}</div>
  </section>
</BaseLayout>
