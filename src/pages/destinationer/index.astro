---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DestinationCard from '../../components/DestinationCard.astro';

const places = [
  { name:'Hanoi', kicker:'Nordvietnam', description:'Historie, street food og den perfekte base for nordens natur.', image:'https://images.unsplash.com/photo-1555921015-5532091f6026?auto=format&fit=crop&w=1200&q=82', href:'/destinationer/hanoi/' },
  { name:'Ha Long Bay', kicker:'Nordvietnam', description:'Kalkstensøer, cruises og kajak mellem bugtens dramatiske klipper.', image:'https://images.unsplash.com/photo-1504457047772-27faf1c00561?auto=format&fit=crop&w=1200&q=82', href:'/ture/halong-bay-cruise/' },
  { name:'Hoi An', kicker:'Centralvietnam', description:'Lanterner, madkurser, strand og afslappede aftener ved floden.', image:'https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?auto=format&fit=crop&w=1200&q=82', href:'/destinationer/hoi-an/' },
  { name:'Da Nang', kicker:'Centralvietnam', description:'Moderne kystby med brede strande og nem adgang til Hoi An.', image:'https://images.unsplash.com/photo-1564596823821-79b97151055e?auto=format&fit=crop&w=1200&q=82', href:'/destinationer/da-nang/' },
  { name:'Ho Chi Minh City', kicker:'Sydvietnam', description:'Energi, historie og udgangspunkt for Mekongdeltaet.', image:'https://images.unsplash.com/photo-1583417319070-4a69db38a482?auto=format&fit=crop&w=1200&q=82', href:'/destinationer/ho-chi-minh-city/' },
  { name:'Phu Quoc', kicker:'Sydvietnam', description:'Tropiske strande og et roligt sidste stop før hjemrejsen.', image:'https://images.unsplash.com/photo-1570366583862-f91883984fde?auto=format&fit=crop&w=1200&q=82', href:'/destinationer/phu-quoc/' },
];
---
<BaseLayout title="Destinationer i Vietnam | RejsTilVietnam.dk" description="Find de bedste destinationer i Vietnam for danske rejsende – fra Hanoi og Ha Long Bay til Hoi An, Da Nang, Ho Chi Minh City og Phu Quoc.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Destinationer</p>
      <h1>Find dit Vietnam.</h1>
      <p class="lead">Storby, natur, kultur eller strand? Start med den del af rejsen, du helst vil huske bagefter.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container grid grid--3">{places.map((place) => <DestinationCard {...place} />)}</div>
  </section>
</BaseLayout>
