---
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = [
  { kicker:'Cruise', title:'Ha Long Bay', text:'Dagstur eller 1 nat? Se hvad vi ville tjekke i rute, kahyt, transfer og nyere anmeldelser.', href:'/ture/halong-bay-cruise/' },
  { kicker:'Fra Hanoi', title:'Ninh Binh', text:'Dagstur eller overnatning? Se hvilke stop der er værd at prioritere, og hvad du roligt kan springe over.', href:'/ture/ninh-binh-fra-hanoi/' },
  { kicker:'Mad i Hanoi', title:'Street food', text:'Hvis du vil booke en madtur, ville vi vælge en lille gruppe og en tur, der faktisk besøger lokale spisesteder.', href:'/destinationer/hanoi/' },
];
---
<BaseLayout title="Ture og oplevelser i Vietnam | RejsTilVietnam.dk" description="Praktiske guides til ture i Vietnam: Ha Long Bay cruise, Ninh Binh fra Hanoi og andre oplevelser, hvor det kan betale sig at sammenligne før booking.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Ture & oplevelser</p>
      <h1>Hvad er værd at booke på forhånd?</h1>
      <p class="lead">Nogle ture gør rejsen lettere. Andre er mest ekstra transport og ventetid. Her samler vi de oplevelser, hvor det giver mening at sammenligne mulighederne først.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container grid grid--3">
      {guides.map((guide) => (
        <a class="card tour-guide" href={guide.href}>
          <span>{guide.kicker}</span>
          <h3>{guide.title}</h3>
          <p>{guide.text}</p>
          <b>Læs guiden →</b>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container article-shell">
      <article class="prose">
        <p class="eyebrow">Sådan vælger vi</p>
        <h2>Vi ville ikke booke en tur bare fordi den er populær.</h2>
        <p>En organiseret tur giver især mening, når den løser noget praktisk: transport mellem flere stop, båd, adgang eller en lokal guide, som faktisk gør oplevelsen bedre.</p>
        <p>Til gengæld behøver du ikke en tur til alt. I Hanoi, Hoi An og Ho Chi Minh City kan meget opleves på egen hånd med gang, taxi eller Grab.</p>
        <div class="notice"><strong>Affiliate:</strong> Når kommercielle links bliver aktive, markeres de tydeligt som <strong>Annoncelink</strong>. Booking og betaling foregår hos den eksterne platform.</div>
      </article>
      <aside class="card sidebar">
        <h3>Det ser vi på</h3>
        <p style="margin-top:12px;color:var(--muted)">Nyere anmeldelser, gruppestørrelse, transport, konkret rute, hvad der er inkluderet og afbestillingsvilkår.</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
.tour-guide { padding: 28px; transition: transform .2s ease, border-color .2s ease; }
.tour-guide:hover { transform: translateY(-3px); border-color: rgba(28,106,77,.25); }
.tour-guide > span { color: var(--coral); font-size: .75rem; font-weight: 850; text-transform: uppercase; letter-spacing: .1em; }
.tour-guide h3 { margin-top: 8px; font-size: 1.7rem; }
.tour-guide p { margin-top: 10px; color: var(--muted); }
.tour-guide b { display:inline-block; margin-top:20px; color:var(--green-700); }
</style>
