---
import BaseLayout from '../layouts/BaseLayout.astro';
import DestinationCard from '../components/DestinationCard.astro';

const destinations = [
  { name: 'Hanoi', kicker: 'Nordvietnam', description: 'Gadekøkkener, gamle kvarterer og et godt udgangspunkt for Ninh Binh og Ha Long.', href: '/destinationer/hanoi/', image: 'https://images.unsplash.com/photo-1555921015-5532091f6026?auto=format&fit=crop&w=1200&q=82' },
  { name: 'Hoi An', kicker: 'Centralvietnam', description: 'Lanterner, strand, cykelture og masser af gode steder at spise.', href: '/destinationer/hoi-an/', image: 'https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?auto=format&fit=crop&w=1200&q=82' },
  { name: 'Phu Quoc', kicker: 'Sydvietnam', description: 'Strand, solnedgang og nogle rolige dage sidst på rejsen.', href: '/destinationer/phu-quoc/', image: 'https://images.unsplash.com/photo-1583417319070-4a69db38a482?auto=format&fit=crop&w=1200&q=82' },
];
const practical = [
  ['☀️','Bedste rejsetid','Se hvornår vejret passer bedst til din rute.','/rejseguide/bedste-rejsetid/'],
  ['🛂','Visum og indrejse','Se de aktuelle regler for danske statsborgere.','/rejseguide/visum/'],
  ['💰','Penge og priser','Få et overblik over budget, kort og kontanter.','/rejseguide/penge-og-priser/'],
  ['🚆','Transport','Læs om fly, tog, bus og transport mellem byerne.','/rejseguide/transport/'],
];
const featured = [
  ['Rejseplan','Vietnam på 2 uger','Et forslag til en rolig rute fra nord til syd.','/rejseplaner/vietnam-2-uger/'],
  ['Fra Hanoi','Ninh Binh på én dag','Se om en dagstur er nok, eller om du bør blive en nat.','/ture/ninh-binh-fra-hanoi/'],
  ['Cruise','Ha Long Bay','Det er værd at tjekke rute, skib og varighed før du booker.','/ture/halong-bay-cruise/'],
];
---
<BaseLayout>
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eye">Vietnam for danskere</p>
        <h1>Planlæg din<br/><em>rejse til Vietnam.</em></h1>
        <p>Her finder du praktiske råd, forslag til ruter og guider til de steder, mange danske rejsende besøger.</p>
        <div class="hero-actions"><a class="btn btn--light" href="/rejseplaner/vietnam-2-uger/">Se forslag til 2 uger →</a><a class="text-link" href="/destinationer/">Se destinationer</a></div>
      </div>
      <div class="hero-note"><span>🇻🇳</span><div><b>Første gang i Vietnam?</b><p>Start med rejsetid, visum og rute.</p></div></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Destinationer</p><h2>Hvor vil du hen?</h2></div><p>Vietnam er langt fra nord til syd. Det kan derfor betale sig at vælge færre stop og bruge lidt mere tid hvert sted.</p></div>
      <div class="grid grid--3">{destinations.map((d) => <DestinationCard {...d} />)}</div>
      <div class="all-link"><a href="/destinationer/">Se alle destinationer →</a></div>
    </div>
  </section>

  <section class="section practical">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Før du rejser</p><h2>Det praktiske</h2></div><a class="btn btn--outline" href="/rejseguide/">Se hele rejseguiden →</a></div>
      <div class="grid grid--4">
        {practical.map(([icon,title,text,href]) => <a class="card icon-card" href={href}><span class="icon">{icon}</span><h3>{title}</h3><p>{text}</p><span class="more">Læs mere →</span></a>)}
      </div>
    </div>
  </section>

  <section class="section featured-guides">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Gode steder at begynde</p><h2>Tre guider til den første rejse</h2></div><p>Hvis du ikke ved, hvor du skal starte, er de her tre sider et godt udgangspunkt.</p></div>
      <div class="grid grid--3">
        {featured.map(([kicker,title,text,href]) => <a class="card guide-card" href={href}><span>{kicker}</span><h3>{title}</h3><p>{text}</p><b>Læs guiden →</b></a>)}
      </div>
    </div>
  </section>

  <section class="section story">
    <div class="container story-grid">
      <div class="story-copy"><p class="eyebrow">Om siden</p><h2>Vi sælger ikke rejser.</h2><p class="lead">RejsTilVietnam.dk er en uafhængig guide. Hvis vi linker til en bookingplatform, foregår booking og betaling hos den pågældende udbyder.</p><a class="btn btn--primary" href="/om/">Læs mere om siden →</a></div>
      <div class="route-card"><span>Forslag til rute</span><h3>Vietnam på 14 dage</h3><ol><li><b>01</b> Hanoi</li><li><b>02</b> Ninh Binh</li><li><b>03</b> Ha Long Bay</li><li><b>04</b> Hoi An</li><li><b>05</b> Ho Chi Minh City</li></ol><a href="/rejseplaner/vietnam-2-uger/">Se hele rejseplanen →</a></div>
    </div>
  </section>

  <section class="section newsletter"><div class="container news-card"><div><p class="eyebrow">Inden du booker</p><h2>Tjek visum og vejret først.</h2><p>Det gør det meget lettere at vælge rute og tidspunkt for rejsen.</p></div><a class="btn btn--light" href="/rejseguide/visum/">Se visumregler →</a></div></section>
</BaseLayout>
<style>
.hero { position: relative; min-height: 720px; overflow: hidden; background: var(--green-950); color: white; }
.hero-bg { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(5,28,21,.94) 0%, rgba(5,28,21,.72) 44%, rgba(5,28,21,.18) 74%), url('https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=2000&q=88') center/cover; }
.hero-inner { min-height: 720px; position: relative; display: flex; align-items: center; justify-content: space-between; padding-top: 48px; padding-bottom: 48px; }
.hero-copy { max-width: 760px; }
.hero-eye { color: #f6d99c; }
.hero-copy h1 { color: white; max-width: 800px; }
.hero-copy h1 em { color: #f2c986; font-family: Georgia, serif; font-weight: 400; }
.hero-copy > p:not(.eyebrow) { margin-top: 24px; max-width: 610px; color: rgba(255,255,255,.78); font-size: 1.18rem; }
.hero-actions { margin-top: 30px; display: flex; align-items: center; gap: 22px; }
.text-link { font-weight: 800; border-bottom: 1px solid rgba(255,255,255,.45); padding-bottom: 3px; }
.hero-note { align-self: end; margin-bottom: 12px; width: 300px; display: flex; gap: 14px; padding: 18px; border-radius: 20px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18); backdrop-filter: blur(16px); }
.hero-note > span { font-size: 1.8rem; }
.hero-note p { color: rgba(255,255,255,.7); font-size: .9rem; margin-top: 3px; }
.all-link { margin-top: 24px; text-align: right; }
.all-link a { color: var(--green-700); font-weight: 800; }
.practical { background: #f5efe2; }
.featured-guides { background: rgba(255,255,255,.36); }
.guide-card { padding: 28px; transition: transform .2s ease, border-color .2s ease; }
.guide-card:hover { transform: translateY(-3px); border-color: rgba(28,106,77,.25); }
.guide-card > span { color: var(--coral); font-size: .75rem; font-weight: 850; text-transform: uppercase; letter-spacing: .1em; }
.guide-card h3 { margin-top: 8px; font-size: 1.6rem; }
.guide-card p { color: var(--muted); margin-top: 9px; }
.guide-card b { display: inline-block; margin-top: 20px; color: var(--green-700); }
.story-grid { display: grid; grid-template-columns: 1.4fr .8fr; gap: 28px; align-items: stretch; }
.story-copy { padding: 42px 0; }
.story-copy .lead { margin: 22px 0 28px; }
.route-card { background: var(--green-950); color: white; padding: 32px; border-radius: 30px; box-shadow: var(--shadow); }
.route-card > span { color: #f0c986; font-size: .76rem; font-weight: 850; text-transform: uppercase; letter-spacing: .12em; }
.route-card h3 { color: white; font-size: 2rem; margin-top: 6px; }
.route-card ol { list-style: none; padding: 0; margin: 24px 0; }
.route-card li { display: flex; gap: 14px; padding: 11px 0; border-bottom: 1px solid rgba(255,255,255,.12); }
.route-card li b { color: #f0c986; }
.route-card a { font-weight: 800; }
.newsletter { padding-top: 16px; }
.news-card { padding: 44px; background: linear-gradient(125deg, #14533d, #0c2f25); color: white; border-radius: 34px; display: flex; align-items: center; justify-content: space-between; gap: 30px; }
.news-card h2 { color: white; font-size: clamp(2rem,4vw,3rem); }
.news-card p:not(.eyebrow) { color: rgba(255,255,255,.72); margin-top: 12px; }
.news-card .eyebrow { color: #f3cf8e; }
@media(max-width:900px){ .hero-note{display:none}.story-grid{grid-template-columns:1fr}.hero{min-height:650px}.hero-inner{min-height:650px}.news-card{align-items:flex-start;flex-direction:column} }
@media(max-width:640px){ .hero-actions{align-items:stretch;flex-direction:column}.text-link{text-align:center}.news-card{padding:28px}.all-link{text-align:left} }
</style>
