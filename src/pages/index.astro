---
import BaseLayout from '../layouts/BaseLayout.astro';
import DestinationCard from '../components/DestinationCard.astro';

const destinations = [
  { name: 'Hanoi', kicker: 'Nordvietnam', description: 'Gadekøkkener og historie - plus morgenløb ved søerne og naturdage uden for byen.', href: '/destinationer/hanoi/', image: 'https://images.unsplash.com/photo-1555921015-5532091f6026?auto=format&fit=crop&w=1200&q=82' },
  { name: 'Hoi An', kicker: 'Centralvietnam', description: 'Lanterner, strand og flade cykelruter gennem rismarkerne omkring byen.', href: '/destinationer/hoi-an/', image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Hoi%20An%20lanterns.jpg?width=1200' },
  { name: 'Da Nang', kicker: 'Centralvietnam', description: 'Strandby med løb på My Khe, Son Tra på cykel og korte aktive udflugter.', href: '/destinationer/da-nang/', image: 'https://commons.wikimedia.org/wiki/Special:FilePath/My%20Khe%20Beach%20Danang%20Coastline.jpg?width=1200' },
  { name: 'Nha Trang', kicker: 'Sydcentral Vietnam', description: 'Strandby med morgenløb, vandring ved Ba Ho og aktiviteter i bugten.', href: '/destinationer/nha-trang/', image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Nha%20trang%20beach.jpg?width=1200' },
  { name: 'Ho Chi Minh City', kicker: 'Sydvietnam', description: 'Storby, street food og tidlige løberuter i parker og nyere flodområder.', href: '/destinationer/ho-chi-minh-city/', image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Motorcycles%20in%20Ho%20Chi%20Minh%20City.jpg?width=1200' },
  { name: 'Phu Quoc', kicker: 'Sydvietnam', description: 'Strand og solnedgang - med kajak, cykling og skov til de aktive dage.', href: '/destinationer/phu-quoc/', image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Phu%20Quoc%20Beach.jpg?width=1200' },
];

const plans = [
  ['10 dage','En fokuseret rute med færre stop og mindre transport.','/rejseplaner/vietnam-10-dage/'],
  ['14 dage','Hanoi → Ninh Binh → Ha Long Bay → Hoi An → Ho Chi Minh City.','/rejseplaner/vietnam-2-uger/'],
  ['3 uger','Mere luft i programmet og plads til strand, Mekong eller ekstra dage i nord.','/rejseplaner/vietnam-3-uger/'],
];

const practical = [
  ['☀️','Bedste rejsetid','Se hvornår nord, central og syd passer bedst til din rute.','/rejseguide/bedste-rejsetid/'],
  ['🛂','Visum og indrejse','Se de aktuelle regler for danske statsborgere.','/rejseguide/visum/'],
  ['💰','Penge og priser','Få et overblik over budget, kort og kontanter.','/rejseguide/penge-og-priser/'],
  ['🚆','Transport','Læs om fly, tog, bus og transport mellem byerne.','/rejseguide/transport/'],
];

const tools = [
  ['🗺️','Rutekort','10, 14 eller 21 dage? Se ruterne og transporthoppene på ét skematisk kort.','/vaerktoejer/vietnam-rutekort/'],
  ['🧮','Budgetberegner','Indtast dine egne tal og få totalen i både DKK og VND.','/vaerktoejer/vietnam-budgetberegner/'],
  ['☀️','Vejrplanlægger','Vælg måned og sammenlign nord, central, syd og Phu Quoc.','/vaerktoejer/vietnam-vejrhjaelp/'],
];

const experiences = [
  ['Aktiv ferie','Løb, cykling og vandring','Find konkrete forslag med distance, sværhedsgrad, bedste tidspunkt og kort til startområdet.','/aktiv-ferie-i-vietnam/'],
  ['Cruise','Ha Long Bay','Dagstur eller 1 nat? Sammenlign rute, kahyt, transfer og nyere anmeldelser.','/ture/halong-bay-cruise/'],
  ['Fra Hanoi','Ninh Binh','Se om en dagstur er nok, eller om du bør blive en nat.','/ture/ninh-binh-fra-hanoi/'],
];

const booking = [
  ['🏨','Hoteller','Find det rigtige område først - derefter hotellet.'],
  ['🛶','Ture','Sammenlign oplevelser før du booker.'],
  ['✈️','Fly','Planlæg internationale og indenrigsfly omkring ruten.'],
  ['🧳','Pakkerejser','Få hele rejsen planlagt, hvis du ikke vil koordinere alt selv.'],
];
---
<BaseLayout title="Rejs til Vietnam - dansk guide til rejseplaner, steder og booking | RejsTilVietnam.dk" description="Planlæg din rejse til Vietnam med danske guider til rejsemål, 10-21 dages rejseplaner, visum, vejr, transport, oplevelser, hoteller og pakkerejser.">
  <section class="hero">
    <div class="hero-bg"><img src="https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=2000&q=88" alt="Grønt landskab i Vietnam" decoding="async" fetchpriority="high" onerror="window.__rtvImageFallback?.(this)" /><span></span></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eye">Vietnam for danskere</p>
        <h1>Planlæg din<br/><em>rejse til Vietnam.</em></h1>
        <p>Find de bedste rejsemål, byg en realistisk rute og få styr på det praktiske, før du begynder at booke.</p>
        <div class="hero-actions">
          <a class="btn btn--light" href="/destinationer/">Find dit rejsemål →</a>
          <a class="text-link" href="/rejseplaner/">Se rejseplaner</a>
        </div>
      </div>
      <div class="hero-note"><span>🇻🇳</span><div><b>Første gang i Vietnam?</b><p>Start med rejsetid, rute og visum.</p></div></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Rejsemål</p><h2>Hvor vil du hen?</h2></div><p>Vietnam er langt fra nord til syd. Vælg færre stop og brug lidt mere tid hvert sted i stedet for at samle flest mulige byer.</p></div>
      <div class="grid grid--3">{destinations.map((d) => <DestinationCard {...d} />)}</div>
      <div class="all-link"><a href="/destinationer/">Se alle rejsemål →</a></div>
    </div>
  </section>

  <section class="section plan-section">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Rejseplaner</p><h2>Hvor længe skal du være i Vietnam?</h2></div><p>En god rejseplan handler mindre om antal stop og mere om, hvor meget tid du vil bruge på transport og hotelskift.</p></div>
      <div class="grid grid--3">
        {plans.map(([days,text,href], i) => <a class={`card plan-card ${i === 1 ? 'plan-card--featured' : ''}`} href={href}><span>{days}</span><h3>{i === 0 ? 'Vietnam på 10 dage' : i === 1 ? 'Vietnam på 14 dage' : 'Vietnam på 3 uger'}</h3><p>{text}</p><b>Se rejseplan →</b></a>)}
      </div>
    </div>
  </section>

  <section class="section practical">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Planlæg rejsen</p><h2>Få styr på det praktiske.</h2></div><a class="btn btn--outline" href="/rejseguide/">Se hele planlægningsguiden →</a></div>
      <div class="grid grid--4">
        {practical.map(([icon,title,text,href]) => <a class="card icon-card" href={href}><span class="icon">{icon}</span><h3>{title}</h3><p>{text}</p><span class="more">Læs mere →</span></a>)}
      </div>
    </div>
  </section>

  <section class="section tools-home">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Gratis værktøjer</p><h2>Gør de tre svære valg konkrete.</h2></div>
        <p>Sammenlign rute, budget og vejrsæson i stedet for at gætte dig frem mellem mange forskellige artikler.</p>
      </div>
      <div class="grid grid--3">
        {tools.map(([icon,title,text,href]) => (
          <a class="tool-home-card" href={href}>
            <span>{icon}</span>
            <h3>{title}</h3>
            <p>{text}</p>
            <b>Åbn værktøj →</b>
          </a>
        ))}
      </div>
      <div class="all-link"><a href="/vaerktoejer/">Se alle gratis værktøjer →</a></div>
    </div>
  </section>

  <section class="section featured-guides">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Oplevelser</p><h2>Se Vietnam i dit eget tempo.</h2></div><p>Fra morgenløb og cykling til cruise og naturdage. Vi viser både det, du kan gøre selv, og de ture hvor transport eller en lokal guide faktisk gør dagen bedre.</p></div>
      <div class="grid grid--3">
        {experiences.map(([kicker,title,text,href]) => <a class="card guide-card" href={href}><span>{kicker}</span><h3>{title}</h3><p>{text}</p><b>Læs guiden →</b></a>)}
      </div>
      <div class="all-link"><a href="/ture/">Se alle oplevelser →</a></div>
    </div>
  </section>

  <section class="section booking-section">
    <div class="container booking-shell">
      <div class="booking-copy">
        <p class="eyebrow">Book rejsen</p>
        <h2>Når ruten er klar, samler vi de næste valg ét sted.</h2>
        <p class="lead">Hoteller, ture, fly og pakkerejser kommer til at ligge i samme booking-hub. Eventuelle kommercielle links bliver markeret tydeligt.</p>
        <a class="btn btn--primary" href="/book-rejsen/">Gå til booking-hub →</a>
      </div>
      <div class="booking-grid">
        {booking.map(([icon,title,text]) => <div class="booking-mini"><span>{icon}</span><div><b>{title}</b><p>{text}</p></div></div>)}
      </div>
    </div>
  </section>

  <section class="section story">
    <div class="container story-grid">
      <div class="story-copy"><p class="eyebrow">Uafhængig guide</p><h2>Vi sælger ikke rejser.</h2><p class="lead">RejsTilVietnam.dk hjælper dig med at sammenligne og planlægge. Hvis vi linker til en bookingplatform eller rejsepartner, foregår booking og betaling hos den pågældende udbyder.</p><a class="btn btn--primary" href="/om/">Læs mere om siden →</a></div>
      <div class="route-card"><span>Godt sted at starte</span><h3>Vietnam på 14 dage</h3><ol><li><b>01</b> Hanoi</li><li><b>02</b> Ninh Binh</li><li><b>03</b> Ha Long Bay</li><li><b>04</b> Hoi An</li><li><b>05</b> Ho Chi Minh City</li></ol><a href="/rejseplaner/vietnam-2-uger/">Se hele rejseplanen →</a></div>
    </div>
  </section>

  <section class="section newsletter"><div class="container news-card"><div><p class="eyebrow">Før du booker</p><h2>Tjek visum og rejsetid først.</h2><p>Det gør det meget lettere at vælge en rute, der faktisk passer til dine datoer.</p></div><a class="btn btn--light" href="/rejseguide/visum/">Se visumregler →</a></div></section>
</BaseLayout>
<style>
.hero { position: relative; min-height: 720px; overflow: hidden; background: var(--green-950); color: white; }
.hero-bg{position:absolute;inset:0;overflow:hidden;background:#123a2e}.hero-bg img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-bg span{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,28,21,.94) 0%,rgba(5,28,21,.72) 44%,rgba(5,28,21,.18) 74%)}
.hero-inner { min-height: 720px; position: relative; display: flex; align-items: center; justify-content: space-between; padding-top: 48px; padding-bottom: 48px; }
.hero-copy { max-width: 760px; }
.hero-eye { color: #f6d99c; }
.hero-copy h1 { color: white; max-width: 800px; }
.hero-copy h1 em { color: #f2c986; font-family: Georgia, serif; font-weight: 400; }
.hero-copy > p:not(.eyebrow) { margin-top: 24px; max-width: 610px; color: rgba(255,255,255,.78); font-size: 1.18rem; }
.hero-actions { margin-top: 30px; display: flex; align-items: center; gap: 22px; }
.text-link { font-weight: 800; border-bottom: 1px solid rgba(255,255,255,.45); padding-bottom: 3px; }
.hero-note { align-self: end; margin-bottom: 12px; width: 300px; display: flex; gap: 14px; padding: 18px; border-radius: 20px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18); backdrop-filter: blur(16px); }
.hero-note > span { font-size: 1.8rem; }
.hero-note p { color: rgba(255,255,255,.7); font-size: .9rem; margin-top: 3px; }
.all-link { margin-top: 24px; text-align: right; }
.all-link a { color: var(--green-700); font-weight: 800; }
.plan-section{background:rgba(255,255,255,.35)}
.plan-card{padding:30px;transition:transform .2s ease,border-color .2s ease}.plan-card:hover{transform:translateY(-3px);border-color:rgba(28,106,77,.25)}.plan-card>span{color:var(--coral);font-size:.78rem;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.plan-card h3{margin-top:8px;font-size:1.7rem}.plan-card p{margin-top:10px;color:var(--muted)}.plan-card b{display:inline-block;margin-top:22px;color:var(--green-700)}.plan-card--featured{background:var(--green-950);color:white}.plan-card--featured h3{color:white}.plan-card--featured p{color:rgba(255,255,255,.72)}.plan-card--featured b{color:#f0c986}
.practical { background: #f5efe2; }
.tools-home{background:var(--green-950);color:white}.tools-home .section-head h2{color:white}.tools-home .section-head>p{color:rgba(255,255,255,.68)}.tools-home .eyebrow{color:#b8dec9}.tools-home .all-link a{color:#f0c986}.tool-home-card{display:flex;flex-direction:column;min-height:260px;padding:26px;border:1px solid rgba(255,255,255,.14);border-radius:24px;background:rgba(255,255,255,.08);transition:transform .2s ease,background .2s ease}.tool-home-card:hover{transform:translateY(-3px);background:rgba(255,255,255,.12)}.tool-home-card>span{font-size:1.7rem}.tool-home-card h3{margin-top:16px;color:white}.tool-home-card p{margin-top:9px;color:rgba(255,255,255,.7)}.tool-home-card b{margin-top:auto;padding-top:22px;color:#f0c986}
.featured-guides { background: rgba(255,255,255,.36); }
.guide-card { padding: 28px; transition: transform .2s ease, border-color .2s ease; }
.guide-card:hover { transform: translateY(-3px); border-color: rgba(28,106,77,.25); }
.guide-card > span { color: var(--coral); font-size: .75rem; font-weight: 850; text-transform: uppercase; letter-spacing: .1em; }
.guide-card h3 { margin-top: 8px; font-size: 1.6rem; }
.guide-card p { color: var(--muted); margin-top: 9px; }
.guide-card b { display: inline-block; margin-top: 20px; color: var(--green-700); }
.booking-section{background:#f5efe2}.booking-shell{display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center}.booking-copy .lead{margin:18px 0 28px}.booking-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.booking-mini{display:flex;gap:12px;padding:18px;background:#fffdf8;border:1px solid var(--border);border-radius:18px}.booking-mini>span{font-size:1.55rem}.booking-mini b{color:var(--green-950)}.booking-mini p{margin-top:4px;color:var(--muted);font-size:.9rem}
.story-grid { display: grid; grid-template-columns: 1.4fr .8fr; gap: 28px; align-items: stretch; }
.story-copy { padding: 42px 0; }
.story-copy .lead { margin: 22px 0 28px; }
.route-card { background: var(--green-950); color: white; padding: 32px; border-radius: 30px; box-shadow: var(--shadow); }
.route-card > span { color: #f0c986; font-size: .76rem; font-weight: 850; text-transform: uppercase; letter-spacing: .12em; }
.route-card h3 { color: white; font-size: 2rem; margin-top: 6px; }
.route-card ol { list-style: none; padding: 0; margin: 24px 0; }
.route-card li { display: flex; gap: 14px; padding: 11px 0; border-bottom: 1px solid rgba(255,255,255,.12); }
.route-card li b { color: #f0c986; }
.route-card a { font-weight: 800; }
.newsletter { padding-top: 16px; }
.news-card { padding: 44px; background: linear-gradient(125deg, #14533d, #0c2f25); color: white; border-radius: 34px; display: flex; align-items: center; justify-content: space-between; gap: 30px; }
.news-card h2 { color: white; font-size: clamp(2rem,4vw,3rem); }
.news-card p:not(.eyebrow) { color: rgba(255,255,255,.72); margin-top: 12px; }
.news-card .eyebrow { color: #f3cf8e; }
@media(max-width:900px){ .hero-note{display:none}.story-grid,.booking-shell{grid-template-columns:1fr}.hero{min-height:650px}.hero-inner{min-height:650px}.news-card{align-items:flex-start;flex-direction:column} }
@media(max-width:640px){
  .hero,.hero-inner{min-height:520px}
  .hero-inner{padding-top:30px;padding-bottom:32px;align-items:flex-end}
  .hero-copy h1{font-size:clamp(2.25rem,9.6vw,2.85rem);line-height:1.03;text-wrap:balance}
  .hero-bg img{object-position:58% center}
  .hero-bg span{background:linear-gradient(180deg,rgba(5,28,21,.30) 0%,rgba(5,28,21,.76) 44%,rgba(5,28,21,.96) 100%)}
  .hero-copy>p:not(.eyebrow){margin-top:18px;font-size:1.02rem;line-height:1.58}
  .hero-actions{align-items:stretch;flex-direction:column;gap:12px;margin-top:24px}
  .text-link{text-align:center}
  .news-card{padding:24px;border-radius:24px}
  .all-link{text-align:left}
  .booking-grid{grid-template-columns:1fr}
  .plan-card,.guide-card{padding:22px}
  .route-card{padding:24px;border-radius:24px}
}
</style>
