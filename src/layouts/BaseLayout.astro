---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { editorialPeople } from '../data/editorialMetadata.js';

const {
  title = 'RejsTilVietnam.dk - Din danske guide til Vietnam',
  description = 'Dansk guide til Vietnam med rejsemål, rejseplaner, praktiske råd, oplevelser og hjælp til booking.',
  image,
  articleImage,
  pageType = 'website',
  headline,
  datePublished,
  dateModified,
  author = editorialPeople.author,
  reviewer = editorialPeople.reviewer,
  authorName = 'RejsTilVietnam.dk',
} = Astro.props;

const siteRoot = new URL('/', Astro.site ?? Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteRoot);
const isHomepage = Astro.url.pathname === '/';
const currentYear = new Date().getFullYear();
const nextYear = currentYear + 1;
const cleanPageTitle = (value = '') => value
  .replace(/\s*\|\s*RejsTilVietnam\.dk\s*$/i, '')
  .trim();
const finalTitle = isHomepage
  ? `Rejse til Vietnam ${currentYear}/${nextYear}: dansk guide og rejseplaner`
  : cleanPageTitle(title);
const finalDescription = isHomepage
  ? 'Planlæg din rejse til Vietnam med danske guider til Hanoi, Hoi An, Da Nang, Ho Chi Minh City og Phu Quoc samt visum, vejr og rejseplaner.'
  : description;
const finalImage = new URL(image ?? articleImage ?? '/brand-icon-192.png', siteRoot);
const finalArticleImage = articleImage ? new URL(articleImage, siteRoot).toString() : null;
const brandIcon = new URL('/brand-icon-192.png', siteRoot);

const breadcrumbLabels = {
  destinationer: 'Destinationer',
  hanoi: 'Hanoi',
  'hoi-an': 'Hoi An',
  'da-nang': 'Da Nang',
  'ho-chi-minh-city': 'Ho Chi Minh City',
  'phu-quoc': 'Phu Quoc',
  'nha-trang': 'Nha Trang',
  'bedste-hoteller': 'Bedste hoteller',
  'hvor-skal-man-bo': 'Hvor skal man bo',
  sevaerdigheder: 'Seværdigheder',
  '3-dage-i-hanoi': '3 dage i Hanoi',
  'lufthavn-til-centrum': 'Lufthavn til centrum',
  'mad-i-hanoi': 'Mad i Hanoi',
  'ninh-binh-fra-hanoi': 'Ninh Binh fra Hanoi',
  'ha-long-bay-fra-hanoi': 'Ha Long Bay fra Hanoi',
  'train-street': 'Train Street',
  rejseguide: 'Rejseguide',
  rejseplaner: 'Rejseplaner',
  ture: 'Ture',
  'aktiv-ferie-i-vietnam': 'Aktiv ferie i Vietnam',
  'book-rejsen': 'Book rejsen',
  vaerktoejer: 'Værktøjer',
  'vietnam-rutekort': 'Vietnam rutekort',
  'vietnam-budgetberegner': 'Vietnam budgetberegner',
  'vietnam-vejrhjaelp': 'Vietnam vejrplanlægger',
  'vietnam-trip-planner': 'Vietnam Trip Planner',
  'transport-matrix': 'Transport Matrix',
  om: 'Om os',
  'van-phuc-bui': 'Van-Phuc Bui',
  'le-huynh-nhu-thao': 'Lê Huỳnh Như Thảo',
};
const humanizeSegment = (segment) => breadcrumbLabels[segment] ?? segment
  .split('-')
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Forside',
    item: siteRoot.toString(),
  },
  ...pathSegments.map((segment, index) => ({
    '@type': 'ListItem',
    position: index + 2,
    name: humanizeSegment(segment),
    item: new URL(`/${pathSegments.slice(0, index + 1).join('/')}/`, siteRoot).toString(),
  })),
];

const inferredArticle = /^\/destinationer\/[^/]+\/[^/]+\/?$/.test(Astro.url.pathname);
const isArticle = pageType === 'article' || inferredArticle;
const organizationId = new URL('/#organization', siteRoot).toString();
const websiteId = new URL('/#website', siteRoot).toString();
const webpageId = `${canonical.toString()}#webpage`;
const articleId = `${canonical.toString()}#article`;

const absolutePerson = (person) => {
  const url = new URL(person.url, siteRoot).toString();
  return {
    ...person,
    url,
    image: person.image ? new URL(person.image, siteRoot).toString() : undefined,
    sameAs: person.sameAs ?? undefined,
    '@id': `${url}#person`,
  };
};

const articleAuthor = absolutePerson(author);
const articleReviewer = absolutePerson(reviewer);
const metaAuthorName = isArticle ? articleAuthor.name : authorName;

const personNode = (person) => ({
  '@type': 'Person',
  '@id': person['@id'],
  name: person.name,
  url: person.url,
  ...(person.image ? { image: person.image } : {}),
  ...(person.jobTitle ? { jobTitle: person.jobTitle } : {}),
  ...(person.description ? { description: person.description } : {}),
  ...(person.sameAs?.length ? { sameAs: person.sameAs } : {}),
  ...(person.knowsAbout?.length ? { knowsAbout: person.knowsAbout } : {}),
  worksFor: { '@id': organizationId },
});

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'RejsTilVietnam',
      alternateName: ['RejsTilVietnam.dk', 'Rejs Til Vietnam'],
      url: siteRoot.toString(),
      logo: {
        '@type': 'ImageObject',
        url: brandIcon.toString(),
        contentUrl: brandIcon.toString(),
        width: 192,
        height: 192,
      },
      image: brandIcon.toString(),
      founder: [
        {
          '@type': 'Person',
          name: editorialPeople.author.name,
          url: new URL(editorialPeople.author.url, siteRoot).toString(),
        },
        {
          '@type': 'Person',
          name: editorialPeople.reviewer.name,
          url: new URL(editorialPeople.reviewer.url, siteRoot).toString(),
        },
      ],
      description: 'Dansk guide til rejser i Vietnam med rejsemål, rejseplaner, visum, vejr, transport, hoteller og oplevelser.',
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'RejsTilVietnam',
      alternateName: ['RejsTilVietnam.dk', 'rejstilvietnam.dk', 'Rejs Til Vietnam'],
      url: siteRoot.toString(),
      inLanguage: 'da-DK',
      publisher: { '@id': organizationId },
      description: 'Dansk guide til rejser i Vietnam med rejsemål, rejseplaner, visum, vejr, transport, hoteller og oplevelser.',
    },
    ...(pathSegments.length > 0 ? [{
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbItems,
    }] : []),
    ...(isArticle ? [
      personNode(articleAuthor),
      personNode(articleReviewer),
      {
        '@type': 'WebPage',
        '@id': webpageId,
        url: canonical.toString(),
        name: finalTitle,
        description: finalDescription,
        inLanguage: 'da-DK',
        isPartOf: { '@id': websiteId },
        mainEntity: { '@id': articleId },
        reviewedBy: { '@id': articleReviewer['@id'] },
        ...(datePublished ? { datePublished } : {}),
        ...(dateModified ? { dateModified } : {}),
        ...(finalArticleImage ? {
          primaryImageOfPage: {
            '@type': 'ImageObject',
            url: finalArticleImage,
          },
        } : {}),
      },
      {
        '@type': 'Article',
        '@id': articleId,
        headline: headline ?? finalTitle,
        description: finalDescription,
        mainEntityOfPage: { '@id': webpageId },
        url: canonical.toString(),
        inLanguage: 'da-DK',
        ...(datePublished ? { datePublished } : {}),
        ...(dateModified ? { dateModified } : {}),
        ...(finalArticleImage ? { image: [finalArticleImage] } : {}),
        author: { '@id': articleAuthor['@id'] },
        publisher: { '@id': organizationId },
        isPartOf: { '@id': websiteId },
      },
    ] : []),
  ],
};
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={finalDescription} />
    <meta name="author" content={metaAuthorName} />
    <meta name="application-name" content="RejsTilVietnam" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#0f5132" />
    <meta name="impact-site-verification" value="51fc1923-2d2d-44e3-9428-83d3ff9ad0b7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="shortcut icon" href="/favicon.svg?v=4" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand-icon-192.png?v=4" />
    <link rel="apple-touch-icon" sizes="192x192" href="/brand-icon-192.png?v=4" />
    <link rel="manifest" href="/site.webmanifest?v=4" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:site_name" content="RejsTilVietnam" />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={finalImage} />
    <meta property="og:image:alt" content={finalTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={finalImage} />
    <title>{finalTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <script is:inline>
      (() => {
        const proxiedImage = (src = '') => {
          if (!/^https?:\/\//i.test(src)) return src;
          const localPreview = ['127.0.0.1', 'localhost'].includes(window.location.hostname);
          if (localPreview) return src;
          return '/media/remote?src=' + encodeURIComponent(src);
        };

        const fallbackPhoto = (alt = '') => {
          const text = alt.toLowerCase();
          // Keep the emergency photo fallback on a different network path from
          // the Worker proxy. If the proxy itself is unavailable, users still
          // get a real photo instead of dropping straight to the SVG placeholder.
          if (/hanoi|ha noi/.test(text)) return 'https://images.unsplash.com/photo-1555921015-5532091f6026?auto=format&fit=crop&w=1600&q=82';
          if (/hoi an/.test(text)) return 'https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?auto=format&fit=crop&w=1600&q=82';
          return 'https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=1600&q=82';
        };

        window.__rtvImageUrl = proxiedImage;

        const svgFallback = (img) => {
          const label = (img.alt || 'Vietnam').trim().slice(0, 58) || 'Vietnam';
          const safe = label.replace(/[&<>"']/g, (ch) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&apos;'}[ch]));
          const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 720">
            <defs>
              <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
                <stop stop-color="#123a2e"/>
                <stop offset=".58" stop-color="#3f7860"/>
                <stop offset="1" stop-color="#d2aa68"/>
              </linearGradient>
            </defs>
            <rect width="1200" height="720" fill="url(#g)"/>
            <text x="64" y="620" fill="#fff" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="700" opacity=".82">REJSTILVIETNAM.DK</text>
            <text x="64" y="664" fill="#fff" font-family="Georgia,serif" font-size="34" font-weight="700">${safe}</text>
          </svg>`;
          img.removeAttribute('srcset');
          img.src = 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
          img.style.display = '';
        };

        const fallback = (img) => {
          if (!img || img.dataset.rtvFallbackLock === '1') return;

          // One failed <img> can be observed both by a component onerror handler
          // and by the delegated document error listener. Lock this event turn so
          // the same failure cannot advance two fallback stages at once.
          img.dataset.rtvFallbackLock = '1';
          setTimeout(() => { delete img.dataset.rtvFallbackLock; }, 0);

          const stage = img.dataset.rtvFallbackStage || 'original';
          if (stage === 'original') {
            img.dataset.rtvFallbackStage = 'photo';
            img.removeAttribute('srcset');
            img.src = proxiedImage(fallbackPhoto(img.alt || ''));
            img.style.display = '';
            return;
          }
          if (stage === 'photo') {
            img.dataset.rtvFallbackStage = 'svg';
            svgFallback(img);
          }
        };

        window.__rtvImageFallback = fallback;
        document.addEventListener('error', (event) => {
          const target = event.target;
          if (target && target.tagName === 'IMG') {
            fallback(target);
            setTimeout(() => { target.style.display = ''; }, 0);
          }
        }, true);
      })();
    </script>
    <script is:inline>
      (() => {
        window.dataLayer = window.dataLayer || [];

        const cleanProvider = (value = '') => {
          const provider = value.toLowerCase().trim();
          if (provider.includes('getyourguide') || provider === 'gyg') return 'getyourguide';
          if (provider.includes('booking')) return 'booking';
          if (provider.includes('viator')) return 'viator';
          if (provider.includes('airalo')) return 'airalo';
          if (provider.includes('holafly')) return 'holafly';
          if (provider.includes('nomad')) return 'nomad';
          return provider || 'unknown';
        };

        const providerFromUrl = (href) => {
          try {
            const host = new URL(href, window.location.href).hostname.toLowerCase();
            if (host === 'gyg.me' || host.endsWith('.getyourguide.com') || host === 'getyourguide.com') return 'getyourguide';
            if (host.endsWith('.booking.com') || host === 'booking.com') return 'booking';
            if (host.endsWith('.viator.com') || host === 'viator.com') return 'viator';
            if (host.includes('airalo')) return 'airalo';
            if (host.includes('holafly')) return 'holafly';
            if (host.includes('getnomad') || host === 'nomad.com') return 'nomad';
            return host.replace(/^www\./, '') || 'unknown';
          } catch {
            return 'unknown';
          }
        };

        const destinationFromPath = () => {
          const match = window.location.pathname.match(/^\/destinationer\/([^/]+)/);
          return match?.[1] || 'sitewide';
        };

        const trackAffiliateClick = (anchor) => {
          const rel = (anchor.getAttribute('rel') || '').split(/\s+/);
          const explicitlyAffiliate = rel.includes('sponsored') || Boolean(anchor.dataset.affiliateProvider);
          if (!explicitlyAffiliate) return;

          const provider = cleanProvider(anchor.dataset.affiliateProvider || providerFromUrl(anchor.href));
          const placement = anchor.dataset.affiliatePlacement
            || anchor.closest('[data-analytics-placement]')?.dataset.analyticsPlacement
            || 'unspecified';
          let targetHost = 'unknown';
          try { targetHost = new URL(anchor.href, window.location.href).hostname.replace(/^www\./, ''); } catch {}

          const payload = {
            page: window.location.pathname,
            provider,
            destination: anchor.dataset.affiliateDestination || destinationFromPath(),
            placement,
            targetHost,
            linkText: (anchor.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 120),
          };

          window.dataLayer.push({
            event: 'affiliate_click',
            affiliate_provider: payload.provider,
            affiliate_destination: payload.destination,
            affiliate_placement: payload.placement,
            affiliate_target_host: payload.targetHost,
            page_path: payload.page,
          });

          const body = JSON.stringify(payload);
          try {
            if (navigator.sendBeacon) {
              navigator.sendBeacon('/api/affiliate-click', new Blob([body], { type: 'application/json' }));
            } else {
              fetch('/api/affiliate-click', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body,
                keepalive: true,
                credentials: 'same-origin',
              }).catch(() => {});
            }
          } catch {}
        };

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const anchor = target.closest('a[href]');
          if (anchor) trackAffiliateClick(anchor);
        }, { capture: true });
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />

  </body>
</html>
