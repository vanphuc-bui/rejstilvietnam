---
import BaseLayout from './BaseLayout.astro';
import HubGrid from '../components/HubGrid.astro';
import MarineHubHighlights from '../components/MarineHubHighlights.astro';
import GuideCover from '../components/GuideCover.astro';
import ActiveOutdoor from '../components/ActiveOutdoor.astro';
import ActiveTripCallout from '../components/ActiveTripCallout.astro';
import { getActiveOutdoor } from '../data/activeOutdoor.js';
import { hoiAnPages } from '../data/hoiAnCluster.js';
import { hoChiMinhPages } from '../data/hoChiMinhCluster.js';
import { phuQuocPages } from '../data/phuQuocCluster.js';
import { daNangPages } from '../data/daNangCluster.js';
import { nhaTrangPages } from '../data/nhaTrangCluster.js';
import { enhanceMarineCluster } from '../data/marineActivityCluster.js';

const {
  title,
  description,
  eyebrow = 'Rejseguide',
  heading,
  intro,
  updated,
  dateModified,
  toc = [],
  sources = [],
  authorName = 'RejsTilVietnam.dk',
} = Astro.props;

const destinationMatch = Astro.url.pathname.match(/^\/destinationer\/([^/]+)\/.+/);
const destinationSlug = destinationMatch?.[1] ?? null;
const destinationNames = {
  'hanoi':'Hanoi',
  'hoi-an':'Hoi An',
  'ho-chi-minh-city':'Ho Chi Minh City',
  'phu-quoc':'Phu Quoc',
  'da-nang':'Da Nang',
  'nha-trang':'Nha Trang',
};
const hubHref = destinationSlug ? `/destinationer/${destinationSlug}/` : null;
const hubLabel = destinationSlug ? `${destinationNames[destinationSlug] ?? destinationSlug} rejseguide` : null;

const clusterSets = {
  'hoi-an': hoiAnPages,
  'ho-chi-minh-city': hoChiMinhPages,
  'phu-quoc': enhanceMarineCluster(phuQuocPages, 'phu-quoc'),
  'da-nang': daNangPages,
  'nha-trang': enhanceMarineCluster(nhaTrangPages, 'nha-trang'),
};
const hubMeta = {
  'hoi-an': {
    title:'Hoi An rejseguide | Seværdigheder, hotel, strand og mad',
    heading:'Hoi An rejseguide: planlæg den gamle by, stranden og dagene imellem',
    intro:'Brug Hoi An-hubben til at vælge område, hotel, seværdigheder, mad, strand og transport fra Da Nang. Hver guide løser ét konkret spørgsmål, så du kan planlægge uden at læse den samme information flere gange.',
  },
  'ho-chi-minh-city': {
    title:'Ho Chi Minh City rejseguide | Seværdigheder og dagsture',
    heading:'Ho Chi Minh City rejseguide: planlæg storbyen i logiske bidder',
    intro:'Her samler vi guider til seværdigheder, tre dage i byen, områder, hoteller, mad, Cu Chi, Mekong, lufthavn og vejret. Målet er at holde transporten nede og gøre hvert valg tydeligt.',
  },
  'phu-quoc': {
    title:'Phu Quoc rejseguide | Strande, hoteller og snorkling',
    heading:'Phu Quoc rejseguide: vælg kyst, hotel og havoplevelser før du booker',
    intro:'Phu Quoc er stor nok til, at område og sæson ændrer hele ferien. Hubben samler strandguide, hotelområder, hoteller, øhop, snorkling, vandsport, fire-dages plan, vejr og transport.',
  },
  'da-nang': {
    title:'Da Nang rejseguide | Strand, seværdigheder og Hoi An',
    heading:'Da Nang rejseguide: strandby, bjerge og base for Centralvietnam',
    intro:'Brug hubben til at vælge område, hotel, strand og seværdigheder samt planlægge Ba Na Hills og turen mellem Da Nang og Hoi An.',
  },
  'nha-trang': {
    title:'Nha Trang rejseguide | Strand, snorkling og dykning',
    heading:'Nha Trang rejseguide: planlæg bystrand, øture og undervandsoplevelser',
    intro:'Nha Trang kombinerer rigtig by med strand og en stærk havprofil. Hubben samler seværdigheder, område, hoteller, strande, øture, snorkling, dykning, vandsport og en tre-dages rejseplan.',
  },
};
const hubMatch = Astro.url.pathname.match(/^\/destinationer\/([^/]+)\/$/);
const hubSlug = hubMatch?.[1] ?? null;
const guideMatch = Astro.url.pathname.match(/^\/destinationer\/([^/]+)\/([^/]+)\/$/);
const guideSlug = guideMatch?.[2] ?? null;
const activeData = getActiveOutdoor(destinationSlug ?? hubSlug);
const activeGuidePattern = /^(sevaerdigheder|bedste-strande|3-dage-|4-dage-|vandsport|snorkling|dykning|oehop)/;
const showActiveOnGuide = Boolean(activeData && guideSlug && activeGuidePattern.test(guideSlug));
const showActiveOnItinerary = /^\/rejseplaner\/[^/]+\/$/.test(Astro.url.pathname);
const finalToc = [
  ...toc,
  ...(showActiveOnGuide && !toc.some((item) => item.id === 'aktiv-ferie') ? [{ id: 'aktiv-ferie', label: 'Aktiv ferie' }] : []),
  ...(showActiveOnItinerary && !toc.some((item) => item.id === 'aktiv-rute') ? [{ id: 'aktiv-rute', label: 'Aktiv rejseprofil' }] : []),
];
const currentCluster = hubSlug ? clusterSets[hubSlug] : null;
const currentHubMeta = hubSlug ? hubMeta[hubSlug] : null;
const finalTitle = currentHubMeta?.title ?? title;
const finalHeading = currentHubMeta?.heading ?? heading;
const finalIntro = currentHubMeta?.intro ?? intro;
const hubCards = currentCluster ? Object.entries(currentCluster).map(([guide, page]) => ({
  href: `/destinationer/${hubSlug}/${guide}/`,
  label: page.eyebrow?.split('·').pop()?.trim() ?? 'Guide',
  title: page.heading,
  text: page.intro,
})) : [];
const showMarineHighlights = hubSlug === 'phu-quoc' || hubSlug === 'nha-trang';
---
<BaseLayout
  title={finalTitle}
  description={description}
  pageType="article"
  headline={finalHeading}
  dateModified={dateModified}
  authorName={authorName}
>
  <section class="page-hero article-hero">
    <div class="container">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{finalHeading}</h1>
      <div class="quick-answer" aria-label="Kort svar">
        <span>Kort svar</span>
        <p>{finalIntro}</p>
      </div>
      <div class="article-meta">
        <span>Af <a href="/om/">{authorName}</a></span>
        {updated && <span>Opdateret {updated}</span>}
        <span>Guide på dansk</span>
      </div>
    </div>
  </section>

  <div class="container article-hero-media">
    {Astro.slots.has('heroMedia') ? (
      <slot name="heroMedia" />
    ) : (
      <GuideCover
        destination={destinationSlug ? (destinationNames[destinationSlug] ?? 'Vietnam') : 'Vietnam'}
        title={finalHeading ?? finalTitle}
        eyebrow={eyebrow}
      />
    )}
  </div>

  {hubCards.length > 0 && (
    <div class="container auto-hub-grid">
      <HubGrid
        cards={hubCards}
        title={`Planlæg ${destinationNames[hubSlug] ?? hubSlug}`}
        intro="Vælg den guide, der matcher dit næste spørgsmål. Hver side har ét tydeligt søgeformål, så hotel, områder, oplevelser og transport ikke konkurrerer med hinanden."
      />
    </div>
  )}

  {showMarineHighlights && (
    <div class="container marine-hub-wrap">
      <MarineHubHighlights destination={hubSlug} />
    </div>
  )}

  {hubSlug && getActiveOutdoor(hubSlug) && (
    <div class="container active-hub-wrap">
      <ActiveOutdoor destinationSlug={hubSlug} />
    </div>
  )}

  <section class="section section--tight article-content">
    <div class="container article-shell">
      {finalToc.length > 0 && (
        <nav class="mobile-toc card" aria-label="Indholdsfortegnelse">
          {hubHref && <a class="mobile-hub-back" href={hubHref}>← {hubLabel}</a>}
          <details class="mobile-toc-details">
            <summary>
              <span>På denne side</span>
              <span class="toc-toggle" aria-hidden="true">⌄</span>
            </summary>
            <div class="toc">{finalToc.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}</div>
          </details>
        </nav>
      )}

      <article class="prose">
        <slot />
        {showActiveOnGuide && <ActiveOutdoor destinationSlug={destinationSlug} compact />}
        {showActiveOnItinerary && <ActiveTripCallout />}
      </article>

      <aside class="card sidebar article-sidebar" aria-label="Guideinformation">
        {hubHref && <a class="hub-back" href={hubHref}>← {hubLabel}</a>}
        {finalToc.length > 0 && (
          <>
            <p class="sidebar-label">På denne side</p>
            <nav class="toc" aria-label="Indholdsfortegnelse">
              {finalToc.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
            </nav>
          </>
        )}

        {sources.length > 0 && (
          <div class="sidebar-sources">
            <p class="sidebar-label">Kilder</p>
            {sources.map((source) => (
              <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>
            ))}
          </div>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
.article-hero { padding-bottom: 34px; }
.article-hero h1 { max-width: 980px; }
.quick-answer { max-width: 860px; margin-top: 24px; padding: 18px 20px; border: 1px solid rgba(28,106,77,.18); border-left: 4px solid var(--green-700); border-radius: 18px; background: rgba(255,255,255,.66); }
.quick-answer > span { display: block; margin-bottom: 6px; color: var(--green-700); font-size: .72rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
.quick-answer p { margin: 0; color: #31423a; font-size: clamp(1.02rem,1.5vw,1.16rem); line-height: 1.65; }
.article-meta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 16px; color: var(--muted); font-size: .88rem; }
.article-meta a { color: var(--green-700); font-weight: 750; }
.article-hero-media { margin-top: 4px; }
.article-hero-media :global(.section-media) { margin-top: 0; }
.article-hero-media :global(.media-frame) { aspect-ratio: 16 / 7; }
.auto-hub-grid { margin-top: 28px; }
.marine-hub-wrap { margin-top: -8px; }
.active-hub-wrap { margin-top: 18px; }
.article-sidebar { display: grid; gap: 24px; }
.sidebar-label { font-size: .75rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; color: var(--green-700); margin-bottom: 10px; }
.toc, .sidebar-sources { display: grid; gap: 9px; }
.toc a, .sidebar-sources a { color: #405048; font-size: .92rem; line-height: 1.35; }
.toc a:hover, .sidebar-sources a:hover { color: var(--green-700); }
.sidebar-sources { padding-top: 20px; border-top: 1px solid var(--border); }
.hub-back, .mobile-hub-back { color: var(--green-700); font-weight: 800; font-size: .9rem; }
.mobile-toc { display: none; padding: 20px; }
.mobile-toc .mobile-hub-back { display: inline-block; margin-bottom: 16px; }
@media (max-width: 900px) {
  :global(.article-shell) { gap:26px; }
  .mobile-toc { display:block; }
  .mobile-toc-details summary {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    min-height:44px;
    color:var(--green-950);
    font-size:.78rem;
    font-weight:850;
    letter-spacing:.09em;
    text-transform:uppercase;
    cursor:pointer;
    list-style:none;
  }
  .mobile-toc-details summary::-webkit-details-marker { display:none; }
  .toc-toggle {
    display:grid;
    place-items:center;
    width:30px;
    height:30px;
    flex:0 0 30px;
    border:1px solid var(--border);
    border-radius:999px;
    background:#fffdf8;
    color:var(--green-700);
    font-size:1.05rem;
    line-height:1;
    transition:transform .2s ease;
  }
  .mobile-toc-details[open] .toc-toggle { transform:rotate(180deg); }
  .mobile-toc-details .toc {
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:8px;
    padding-top:10px;
  }
  .mobile-toc-details .toc a {
    display:flex;
    align-items:center;
    min-width:0;
    min-height:42px;
    padding:9px 11px;
    border:1px solid var(--border);
    border-radius:12px;
    background:#fffdf8;
    color:#405048;
    font-size:.79rem;
    line-height:1.25;
    overflow-wrap:anywhere;
  }
  .article-sidebar .toc, .article-sidebar > .sidebar-label, .article-sidebar .hub-back { display:none; }
  .sidebar-sources a { overflow-wrap:anywhere; }
  .article-sidebar:not(:has(.sidebar-sources)) { display:none; }
}
@media (max-width: 640px) {
  .article-hero { padding-bottom:22px; }
  .article-hero h1 { font-size:clamp(2rem,8.8vw,2.55rem); line-height:1.06; max-width:22ch; text-wrap:balance; }
  .quick-answer { margin-top:18px; padding:15px 16px; border-radius:15px; }
  .quick-answer p { font-size:.98rem; line-height:1.55; }
  .article-meta { gap:5px 12px; font-size:.8rem; line-height:1.4; }
  .article-hero-media { margin-top:0; }
  .article-hero-media :global(.media-frame) { aspect-ratio:4 / 3 !important; border-radius:18px; }
  .article-content { padding:34px 0 52px; }
  .mobile-toc { width:100%; min-width:0; padding:14px 15px; margin-bottom:0; overflow:hidden; }
  .mobile-toc .mobile-hub-back {
    display:inline-block;
    margin-bottom:8px;
    font-size:.82rem;
  }
  .mobile-toc-details .toc { grid-template-columns:1fr; }
  .mobile-toc-details .toc a { min-height:40px; }
}
</style>
