---
import BaseLayout from './BaseLayout.astro';
import HubGrid from '../components/HubGrid.astro';
import { hoiAnPages } from '../data/hoiAnCluster.js';
import { hoChiMinhPages } from '../data/hoChiMinhCluster.js';
import { phuQuocPages } from '../data/phuQuocCluster.js';
import { daNangPages } from '../data/daNangCluster.js';
import { nhaTrangPages } from '../data/nhaTrangCluster.js';

const {
  title,
  description,
  eyebrow = 'Rejseguide',
  heading,
  intro,
  updated = '15. september 2026',
  dateModified = '2026-09-15',
  toc = [],
  sources = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const destinationMatch = Astro.url.pathname.match(/^\/destinationer\/([^/]+)\/.+/);
const destinationSlug = destinationMatch?.[1] ?? null;
const destinationNames = {
  'hanoi':'Hanoi',
  'hoi-an':'Hoi An',
  'ho-chi-minh-city':'Ho Chi Minh City',
  'phu-quoc':'Phu Quoc',
  'da-nang':'Da Nang',
  'nha-trang':'Nha Trang',
};
const hubHref = destinationSlug ? `/destinationer/${destinationSlug}/` : null;
const hubLabel = destinationSlug ? `${destinationNames[destinationSlug] ?? destinationSlug} rejseguide` : null;

const clusterSets = {
  'hoi-an': hoiAnPages,
  'ho-chi-minh-city': hoChiMinhPages,
  'phu-quoc': phuQuocPages,
  'da-nang': daNangPages,
  'nha-trang': nhaTrangPages,
};
const hubMatch = Astro.url.pathname.match(/^\/destinationer\/([^/]+)\/$/);
const hubSlug = hubMatch?.[1] ?? null;
const currentCluster = hubSlug ? clusterSets[hubSlug] : null;
const hubCards = currentCluster ? Object.entries(currentCluster).map(([guide, page]) => ({
  href: `/destinationer/${hubSlug}/${guide}/`,
  label: page.eyebrow?.split('·').pop()?.trim() ?? 'Guide',
  title: page.heading,
  text: page.intro,
})) : [];
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: heading,
    description,
    mainEntityOfPage: canonical,
    inLanguage: 'da-DK',
    dateModified,
    publisher: {
      '@type': 'Organization',
      name: 'RejsTilVietnam.dk',
      url: Astro.site ?? Astro.url.origin,
    },
  })}></script>

  <section class="page-hero article-hero">
    <div class="container">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="lead">{intro}</p>
      <div class="article-meta">
        <span>Opdateret {updated}</span>
        <span>Guide på dansk</span>
      </div>
    </div>
  </section>

  {Astro.slots.has('heroMedia') && (
    <div class="container article-hero-media">
      <slot name="heroMedia" />
    </div>
  )}

  {hubCards.length > 0 && (
    <div class="container auto-hub-grid">
      <HubGrid
        cards={hubCards}
        title={`Planlæg ${destinationNames[hubSlug] ?? hubSlug}`}
        intro="Vælg den guide, der matcher dit næste spørgsmål. Hver side har ét tydeligt søgeformål, så hotel, områder, oplevelser og transport ikke konkurrerer med hinanden."
      />
    </div>
  )}

  <section class="section section--tight">
    <div class="container article-shell">
      {toc.length > 0 && (
        <nav class="mobile-toc card" aria-label="Indholdsfortegnelse">
          {hubHref && <a class="mobile-hub-back" href={hubHref}>← {hubLabel}</a>}
          <p class="sidebar-label">På denne side</p>
          <div class="toc">{toc.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}</div>
        </nav>
      )}

      <article class="prose">
        <slot />
      </article>

      <aside class="card sidebar article-sidebar">
        {hubHref && <a class="hub-back" href={hubHref}>← {hubLabel}</a>}
        {toc.length > 0 && (
          <>
            <p class="sidebar-label">På denne side</p>
            <nav class="toc" aria-label="Indholdsfortegnelse">
              {toc.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
            </nav>
          </>
        )}

        {sources.length > 0 && (
          <div class="sidebar-sources">
            <p class="sidebar-label">Kilder</p>
            {sources.map((source) => (
              <a href={source.href} target="_blank" rel="noopener">{source.label} ↗</a>
            ))}
          </div>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
.article-hero { padding-bottom: 34px; }
.article-hero h1 { max-width: 980px; }
.article-hero .lead { margin-top: 22px; }
.article-meta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 18px; color: var(--muted); font-size: .88rem; }
.article-hero-media { margin-top: 4px; }
.article-hero-media :global(.section-media) { margin-top: 0; }
.article-hero-media :global(.media-frame) { aspect-ratio: 16 / 7; }
.auto-hub-grid { margin-top: 28px; }
.article-sidebar { display: grid; gap: 24px; }
.sidebar-label { font-size: .75rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; color: var(--green-700); margin-bottom: 10px; }
.toc, .sidebar-sources { display: grid; gap: 9px; }
.toc a, .sidebar-sources a { color: #405048; font-size: .92rem; line-height: 1.35; }
.toc a:hover, .sidebar-sources a:hover { color: var(--green-700); }
.sidebar-sources { padding-top: 20px; border-top: 1px solid var(--border); }
.hub-back, .mobile-hub-back { color: var(--green-700); font-weight: 800; font-size: .9rem; }
.mobile-toc { display: none; padding: 20px; }
.mobile-toc .mobile-hub-back { display: inline-block; margin-bottom: 16px; }
@media (max-width: 900px) {
  .mobile-toc { display: block; }
  .article-sidebar .toc, .article-sidebar > .sidebar-label, .article-sidebar .hub-back { display: none; }
}
@media (max-width: 640px) { .article-hero-media :global(.media-frame) { aspect-ratio: 4 / 3; } }
</style>
