{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rejstilvietnam",
  "main": "./worker.js",
  "compatibility_date": "2026-09-14",
  "routes": [
    {
      "pattern": "rejstilvietnam.dk",
      "custom_domain": true
    },
    {
      "pattern": "www.rejstilvietnam.dk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
